//
// emb2.ptx - hand-written PTX kernels for EmbeddingGemma 2 (the 271M
// "gemma-embedding2" text encoder), driven by emb2.c.
//
// The host runs one encoder layer as (all T tokens of a batch at once; the
// batch may pack several texts, each attending only to itself):
//
//   xn  = rmsnorm(x) * attn_norm           rmsnorm
//   q, k, v = Wq . xn, Wk . xn, Wv . xn    gemm_q8
//   q, k = rmsnorm(head) * q|k_norm, RoPE  head_norm_rope (v: rmsnorm only)
//   att = softmax(q . K^T) . V             attention_enc (bidirectional; no
//                                            1/sqrt(d) scale; +-512 window on
//                                            5 of every 6 layers)
//   y   = Wo . att                         gemm_q8
//   x  += rmsnorm(y) * post_attn_norm;     add_rmsnorm
//   xn  = rmsnorm(x) * ffn_norm
//   g|u = [Wgate; Wup] . xn                gemm_q8
//   h   = gelu(g) * u                      geglu
//   x  += rmsnorm(Wdown . h) * post_ffw    gemm_q8, norm_add
//   e   = gelu(Winp_gate . x) * ple[l]     gemm_q8, gelu_mul (per-layer input)
//   x   = (x + rmsnorm(Wproj . e) * post_norm) * layer_scale
//                                          gemm_q8, norm_add
//
// and finally out = Wout . (rmsnorm(x) * output_norm), 768 values per token,
// mean-pooled per text by the host. The per-layer inputs ple[t][l] are
// rmsnorm(Wple . x0 / sqrt(512)) * ple_norm for the scaled token embedding
// x0 (gemm_q8, scale, rmsnorm).
//
// rmsnorm, add_rmsnorm, geglu and gemm_q8 are the Gemma 3 kernels
// (../gemma3/gemma3.ptx) unchanged. Matrices are Q8: int8 values
// q[rows][cols] plus one f16 scale per 32 values d[rows][cols/32]; w = q * d.
//

.version 8.0
.target sm_89            // Ada Lovelace (RTX 40xx)
.address_size 64

// -----------------------------------------------------------------------------
// Kernel: rmsnorm   y[i] = x[i] / sqrt(mean(x^2) + eps) * w[i]
//   One block (any multiple of 32 threads up to 1024) per row of n values;
//   gridDim.x = number of rows (tokens).
// -----------------------------------------------------------------------------
.visible .entry rmsnorm(
    .param .u64 p_x,            // f32 [n]
    .param .u64 p_w,            // f32 [n]
    .param .u64 p_y,            // f32 [n] (out)
    .param .u32 p_n,
    .param .f32 p_eps
)
{
    .reg .pred  %p<4>;
    .reg .b32   %r<16>;
    .reg .f32   %f<16>;
    .reg .b64   %rd<12>;
    .shared .align 4 .f32 rms_red[32];

    ld.param.u64        %rd1, [p_x];
    ld.param.u64        %rd2, [p_w];
    ld.param.u64        %rd3, [p_y];
    ld.param.u32        %r1,  [p_n];
    ld.param.f32        %f1,  [p_eps];
    cvta.to.global.u64  %rd1, %rd1;
    cvta.to.global.u64  %rd2, %rd2;
    cvta.to.global.u64  %rd3, %rd3;
    mov.u32             %r12, %ctaid.x;         // row
    mul.wide.u32        %rd8, %r12, %r1;
    shl.b64             %rd8, %rd8, 2;
    add.s64             %rd1, %rd1, %rd8;
    add.s64             %rd3, %rd3, %rd8;
    mov.u32             %r2, %tid.x;
    mov.u32             %r3, %ntid.x;

    mov.f32             %f2, 0f00000000;
    mov.u32             %r4, %r2;
SUMSQ:
    setp.ge.u32         %p1, %r4, %r1;
    @%p1 bra            SUMSQ_DONE;
    mul.wide.u32        %rd4, %r4, 4;
    add.s64             %rd5, %rd1, %rd4;
    ld.global.f32       %f3, [%rd5];
    fma.rn.f32          %f2, %f3, %f3, %f2;
    add.u32             %r4, %r4, %r3;
    bra.uni             SUMSQ;
SUMSQ_DONE:
    shfl.sync.bfly.b32  %f3, %f2, 16, 31, -1;
    add.f32             %f2, %f2, %f3;
    shfl.sync.bfly.b32  %f3, %f2, 8, 31, -1;
    add.f32             %f2, %f2, %f3;
    shfl.sync.bfly.b32  %f3, %f2, 4, 31, -1;
    add.f32             %f2, %f2, %f3;
    shfl.sync.bfly.b32  %f3, %f2, 2, 31, -1;
    add.f32             %f2, %f2, %f3;
    shfl.sync.bfly.b32  %f3, %f2, 1, 31, -1;
    add.f32             %f2, %f2, %f3;

    and.b32             %r5, %r2, 31;           // lane
    shr.u32             %r6, %r2, 5;            // warp
    mov.u32             %r7, rms_red;
    setp.ne.u32         %p2, %r5, 0;
    shl.b32             %r8, %r6, 2;
    add.u32             %r8, %r7, %r8;
    @!%p2 st.shared.f32 [%r8], %f2;
    bar.sync            0;

    // every thread adds up the per-warp partial sums
    shr.u32             %r9, %r3, 5;            // number of warps
    mov.f32             %f4, 0f00000000;
    mov.u32             %r10, 0;
WSUM:
    setp.ge.u32         %p3, %r10, %r9;
    @%p3 bra            WSUM_DONE;
    shl.b32             %r11, %r10, 2;
    add.u32             %r11, %r7, %r11;
    ld.shared.f32       %f5, [%r11];
    add.f32             %f4, %f4, %f5;
    add.u32             %r10, %r10, 1;
    bra.uni             WSUM;
WSUM_DONE:
    cvt.rn.f32.u32      %f6, %r1;
    div.rn.f32          %f7, %f4, %f6;          // mean(x^2)
    add.f32             %f7, %f7, %f1;
    sqrt.rn.f32         %f8, %f7;
    rcp.rn.f32          %f9, %f8;               // scale

    mov.u32             %r4, %r2;
SCALE:
    setp.ge.u32         %p1, %r4, %r1;
    @%p1 bra            DONE;
    mul.wide.u32        %rd4, %r4, 4;
    add.s64             %rd5, %rd1, %rd4;
    add.s64             %rd6, %rd2, %rd4;
    add.s64             %rd7, %rd3, %rd4;
    ld.global.f32       %f10, [%rd5];
    ld.global.f32       %f11, [%rd6];
    mul.f32             %f12, %f10, %f9;
    mul.f32             %f12, %f12, %f11;
    st.global.f32       [%rd7], %f12;
    add.u32             %r4, %r4, %r3;
    bra.uni             SCALE;
DONE:
    ret;
}

// -----------------------------------------------------------------------------
// Kernel: add_rmsnorm   per row:  x += rmsnorm(y) * w1;  xn = rmsnorm(x) * w2
//   rmsnorm(v) = v / sqrt(mean(v^2) + eps). Gemma's post-norm residual add
//   fused with the following pre-norm. One block (any multiple of 32
//   threads up to 1024) per row of n values; gridDim.x = number of rows.
//   Each thread reads back only the x values it wrote itself.
// -----------------------------------------------------------------------------
.visible .entry add_rmsnorm(
    .param .u64 p_y,            // f32 [rows][n]
    .param .u64 p_w1,           // f32 [n]
    .param .u64 p_x,            // f32 [rows][n] (updated)
    .param .u64 p_w2,           // f32 [n]
    .param .u64 p_xn,           // f32 [rows][n] (out)
    .param .u32 p_n,
    .param .f32 p_eps
)
{
    .reg .pred  %p<4>;
    .reg .b32   %r<16>;
    .reg .f32   %f<24>;
    .reg .b64   %rd<16>;
    .shared .align 4 .f32 arn_red1[32];
    .shared .align 4 .f32 arn_red2[32];

    ld.param.u64        %rd1, [p_y];
    ld.param.u64        %rd2, [p_w1];
    ld.param.u64        %rd3, [p_x];
    ld.param.u64        %rd4, [p_w2];
    ld.param.u64        %rd5, [p_xn];
    ld.param.u32        %r1,  [p_n];
    ld.param.f32        %f1,  [p_eps];
    cvta.to.global.u64  %rd1, %rd1;
    cvta.to.global.u64  %rd2, %rd2;
    cvta.to.global.u64  %rd3, %rd3;
    cvta.to.global.u64  %rd4, %rd4;
    cvta.to.global.u64  %rd5, %rd5;
    mov.u32             %r2, %ctaid.x;          // row
    mul.wide.u32        %rd6, %r2, %r1;
    shl.b64             %rd6, %rd6, 2;
    add.s64             %rd1, %rd1, %rd6;
    add.s64             %rd3, %rd3, %rd6;
    add.s64             %rd5, %rd5, %rd6;
    mov.u32             %r3, %tid.x;
    mov.u32             %r4, %ntid.x;
    and.b32             %r5, %r3, 31;           // lane
    shr.u32             %r6, %r3, 5;            // warp
    shr.u32             %r7, %r4, 5;            // number of warps
    setp.ne.u32         %p2, %r5, 0;
    shl.b32             %r8, %r6, 2;
    cvt.rn.f32.u32      %f2, %r1;               // n

    // ---- pass 1: sum of y^2 ----
    mov.f32             %f3, 0f00000000;
    mov.u32             %r9, %r3;
SUM_Y:
    setp.ge.u32         %p1, %r9, %r1;
    @%p1 bra            SUM_Y_DONE;
    mul.wide.u32        %rd7, %r9, 4;
    add.s64             %rd8, %rd1, %rd7;
    ld.global.f32       %f4, [%rd8];
    fma.rn.f32          %f3, %f4, %f4, %f3;
    add.u32             %r9, %r9, %r4;
    bra.uni             SUM_Y;
SUM_Y_DONE:
    shfl.sync.bfly.b32  %f4, %f3, 16, 31, -1;
    add.f32             %f3, %f3, %f4;
    shfl.sync.bfly.b32  %f4, %f3, 8, 31, -1;
    add.f32             %f3, %f3, %f4;
    shfl.sync.bfly.b32  %f4, %f3, 4, 31, -1;
    add.f32             %f3, %f3, %f4;
    shfl.sync.bfly.b32  %f4, %f3, 2, 31, -1;
    add.f32             %f3, %f3, %f4;
    shfl.sync.bfly.b32  %f4, %f3, 1, 31, -1;
    add.f32             %f3, %f3, %f4;
    mov.u32             %r10, arn_red1;
    add.u32             %r11, %r10, %r8;
    @!%p2 st.shared.f32 [%r11], %f3;
    bar.sync            0;
    mov.f32             %f5, 0f00000000;
    mov.u32             %r12, 0;
WSUM1:
    setp.ge.u32         %p3, %r12, %r7;
    @%p3 bra            WSUM1_DONE;
    shl.b32             %r13, %r12, 2;
    add.u32             %r13, %r10, %r13;
    ld.shared.f32       %f6, [%r13];
    add.f32             %f5, %f5, %f6;
    add.u32             %r12, %r12, 1;
    bra.uni             WSUM1;
WSUM1_DONE:
    div.rn.f32          %f5, %f5, %f2;
    add.f32             %f5, %f5, %f1;
    sqrt.rn.f32         %f5, %f5;
    rcp.rn.f32          %f7, %f5;               // scale of y

    // ---- pass 2: x += y * scale * w1, sum of x^2 ----
    mov.f32             %f8, 0f00000000;
    mov.u32             %r9, %r3;
ADD:
    setp.ge.u32         %p1, %r9, %r1;
    @%p1 bra            ADD_DONE;
    mul.wide.u32        %rd7, %r9, 4;
    add.s64             %rd8, %rd1, %rd7;
    add.s64             %rd9, %rd2, %rd7;
    add.s64             %rd10, %rd3, %rd7;
    ld.global.f32       %f9, [%rd8];
    ld.global.f32       %f10, [%rd9];
    ld.global.f32       %f11, [%rd10];
    mul.f32             %f9, %f9, %f7;
    mul.f32             %f9, %f9, %f10;
    add.f32             %f11, %f9, %f11;
    st.global.f32       [%rd10], %f11;
    fma.rn.f32          %f8, %f11, %f11, %f8;
    add.u32             %r9, %r9, %r4;
    bra.uni             ADD;
ADD_DONE:
    shfl.sync.bfly.b32  %f4, %f8, 16, 31, -1;
    add.f32             %f8, %f8, %f4;
    shfl.sync.bfly.b32  %f4, %f8, 8, 31, -1;
    add.f32             %f8, %f8, %f4;
    shfl.sync.bfly.b32  %f4, %f8, 4, 31, -1;
    add.f32             %f8, %f8, %f4;
    shfl.sync.bfly.b32  %f4, %f8, 2, 31, -1;
    add.f32             %f8, %f8, %f4;
    shfl.sync.bfly.b32  %f4, %f8, 1, 31, -1;
    add.f32             %f8, %f8, %f4;
    mov.u32             %r10, arn_red2;
    add.u32             %r11, %r10, %r8;
    @!%p2 st.shared.f32 [%r11], %f8;
    bar.sync            0;
    mov.f32             %f12, 0f00000000;
    mov.u32             %r12, 0;
WSUM2:
    setp.ge.u32         %p3, %r12, %r7;
    @%p3 bra            WSUM2_DONE;
    shl.b32             %r13, %r12, 2;
    add.u32             %r13, %r10, %r13;
    ld.shared.f32       %f6, [%r13];
    add.f32             %f12, %f12, %f6;
    add.u32             %r12, %r12, 1;
    bra.uni             WSUM2;
WSUM2_DONE:
    div.rn.f32          %f12, %f12, %f2;
    add.f32             %f12, %f12, %f1;
    sqrt.rn.f32         %f12, %f12;
    rcp.rn.f32          %f13, %f12;             // scale of x

    // ---- pass 3: xn = x * scale * w2 ----
    mov.u32             %r9, %r3;
NORM:
    setp.ge.u32         %p1, %r9, %r1;
    @%p1 bra            DONE;
    mul.wide.u32        %rd7, %r9, 4;
    add.s64             %rd10, %rd3, %rd7;
    add.s64             %rd11, %rd4, %rd7;
    add.s64             %rd12, %rd5, %rd7;
    ld.global.f32       %f14, [%rd10];
    ld.global.f32       %f15, [%rd11];
    mul.f32             %f14, %f14, %f13;
    mul.f32             %f14, %f14, %f15;
    st.global.f32       [%rd12], %f14;
    add.u32             %r9, %r9, %r4;
    bra.uni             NORM;
DONE:
    ret;
}

// -----------------------------------------------------------------------------
// Kernel: geglu   out[t][j] = gelu(g[t][j]) * u[t][j]  for j < n, where
//   gu[t] = [g: n | u: n] (the gate and up halves of one matrix product).
//   gelu(x) = 0.5 x (1 + tanh(sqrt(2/pi) x (1 + 0.044715 x^2))), ggml's tanh
//   form; tanh(y) = sign(y) (1 - 2 / (exp(2|y|) + 1)). Grid-stride.
// -----------------------------------------------------------------------------
.visible .entry geglu(
    .param .u64 p_gu,           // f32 [tokens][2n]
    .param .u64 p_out,          // f32 [tokens][n] (out)
    .param .u32 p_n,
    .param .u32 p_tokens
)
{
    .reg .pred  %p<2>;
    .reg .b32   %r<16>;
    .reg .f32   %f<16>;
    .reg .b64   %rd<8>;

    ld.param.u64        %rd1, [p_gu];
    ld.param.u64        %rd2, [p_out];
    ld.param.u32        %r1,  [p_n];
    ld.param.u32        %r2,  [p_tokens];
    cvta.to.global.u64  %rd1, %rd1;
    cvta.to.global.u64  %rd2, %rd2;
    mul.lo.u32          %r2, %r2, %r1;          // total
    mov.u32             %r3, %tid.x;
    mov.u32             %r4, %ntid.x;
    mov.u32             %r5, %ctaid.x;
    mov.u32             %r6, %nctaid.x;
    mad.lo.u32          %r7, %r5, %r4, %r3;
    mul.lo.u32          %r8, %r6, %r4;
LOOP:
    setp.ge.u32         %p1, %r7, %r2;
    @%p1 bra            DONE;
    div.u32             %r9, %r7, %r1;          // t
    mad.lo.u32          %r10, %r9, %r1, %r7;    // t*2n + j = t*n + i
    mul.wide.u32        %rd3, %r10, 4;
    add.s64             %rd3, %rd1, %rd3;
    ld.global.f32       %f1, [%rd3];            // g
    mul.wide.u32        %rd4, %r1, 4;
    add.s64             %rd4, %rd3, %rd4;
    ld.global.f32       %f2, [%rd4];            // u
    mul.f32             %f3, %f1, %f1;
    fma.rn.f32          %f3, %f3, 0f3D372713, 0f3F800000;   // 1 + 0.044715 x^2
    mul.f32             %f4, %f1, 0f3F4C422A;               // sqrt(2/pi) x
    mul.f32             %f4, %f4, %f3;          // y
    abs.f32             %f5, %f4;
    mul.f32             %f5, %f5, 0f4038AA3B;   // 2|y| log2(e)
    ex2.approx.f32      %f5, %f5;
    add.f32             %f5, %f5, 0f3F800000;
    div.rn.f32          %f6, 0f40000000, %f5;
    sub.f32             %f6, 0f3F800000, %f6;   // tanh(|y|)
    copysign.f32        %f6, %f4, %f6;
    add.f32             %f6, %f6, 0f3F800000;
    mul.f32             %f7, %f1, 0f3F000000;
    mul.f32             %f7, %f7, %f6;          // gelu(g)
    mul.f32             %f7, %f7, %f2;
    mul.wide.u32        %rd5, %r7, 4;
    add.s64             %rd5, %rd2, %rd5;
    st.global.f32       [%rd5], %f7;
    add.u32             %r7, %r7, %r8;
    bra.uni             LOOP;
DONE:
    ret;
}

// =============================================================================
// Batched (prompt) kernels
//
// A prompt is processed in chunks of up to 128 tokens. The matrices run as
// tiled GEMMs, so each weight is read from memory once per chunk instead of
// once per token. Each block computes a 64-row x 32-token tile of
// Y = X . W^T: per 64-wide step along the inner dimension it dequantizes the
// weight tile into shared memory (Ws[k][row], f32) next to the activation
// tile (Xs[token][k], rows padded to 68 floats), then every thread accumulates
// 4 rows x 2 tokens (threads whose tokens are all past the end of the tile
// skip that work).
// =============================================================================

// -----------------------------------------------------------------------------
// st4_s8 / st4_q5: dequantize four weights packed in a b32 times `scale` and
// store them to shared memory at addr, addr+256, addr+512, addr+768 (four
// consecutive k of one row in the Ws[k][64] tile). st4_s8 takes four int8;
// st4_q5 takes the four nibbles at bit `shift` of each byte of w plus their
// 5th bits in the low 4 bits of hb, and subtracts 16.
// -----------------------------------------------------------------------------
.func st4_s8(.reg .b32 w, .reg .f32 scale, .reg .b32 addr)
{
    .reg .b32 %t<4>;
    .reg .f32 %v<4>;

    bfe.s32             %t0, w, 0, 8;
    bfe.s32             %t1, w, 8, 8;
    bfe.s32             %t2, w, 16, 8;
    bfe.s32             %t3, w, 24, 8;
    cvt.rn.f32.s32      %v0, %t0;
    cvt.rn.f32.s32      %v1, %t1;
    cvt.rn.f32.s32      %v2, %t2;
    cvt.rn.f32.s32      %v3, %t3;
    mul.f32             %v0, %v0, scale;
    mul.f32             %v1, %v1, scale;
    mul.f32             %v2, %v2, scale;
    mul.f32             %v3, %v3, scale;
    st.shared.f32       [addr], %v0;
    st.shared.f32       [addr+256], %v1;
    st.shared.f32       [addr+512], %v2;
    st.shared.f32       [addr+768], %v3;
    ret;
}

// -----------------------------------------------------------------------------
// Kernel: gemm_q8   Y[t][r] = sum_c W[r][c] * X[t][c] + bias[r] + resid[t][r]
//   W in Q8 as for mv_q8; X f32 [T][cols]; Y and resid have row stride ldy
//   (so Y can be a column slice of a wider matrix); bias / resid may be 0 and
//   Y may equal resid. rows % 64 == 0, cols % 64 == 0.
//   Launch: blockDim = 256, gridDim = (rows / 64, ceil(T / 32)).
// -----------------------------------------------------------------------------
.visible .entry gemm_q8(
    .param .u64 p_W,            // s8  [rows][cols]
    .param .u64 p_D,            // f16 [rows][cols/32]
    .param .u64 p_X,            // f32 [T][cols]
    .param .u64 p_bias,         // f32 [rows] or 0
    .param .u64 p_resid,        // f32 [T][ldy] or 0
    .param .u64 p_Y,            // f32 [T][ldy] (out)
    .param .u32 p_rows,
    .param .u32 p_cols,
    .param .u32 p_T,
    .param .u32 p_ldy
)
{
    .reg .pred  %p<8>;
    .reg .b16   %h<2>;
    .reg .b32   %r<48>;
    .reg .f32   %f<40>;
    .reg .b64   %rd<24>;
    .reg .b32   %kw, %kx, %ke;
    .reg .pred  %pk;
    .reg .f32   %w<16>;
    .reg .f32   %x<8>;
    .shared .align 16 .f32 gq_w[4096];          // [64 k][64 rows]
    .shared .align 16 .f32 gq_x[2176];          // [32 tokens][68]

    ld.param.u64        %rd1, [p_W];
    ld.param.u64        %rd2, [p_D];
    ld.param.u64        %rd3, [p_X];
    ld.param.u64        %rd4, [p_bias];
    ld.param.u64        %rd5, [p_resid];
    ld.param.u64        %rd6, [p_Y];
    ld.param.u32        %r1,  [p_rows];
    ld.param.u32        %r2,  [p_cols];
    ld.param.u32        %r3,  [p_T];
    ld.param.u32        %r4,  [p_ldy];
    setp.ne.u64         %p5, %rd4, 0;           // has bias
    setp.ne.u64         %p6, %rd5, 0;           // has resid
    cvta.to.global.u64  %rd1, %rd1;
    cvta.to.global.u64  %rd2, %rd2;
    cvta.to.global.u64  %rd3, %rd3;
    cvta.to.global.u64  %rd4, %rd4;
    cvta.to.global.u64  %rd5, %rd5;
    cvta.to.global.u64  %rd6, %rd6;

    mov.u32             %r5, %tid.x;
    mov.u32             %r6, %ctaid.x;
    shl.b32             %r6, %r6, 6;            // r0
    mov.u32             %r7, %ctaid.y;
    shl.b32             %r7, %r7, 5;            // t0
    and.b32             %r8, %r5, 15;           // tr
    shr.u32             %r9, %r5, 4;            // tt
    and.b32             %r10, %r5, 63;          // lr (weight row loaded)
    shr.u32             %r11, %r5, 6;           // q  (16-byte quarter of 64 k)
    shr.u32             %r12, %r5, 3;           // tl (token loaded)
    and.b32             %r13, %r5, 7;
    shl.b32             %r13, %r13, 3;          // kk
    shr.u32             %r14, %r2, 5;           // nb

    // weight row pointers
    add.u32             %r15, %r6, %r10;        // r0 + lr
    mul.wide.u32        %rd7, %r15, %r2;
    add.s64             %rd7, %rd1, %rd7;
    mul.wide.u32        %rd8, %r11, 16;
    add.s64             %rd7, %rd7, %rd8;       // &W[r0+lr][q*16]
    mul.wide.u32        %rd9, %r15, %r14;
    shl.b64             %rd9, %rd9, 1;
    add.s64             %rd9, %rd2, %rd9;       // &D[r0+lr][0]
    shr.u32             %r16, %r11, 1;          // q / 2 = scale block within the step

    // activation row pointer
    add.u32             %r17, %r7, %r12;        // token
    setp.lt.u32         %p1, %r17, %r3;         // valid token
    mad.lo.u32          %r18, %r17, %r2, %r13;
    mul.wide.u32        %rd10, %r18, 4;
    add.s64             %rd10, %rd3, %rd10;     // &X[token][kk]

    // shared addresses
    mov.u32             %r19, gq_w;
    mov.u32             %r20, gq_x;
    shl.b32             %r21, %r11, 12;         // q*16 k * 256 bytes
    shl.b32             %r22, %r10, 2;
    add.u32             %r21, %r21, %r22;
    add.u32             %r21, %r19, %r21;       // store base &Ws[q*16][lr]
    mad.lo.u32          %r23, %r12, 68, %r13;
    shl.b32             %r23, %r23, 2;
    add.u32             %r23, %r20, %r23;       // store base &Xs[tl][kk]
    shl.b32             %r24, %r8, 4;
    add.u32             %r24, %r19, %r24;       // read base &Ws[0][4*tr]
    mul.lo.u32          %r25, %r9, 544;         // 2*tt * 68 * 4
    add.u32             %r25, %r20, %r25;       // read base &Xs[2*tt][0]
    shl.b32             %r36, %r9, 1;
    add.u32             %r36, %r7, %r36;
    setp.lt.u32         %p7, %r36, %r3;         // thread has a real token

    mov.f32             %f1, 0f00000000;
    mov.f32             %f2, 0f00000000;
    mov.f32             %f3, 0f00000000;
    mov.f32             %f4, 0f00000000;
    mov.f32             %f5, 0f00000000;
    mov.f32             %f6, 0f00000000;
    mov.f32             %f7, 0f00000000;
    mov.f32             %f8, 0f00000000;
    mov.f32             %f10, 0f00000000;
    mov.f32             %f11, 0f00000000;
    mov.f32             %f12, 0f00000000;
    mov.f32             %f13, 0f00000000;
    mov.f32             %f14, 0f00000000;
    mov.f32             %f15, 0f00000000;
    mov.f32             %f16, 0f00000000;
    mov.f32             %f17, 0f00000000;

    mov.u32             %r26, 0;                // k0
KSTEP:
    setp.ge.u32         %p2, %r26, %r2;
    @%p2 bra            EPILOGUE;
    // weights: 16 int8 of row lr, k = k0 + q*16 .. +15
    cvt.u64.u32         %rd11, %r26;
    add.s64             %rd12, %rd7, %rd11;
    ld.global.nc.v4.u32 {%r27, %r28, %r29, %r30}, [%rd12];
    shr.u32             %r31, %r26, 5;
    add.u32             %r31, %r31, %r16;
    mul.wide.u32        %rd13, %r31, 2;
    add.s64             %rd13, %rd9, %rd13;
    ld.global.nc.b16    %h1, [%rd13];
    cvt.f32.f16         %f9, %h1;
    call.uni st4_s8, (%r27, %f9, %r21);
    add.u32             %r32, %r21, 1024;
    call.uni st4_s8, (%r28, %f9, %r32);
    add.u32             %r32, %r21, 2048;
    call.uni st4_s8, (%r29, %f9, %r32);
    add.u32             %r32, %r21, 3072;
    call.uni st4_s8, (%r30, %f9, %r32);
    // activations: 8 floats of token tl (zeros past T)
    @!%p1 bra           XSTORE;
    mul.wide.u32        %rd14, %r26, 4;
    add.s64             %rd14, %rd10, %rd14;
    ld.global.v4.f32    {%f10, %f11, %f12, %f13}, [%rd14];
    ld.global.v4.f32    {%f14, %f15, %f16, %f17}, [%rd14+16];
XSTORE:
    st.shared.v4.f32    [%r23], {%f10, %f11, %f12, %f13};
    st.shared.v4.f32    [%r23+16], {%f14, %f15, %f16, %f17};
    bar.sync            0;
    @!%p7 bra           SKIP_FMA;               // both of this thread's tokens are past T
    // tile inner product: acc[i][j] (f1..f8 = acc[0][0], acc[0][1], ... acc[3][1])
    // += Ws[k][4*tr+i] * Xs[2*tt+j][k] over the 64 k of this step, 4 k per pass
    mov.u32             %kw, %r24;              // &Ws[0][4*tr]
    mov.u32             %kx, %r25;              // &Xs[2*tt][0] (token 2*tt+1 is 272 bytes on)
    add.u32             %ke, %r25, 256;
Q8_K4:
    // four k at a time: Ws rows k..k+3 (4 floats each), Xs 4 floats per token
    ld.shared.v4.f32    {%w0, %w1, %w2, %w3}, [%kw];
    ld.shared.v4.f32    {%w4, %w5, %w6, %w7}, [%kw+256];
    ld.shared.v4.f32    {%w8, %w9, %w10, %w11}, [%kw+512];
    ld.shared.v4.f32    {%w12, %w13, %w14, %w15}, [%kw+768];
    ld.shared.v4.f32    {%x0, %x1, %x2, %x3}, [%kx];
    ld.shared.v4.f32    {%x4, %x5, %x6, %x7}, [%kx+272];
    fma.rn.f32          %f1, %w0, %x0, %f1;
    fma.rn.f32          %f2, %w0, %x4, %f2;
    fma.rn.f32          %f3, %w1, %x0, %f3;
    fma.rn.f32          %f4, %w1, %x4, %f4;
    fma.rn.f32          %f5, %w2, %x0, %f5;
    fma.rn.f32          %f6, %w2, %x4, %f6;
    fma.rn.f32          %f7, %w3, %x0, %f7;
    fma.rn.f32          %f8, %w3, %x4, %f8;
    fma.rn.f32          %f1, %w4, %x1, %f1;
    fma.rn.f32          %f2, %w4, %x5, %f2;
    fma.rn.f32          %f3, %w5, %x1, %f3;
    fma.rn.f32          %f4, %w5, %x5, %f4;
    fma.rn.f32          %f5, %w6, %x1, %f5;
    fma.rn.f32          %f6, %w6, %x5, %f6;
    fma.rn.f32          %f7, %w7, %x1, %f7;
    fma.rn.f32          %f8, %w7, %x5, %f8;
    fma.rn.f32          %f1, %w8, %x2, %f1;
    fma.rn.f32          %f2, %w8, %x6, %f2;
    fma.rn.f32          %f3, %w9, %x2, %f3;
    fma.rn.f32          %f4, %w9, %x6, %f4;
    fma.rn.f32          %f5, %w10, %x2, %f5;
    fma.rn.f32          %f6, %w10, %x6, %f6;
    fma.rn.f32          %f7, %w11, %x2, %f7;
    fma.rn.f32          %f8, %w11, %x6, %f8;
    fma.rn.f32          %f1, %w12, %x3, %f1;
    fma.rn.f32          %f2, %w12, %x7, %f2;
    fma.rn.f32          %f3, %w13, %x3, %f3;
    fma.rn.f32          %f4, %w13, %x7, %f4;
    fma.rn.f32          %f5, %w14, %x3, %f5;
    fma.rn.f32          %f6, %w14, %x7, %f6;
    fma.rn.f32          %f7, %w15, %x3, %f7;
    fma.rn.f32          %f8, %w15, %x7, %f8;
    add.u32             %kw, %kw, 1024;
    add.u32             %kx, %kx, 16;
    setp.lt.u32         %pk, %kx, %ke;
    @%pk bra            Q8_K4;
SKIP_FMA:
    bar.sync            0;
    add.u32             %r26, %r26, 64;
    bra.uni             KSTEP;

EPILOGUE:
    // rows r0 + 4*tr .. +3, tokens t0 + 2*tt + j
    shl.b32             %r33, %r8, 2;
    add.u32             %r33, %r6, %r33;        // first row
    mov.f32             %f20, 0f00000000;
    mov.f32             %f21, 0f00000000;
    mov.f32             %f22, 0f00000000;
    mov.f32             %f23, 0f00000000;
    @!%p5 bra           NO_BIAS;
    mul.wide.u32        %rd15, %r33, 4;
    add.s64             %rd15, %rd4, %rd15;
    ld.global.v4.f32    {%f20, %f21, %f22, %f23}, [%rd15];
NO_BIAS:
    shl.b32             %r34, %r9, 1;
    add.u32             %r34, %r7, %r34;        // token of j = 0
    // j = 0: acc in f1, f3, f5, f7
    setp.ge.u32         %p3, %r34, %r3;
    @%p3 bra            DONE;
    add.f32             %f24, %f1, %f20;
    add.f32             %f25, %f3, %f21;
    add.f32             %f26, %f5, %f22;
    add.f32             %f27, %f7, %f23;
    mad.lo.u32          %r35, %r34, %r4, %r33;
    mul.wide.u32        %rd16, %r35, 4;
    @!%p6 bra           STORE0;
    add.s64             %rd17, %rd5, %rd16;
    ld.global.v4.f32    {%f28, %f29, %f30, %f31}, [%rd17];
    add.f32             %f24, %f24, %f28;
    add.f32             %f25, %f25, %f29;
    add.f32             %f26, %f26, %f30;
    add.f32             %f27, %f27, %f31;
STORE0:
    add.s64             %rd18, %rd6, %rd16;
    st.global.v4.f32    [%rd18], {%f24, %f25, %f26, %f27};
    // j = 1: acc in f2, f4, f6, f8
    add.u32             %r34, %r34, 1;
    setp.ge.u32         %p3, %r34, %r3;
    @%p3 bra            DONE;
    add.f32             %f24, %f2, %f20;
    add.f32             %f25, %f4, %f21;
    add.f32             %f26, %f6, %f22;
    add.f32             %f27, %f8, %f23;
    mad.lo.u32          %r35, %r34, %r4, %r33;
    mul.wide.u32        %rd16, %r35, 4;
    @!%p6 bra           STORE1;
    add.s64             %rd17, %rd5, %rd16;
    ld.global.v4.f32    {%f28, %f29, %f30, %f31}, [%rd17];
    add.f32             %f24, %f24, %f28;
    add.f32             %f25, %f25, %f29;
    add.f32             %f26, %f26, %f30;
    add.f32             %f27, %f27, %f31;
STORE1:
    add.s64             %rd18, %rd6, %rd16;
    st.global.v4.f32    [%rd18], {%f24, %f25, %f26, %f27};
DONE:
    ret;
}

// =============================================================================
// EmbeddingGemma 2 kernels
// =============================================================================

// -----------------------------------------------------------------------------
// Kernel: head_norm_rope   for token t = blockIdx.y and head h = blockIdx.x of
//   qkv[t] = [q: nh x D | k: nkv x D | v: nkv x D] (row stride `stride`):
//   q heads: x = rmsnorm(x) * qw, then NeoX RoPE at position pos[t]
//   k heads: x = rmsnorm(x) * kw, then RoPE
//   v heads: x = rmsnorm(x) (no weight, no RoPE)
//   RoPE rotates the pairs (i, i + D/2), i < D/2:
//     x_i' = x_i c - x_{i+D/2} s,  x_{i+D/2}' = x_i s + x_{i+D/2} c
//   with {c, s} = cs[pos][i]. In place.
//   Launch: gridDim = (nh + 2*nkv, tokens), blockDim = 128; D % 256 == 0.
// -----------------------------------------------------------------------------
.visible .entry head_norm_rope(
    .param .u64 p_qkv,          // f32 [tokens][stride]
    .param .u32 p_stride,
    .param .u64 p_qw,           // f32 [D]
    .param .u64 p_kw,           // f32 [D]
    .param .u64 p_cs,           // f32 [positions][D/2][2]
    .param .u64 p_pos,          // u32 [tokens]
    .param .u32 p_nh,
    .param .u32 p_nkv,
    .param .u32 p_d,
    .param .f32 p_eps
)
{
    .reg .pred  %p<8>;
    .reg .b32   %r<24>;
    .reg .f32   %f<24>;
    .reg .b64   %rd<20>;
    .shared .align 4 .f32 hnr_red[4];

    ld.param.u64        %rd1, [p_qkv];
    ld.param.u32        %r1,  [p_stride];
    ld.param.u64        %rd2, [p_qw];
    ld.param.u64        %rd3, [p_kw];
    ld.param.u64        %rd4, [p_cs];
    ld.param.u64        %rd5, [p_pos];
    ld.param.u32        %r2,  [p_nh];
    ld.param.u32        %r3,  [p_nkv];
    ld.param.u32        %r4,  [p_d];
    ld.param.f32        %f1,  [p_eps];
    cvta.to.global.u64  %rd1, %rd1;
    cvta.to.global.u64  %rd2, %rd2;
    cvta.to.global.u64  %rd3, %rd3;
    cvta.to.global.u64  %rd4, %rd4;
    cvta.to.global.u64  %rd5, %rd5;

    mov.u32             %r5, %ctaid.x;          // head
    mov.u32             %r6, %ctaid.y;          // token
    mov.u32             %r7, %tid.x;
    shr.u32             %r8, %r4, 1;            // half = D/2
    // row = qkv + (t * stride + h * D) * 4
    mul.wide.u32        %rd6, %r6, %r1;
    mul.wide.u32        %rd7, %r5, %r4;
    add.s64             %rd6, %rd6, %rd7;
    shl.b64             %rd6, %rd6, 2;
    add.s64             %rd6, %rd1, %rd6;
    mul.wide.u32        %rd7, %r8, 4;           // half * 4 bytes
    // kind: 0 = q, 1 = k, 2 = v
    add.u32             %r9, %r2, %r3;
    setp.lt.u32         %p1, %r5, %r2;          // q head
    setp.lt.u32         %p2, %r5, %r9;          // q or k head
    selp.b64            %rd8, %rd2, %rd3, %p1;  // weight

    // pass 1: sum of squares
    mov.f32             %f2, 0f00000000;
    mov.u32             %r10, %r7;
SUMSQ:
    setp.ge.u32         %p3, %r10, %r8;
    @%p3 bra            SUMSQ_DONE;
    mul.wide.u32        %rd9, %r10, 4;
    add.s64             %rd10, %rd6, %rd9;
    ld.global.f32       %f3, [%rd10];
    add.s64             %rd11, %rd10, %rd7;
    ld.global.f32       %f4, [%rd11];
    fma.rn.f32          %f2, %f3, %f3, %f2;
    fma.rn.f32          %f2, %f4, %f4, %f2;
    add.u32             %r10, %r10, 128;
    bra.uni             SUMSQ;
SUMSQ_DONE:
    shfl.sync.bfly.b32  %f3, %f2, 16, 31, -1;
    add.f32             %f2, %f2, %f3;
    shfl.sync.bfly.b32  %f3, %f2, 8, 31, -1;
    add.f32             %f2, %f2, %f3;
    shfl.sync.bfly.b32  %f3, %f2, 4, 31, -1;
    add.f32             %f2, %f2, %f3;
    shfl.sync.bfly.b32  %f3, %f2, 2, 31, -1;
    add.f32             %f2, %f2, %f3;
    shfl.sync.bfly.b32  %f3, %f2, 1, 31, -1;
    add.f32             %f2, %f2, %f3;
    and.b32             %r11, %r7, 31;          // lane
    shr.u32             %r12, %r7, 5;           // warp
    mov.u32             %r13, hnr_red;
    shl.b32             %r14, %r12, 2;
    add.u32             %r14, %r13, %r14;
    setp.eq.u32         %p4, %r11, 0;
    @%p4 st.shared.f32  [%r14], %f2;
    bar.sync            0;
    ld.shared.f32       %f5, [%r13];
    ld.shared.f32       %f6, [%r13+4];
    ld.shared.f32       %f7, [%r13+8];
    ld.shared.f32       %f8, [%r13+12];
    add.f32             %f5, %f5, %f6;
    add.f32             %f7, %f7, %f8;
    add.f32             %f5, %f5, %f7;
    cvt.rn.f32.u32      %f6, %r4;
    div.rn.f32          %f5, %f5, %f6;          // mean(x^2)
    add.f32             %f5, %f5, %f1;
    sqrt.rn.f32         %f5, %f5;
    rcp.rn.f32          %f9, %f5;               // scale

    // cs row of this token's position
    mul.wide.u32        %rd12, %r6, 4;
    add.s64             %rd12, %rd5, %rd12;
    ld.global.u32       %r15, [%rd12];          // pos
    mul.wide.u32        %rd13, %r15, %r4;       // pos * half * 2
    shl.b64             %rd13, %rd13, 2;
    add.s64             %rd13, %rd4, %rd13;

    // pass 2: normalize (and weight + rotate q / k)
    mov.u32             %r10, %r7;
APPLY:
    setp.ge.u32         %p3, %r10, %r8;
    @%p3 bra            DONE;
    mul.wide.u32        %rd9, %r10, 4;
    add.s64             %rd10, %rd6, %rd9;
    add.s64             %rd11, %rd10, %rd7;
    ld.global.f32       %f3, [%rd10];
    ld.global.f32       %f4, [%rd11];
    mul.f32             %f3, %f3, %f9;
    mul.f32             %f4, %f4, %f9;
    @!%p2 bra           STORE;                  // v head: rmsnorm only
    add.s64             %rd14, %rd8, %rd9;
    ld.global.f32       %f10, [%rd14];
    add.s64             %rd14, %rd14, %rd7;
    ld.global.f32       %f11, [%rd14];
    mul.f32             %f3, %f3, %f10;
    mul.f32             %f4, %f4, %f11;
    mul.wide.u32        %rd15, %r10, 8;
    add.s64             %rd15, %rd13, %rd15;
    ld.global.v2.f32    {%f12, %f13}, [%rd15];  // cos, sin
    mul.f32             %f14, %f3, %f12;
    mul.f32             %f15, %f4, %f13;
    sub.f32             %f14, %f14, %f15;       // x_i c - x_j s
    mul.f32             %f16, %f3, %f13;
    fma.rn.f32          %f4, %f4, %f12, %f16;   // x_i s + x_j c
    mov.f32             %f3, %f14;
STORE:
    st.global.f32       [%rd10], %f3;
    st.global.f32       [%rd11], %f4;
    add.u32             %r10, %r10, 128;
    bra.uni             APPLY;
DONE:
    ret;
}

// -----------------------------------------------------------------------------
// Kernel: attention_enc   bidirectional attention for query token t =
//   blockIdx.y and q head h = blockIdx.x:
//     out[t][h] = sum_j softmax_j(scale * q_h(t) . k(j)) v(j)
//   over the keys j of t's own text [seg[t][0], seg[t][1]) and, with
//   half_window != 0, |j - t| <= half_window (llama.cpp's symmetric sliding
//   window of 2 * half_window). q, k, v come from the same qkv rows as in
//   head_norm_rope; grouped-query: q head h reads kv head h / (nh / nkv).
//   Launch: gridDim = (nh, tokens), blockDim = 256 (8 warps), dynamic shared
//   memory = 4 * (keys in range) bytes. D <= 512, D % 32 == 0.
//   Warp w scores keys lo+w, lo+w+8, ... (lanes split the D dims, then a
//   butterfly sum); the block then takes exp(s - max) and its sum; finally
//   thread i accumulates dims i and i+256 over all keys (coalesced v rows).
// -----------------------------------------------------------------------------
.extern .shared .align 16 .b8 att_scores[];

.visible .entry attention_enc(
    .param .u64 p_qkv,          // f32 [tokens][stride]
    .param .u32 p_stride,
    .param .u64 p_seg,          // u32 [tokens][2]
    .param .u64 p_out,          // f32 [tokens][nh * D] (out)
    .param .u32 p_nh,
    .param .u32 p_nkv,
    .param .u32 p_d,
    .param .u32 p_half_window,  // 0 = the whole text
    .param .f32 p_scale
)
{
    .reg .pred  %p<8>;
    .reg .b32   %r<40>;
    .reg .f32   %f<24>;
    .reg .b64   %rd<24>;
    .shared .align 16 .f32 att_q[512];
    .shared .align 4 .f32 att_max[8];
    .shared .align 4 .f32 att_sum[8];

    ld.param.u64        %rd1, [p_qkv];
    ld.param.u32        %r1,  [p_stride];
    ld.param.u64        %rd2, [p_seg];
    ld.param.u64        %rd3, [p_out];
    ld.param.u32        %r2,  [p_nh];
    ld.param.u32        %r3,  [p_nkv];
    ld.param.u32        %r4,  [p_d];
    ld.param.u32        %r5,  [p_half_window];
    ld.param.f32        %f1,  [p_scale];
    cvta.to.global.u64  %rd1, %rd1;
    cvta.to.global.u64  %rd2, %rd2;
    cvta.to.global.u64  %rd3, %rd3;

    mov.u32             %r6, %ctaid.x;          // q head
    mov.u32             %r7, %ctaid.y;          // query token t
    mov.u32             %r8, %tid.x;
    and.b32             %r9, %r8, 31;           // lane
    shr.u32             %r10, %r8, 5;           // warp

    // key range [lo, hi)
    mul.wide.u32        %rd4, %r7, 8;
    add.s64             %rd4, %rd2, %rd4;
    ld.global.v2.u32    {%r11, %r12}, [%rd4];   // seg start, end
    setp.eq.u32         %p1, %r5, 0;
    @%p1 bra            RANGE_DONE;
    add.u32             %r13, %r11, %r5;        // start + hw
    sub.u32             %r14, %r7, %r5;         // t - hw (when t >= start + hw)
    setp.ge.u32         %p2, %r7, %r13;
    selp.b32            %r11, %r14, %r11, %p2;
    add.u32             %r14, %r7, %r5;
    add.u32             %r14, %r14, 1;          // t + hw + 1
    min.u32             %r12, %r12, %r14;
RANGE_DONE:
    sub.u32             %r15, %r12, %r11;       // n keys

    // kv head and base pointers
    div.u32             %r16, %r2, %r3;         // q heads per kv head
    div.u32             %r16, %r6, %r16;        // kv head
    mul.lo.u32          %r17, %r2, %r4;         // nh * D: offset of k
    mad.lo.u32          %r18, %r16, %r4, %r17;  // k offset of this kv head
    mad.lo.u32          %r19, %r3, %r4, %r18;   // v offset = k offset + nkv * D
    mul.wide.u32        %rd5, %r1, 4;           // row bytes

    // q row -> shared
    mul.wide.u32        %rd6, %r7, %r1;
    mul.wide.u32        %rd7, %r6, %r4;
    add.s64             %rd6, %rd6, %rd7;
    shl.b64             %rd6, %rd6, 2;
    add.s64             %rd6, %rd1, %rd6;       // &q[t][h][0]
    mov.u32             %r20, att_q;
    mov.u32             %r21, %r8;
QLOAD:
    setp.ge.u32         %p1, %r21, %r4;
    @%p1 bra            QLOAD_DONE;
    mul.wide.u32        %rd8, %r21, 4;
    add.s64             %rd8, %rd6, %rd8;
    ld.global.f32       %f2, [%rd8];
    shl.b32             %r22, %r21, 2;
    add.u32             %r22, %r20, %r22;
    st.shared.f32       [%r22], %f2;
    add.u32             %r21, %r21, 256;
    bra.uni             QLOAD;
QLOAD_DONE:
    bar.sync            0;

    // scores: warp w takes keys lo + w, lo + w + 8, ...
    mov.u32             %r23, att_scores;
    mov.f32             %f3, 0fFF800000;        // running max (-inf)
    add.u32             %r24, %r11, %r10;       // key j
KEYS:
    setp.ge.u32         %p1, %r24, %r12;
    @%p1 bra            KEYS_DONE;
    mul.wide.u32        %rd9, %r24, %r1;
    cvt.u64.u32         %rd10, %r18;
    add.s64             %rd9, %rd9, %rd10;
    shl.b64             %rd9, %rd9, 2;
    add.s64             %rd9, %rd1, %rd9;       // &k[j][0]
    mov.f32             %f4, 0f00000000;
    mov.u32             %r25, %r9;
DOT:
    setp.ge.u32         %p2, %r25, %r4;
    @%p2 bra            DOT_DONE;
    mul.wide.u32        %rd11, %r25, 4;
    add.s64             %rd11, %rd9, %rd11;
    ld.global.f32       %f5, [%rd11];
    shl.b32             %r26, %r25, 2;
    add.u32             %r26, %r20, %r26;
    ld.shared.f32       %f6, [%r26];
    fma.rn.f32          %f4, %f5, %f6, %f4;
    add.u32             %r25, %r25, 32;
    bra.uni             DOT;
DOT_DONE:
    shfl.sync.bfly.b32  %f5, %f4, 16, 31, -1;
    add.f32             %f4, %f4, %f5;
    shfl.sync.bfly.b32  %f5, %f4, 8, 31, -1;
    add.f32             %f4, %f4, %f5;
    shfl.sync.bfly.b32  %f5, %f4, 4, 31, -1;
    add.f32             %f4, %f4, %f5;
    shfl.sync.bfly.b32  %f5, %f4, 2, 31, -1;
    add.f32             %f4, %f4, %f5;
    shfl.sync.bfly.b32  %f5, %f4, 1, 31, -1;
    add.f32             %f4, %f4, %f5;
    mul.f32             %f4, %f4, %f1;          // scaled score
    max.f32             %f3, %f3, %f4;
    setp.eq.u32         %p3, %r9, 0;
    sub.u32             %r27, %r24, %r11;
    shl.b32             %r27, %r27, 2;
    add.u32             %r27, %r23, %r27;
    @%p3 st.shared.f32  [%r27], %f4;
    add.u32             %r24, %r24, 8;
    bra.uni             KEYS;
KEYS_DONE:
    // block max
    mov.u32             %r28, att_max;
    shl.b32             %r29, %r10, 2;
    add.u32             %r30, %r28, %r29;
    setp.eq.u32         %p3, %r9, 0;
    @%p3 st.shared.f32  [%r30], %f3;
    bar.sync            0;
    ld.shared.f32       %f3, [%r28];
    mov.u32             %r31, 1;
BMAX:
    setp.ge.u32         %p1, %r31, 8;
    @%p1 bra            BMAX_DONE;
    shl.b32             %r32, %r31, 2;
    add.u32             %r32, %r28, %r32;
    ld.shared.f32       %f7, [%r32];
    max.f32             %f3, %f3, %f7;
    add.u32             %r31, %r31, 1;
    bra.uni             BMAX;
BMAX_DONE:
    // p = exp(s - max) = 2^(s log2e - max log2e), and their sum
    mul.f32             %f8, %f3, 0fBFB8AA3B;   // -max * log2(e)
    mov.f32             %f9, 0f00000000;
    mov.u32             %r21, %r8;
EXP:
    setp.ge.u32         %p1, %r21, %r15;
    @%p1 bra            EXP_DONE;
    shl.b32             %r22, %r21, 2;
    add.u32             %r22, %r23, %r22;
    ld.shared.f32       %f10, [%r22];
    fma.rn.f32          %f10, %f10, 0f3FB8AA3B, %f8;
    ex2.approx.f32      %f10, %f10;
    st.shared.f32       [%r22], %f10;
    add.f32             %f9, %f9, %f10;
    add.u32             %r21, %r21, 256;
    bra.uni             EXP;
EXP_DONE:
    shfl.sync.bfly.b32  %f10, %f9, 16, 31, -1;
    add.f32             %f9, %f9, %f10;
    shfl.sync.bfly.b32  %f10, %f9, 8, 31, -1;
    add.f32             %f9, %f9, %f10;
    shfl.sync.bfly.b32  %f10, %f9, 4, 31, -1;
    add.f32             %f9, %f9, %f10;
    shfl.sync.bfly.b32  %f10, %f9, 2, 31, -1;
    add.f32             %f9, %f9, %f10;
    shfl.sync.bfly.b32  %f10, %f9, 1, 31, -1;
    add.f32             %f9, %f9, %f10;
    mov.u32             %r28, att_sum;
    add.u32             %r30, %r28, %r29;
    @%p3 st.shared.f32  [%r30], %f9;
    bar.sync            0;                      // also publishes every p
    mov.f32             %f9, 0f00000000;
    mov.u32             %r31, 0;
BSUM:
    setp.ge.u32         %p1, %r31, 8;
    @%p1 bra            BSUM_DONE;
    shl.b32             %r32, %r31, 2;
    add.u32             %r32, %r28, %r32;
    ld.shared.f32       %f7, [%r32];
    add.f32             %f9, %f9, %f7;
    add.u32             %r31, %r31, 1;
    bra.uni             BSUM;
BSUM_DONE:
    rcp.rn.f32          %f11, %f9;

    // out[t][h][d] = sum_j p_j v[lo + j][d] / sum, for d = tid, tid + 256
    cvt.u64.u32         %rd12, %r19;
    mul.wide.u32        %rd13, %r11, %r1;
    add.s64             %rd13, %rd13, %rd12;
    shl.b64             %rd13, %rd13, 2;
    add.s64             %rd13, %rd1, %rd13;     // &v[lo][0]
    mul.wide.u32        %rd14, %r7, %r2;        // out row: (t * nh) * D + h * D
    mul.lo.u32          %r33, %r6, %r4;
    cvt.u64.u32         %rd15, %r4;
    mul.lo.u64          %rd14, %rd14, %rd15;
    cvt.u64.u32         %rd16, %r33;
    add.s64             %rd14, %rd14, %rd16;
    shl.b64             %rd14, %rd14, 2;
    add.s64             %rd14, %rd3, %rd14;
    mov.u32             %r21, %r8;
DIMS:
    setp.ge.u32         %p1, %r21, %r4;
    @%p1 bra            DONE;
    mul.wide.u32        %rd17, %r21, 4;
    add.s64             %rd18, %rd13, %rd17;    // &v[lo][d]
    mov.f32             %f12, 0f00000000;
    mov.f32             %f13, 0f00000000;
    mov.u32             %r34, 0;
    mov.u32             %r35, %r23;             // &p[0]
    add.u32             %r36, %r15, 0xFFFFFFFF; // n - 1
ACC2:   // two keys per step, two accumulators
    setp.ge.u32         %p2, %r34, %r36;
    @%p2 bra            ACC1;
    ld.shared.v2.f32    {%f14, %f15}, [%r35];
    ld.global.f32       %f16, [%rd18];
    add.s64             %rd19, %rd18, %rd5;
    ld.global.f32       %f17, [%rd19];
    fma.rn.f32          %f12, %f14, %f16, %f12;
    fma.rn.f32          %f13, %f15, %f17, %f13;
    add.s64             %rd18, %rd19, %rd5;
    add.u32             %r35, %r35, 8;
    add.u32             %r34, %r34, 2;
    bra.uni             ACC2;
ACC1:
    setp.ge.u32         %p2, %r34, %r15;
    @%p2 bra            ACC_DONE;
    ld.shared.f32       %f14, [%r35];
    ld.global.f32       %f16, [%rd18];
    fma.rn.f32          %f12, %f14, %f16, %f12;
ACC_DONE:
    add.f32             %f12, %f12, %f13;
    mul.f32             %f12, %f12, %f11;
    add.s64             %rd20, %rd14, %rd17;
    st.global.f32       [%rd20], %f12;
    add.u32             %r21, %r21, 256;
    bra.uni             DIMS;
DONE:
    ret;
}

// -----------------------------------------------------------------------------
// Kernel: gelu_mul   g[t][i] = gelu(g[t][i]) * p[t * pstride + i]  for i < n
//   (the per-layer input gate; gelu as in geglu). Grid-stride.
// -----------------------------------------------------------------------------
.visible .entry gelu_mul(
    .param .u64 p_g,            // f32 [tokens][n] (in/out)
    .param .u64 p_p,            // f32, row t at p + t * pstride
    .param .u32 p_n,
    .param .u32 p_pstride,
    .param .u32 p_tokens
)
{
    .reg .pred  %p<2>;
    .reg .b32   %r<16>;
    .reg .f32   %f<16>;
    .reg .b64   %rd<8>;

    ld.param.u64        %rd1, [p_g];
    ld.param.u64        %rd2, [p_p];
    ld.param.u32        %r1,  [p_n];
    ld.param.u32        %r11, [p_pstride];
    ld.param.u32        %r2,  [p_tokens];
    cvta.to.global.u64  %rd1, %rd1;
    cvta.to.global.u64  %rd2, %rd2;
    mul.lo.u32          %r2, %r2, %r1;          // total
    mov.u32             %r3, %tid.x;
    mov.u32             %r4, %ntid.x;
    mov.u32             %r5, %ctaid.x;
    mov.u32             %r6, %nctaid.x;
    mad.lo.u32          %r7, %r5, %r4, %r3;
    mul.lo.u32          %r8, %r6, %r4;
LOOP:
    setp.ge.u32         %p1, %r7, %r2;
    @%p1 bra            DONE;
    div.u32             %r9, %r7, %r1;          // t
    mul.lo.u32          %r10, %r9, %r1;
    sub.u32             %r10, %r7, %r10;        // i
    mad.lo.u32          %r10, %r9, %r11, %r10;  // t * pstride + i
    mul.wide.u32        %rd3, %r7, 4;
    add.s64             %rd3, %rd1, %rd3;
    ld.global.f32       %f1, [%rd3];            // g
    mul.wide.u32        %rd4, %r10, 4;
    add.s64             %rd4, %rd2, %rd4;
    ld.global.f32       %f2, [%rd4];            // p
    mul.f32             %f3, %f1, %f1;
    fma.rn.f32          %f3, %f3, 0f3D372713, 0f3F800000;   // 1 + 0.044715 x^2
    mul.f32             %f4, %f1, 0f3F4C422A;               // sqrt(2/pi) x
    mul.f32             %f4, %f4, %f3;          // y
    abs.f32             %f5, %f4;
    mul.f32             %f5, %f5, 0f4038AA3B;   // 2|y| log2(e)
    ex2.approx.f32      %f5, %f5;
    add.f32             %f5, %f5, 0f3F800000;
    div.rn.f32          %f6, 0f40000000, %f5;
    sub.f32             %f6, 0f3F800000, %f6;   // tanh(|y|)
    copysign.f32        %f6, %f4, %f6;
    add.f32             %f6, %f6, 0f3F800000;
    mul.f32             %f7, %f1, 0f3F000000;
    mul.f32             %f7, %f7, %f6;          // gelu(g)
    mul.f32             %f7, %f7, %f2;
    st.global.f32       [%rd3], %f7;
    add.u32             %r7, %r7, %r8;
    bra.uni             LOOP;
DONE:
    ret;
}

// -----------------------------------------------------------------------------
// Kernel: norm_add   per row:  x = (x + rmsnorm(y) * w) * s
//   rmsnorm(v) = v / sqrt(mean(v^2) + eps). Gemma's post-norm residual add,
//   with the per-layer output scale. One block (any multiple of 32 threads up
//   to 1024) per row of n values; gridDim.x = number of rows.
// -----------------------------------------------------------------------------
.visible .entry norm_add(
    .param .u64 p_y,            // f32 [rows][n]
    .param .u64 p_w,            // f32 [n]
    .param .u64 p_x,            // f32 [rows][n] (updated)
    .param .u32 p_n,
    .param .f32 p_eps,
    .param .f32 p_s
)
{
    .reg .pred  %p<4>;
    .reg .b32   %r<16>;
    .reg .f32   %f<16>;
    .reg .b64   %rd<12>;
    .shared .align 4 .f32 na_red[32];

    ld.param.u64        %rd1, [p_y];
    ld.param.u64        %rd2, [p_w];
    ld.param.u64        %rd3, [p_x];
    ld.param.u32        %r1,  [p_n];
    ld.param.f32        %f1,  [p_eps];
    ld.param.f32        %f13, [p_s];
    cvta.to.global.u64  %rd1, %rd1;
    cvta.to.global.u64  %rd2, %rd2;
    cvta.to.global.u64  %rd3, %rd3;
    mov.u32             %r12, %ctaid.x;         // row
    mul.wide.u32        %rd8, %r12, %r1;
    shl.b64             %rd8, %rd8, 2;
    add.s64             %rd1, %rd1, %rd8;
    add.s64             %rd3, %rd3, %rd8;
    mov.u32             %r2, %tid.x;
    mov.u32             %r3, %ntid.x;

    mov.f32             %f2, 0f00000000;
    mov.u32             %r4, %r2;
SUMSQ:
    setp.ge.u32         %p1, %r4, %r1;
    @%p1 bra            SUMSQ_DONE;
    mul.wide.u32        %rd4, %r4, 4;
    add.s64             %rd5, %rd1, %rd4;
    ld.global.f32       %f3, [%rd5];
    fma.rn.f32          %f2, %f3, %f3, %f2;
    add.u32             %r4, %r4, %r3;
    bra.uni             SUMSQ;
SUMSQ_DONE:
    shfl.sync.bfly.b32  %f3, %f2, 16, 31, -1;
    add.f32             %f2, %f2, %f3;
    shfl.sync.bfly.b32  %f3, %f2, 8, 31, -1;
    add.f32             %f2, %f2, %f3;
    shfl.sync.bfly.b32  %f3, %f2, 4, 31, -1;
    add.f32             %f2, %f2, %f3;
    shfl.sync.bfly.b32  %f3, %f2, 2, 31, -1;
    add.f32             %f2, %f2, %f3;
    shfl.sync.bfly.b32  %f3, %f2, 1, 31, -1;
    add.f32             %f2, %f2, %f3;

    and.b32             %r5, %r2, 31;           // lane
    shr.u32             %r6, %r2, 5;            // warp
    mov.u32             %r7, na_red;
    setp.ne.u32         %p2, %r5, 0;
    shl.b32             %r8, %r6, 2;
    add.u32             %r8, %r7, %r8;
    @!%p2 st.shared.f32 [%r8], %f2;
    bar.sync            0;

    shr.u32             %r9, %r3, 5;            // number of warps
    mov.f32             %f4, 0f00000000;
    mov.u32             %r10, 0;
WSUM:
    setp.ge.u32         %p3, %r10, %r9;
    @%p3 bra            WSUM_DONE;
    shl.b32             %r11, %r10, 2;
    add.u32             %r11, %r7, %r11;
    ld.shared.f32       %f5, [%r11];
    add.f32             %f4, %f4, %f5;
    add.u32             %r10, %r10, 1;
    bra.uni             WSUM;
WSUM_DONE:
    cvt.rn.f32.u32      %f6, %r1;
    div.rn.f32          %f7, %f4, %f6;          // mean(y^2)
    add.f32             %f7, %f7, %f1;
    sqrt.rn.f32         %f8, %f7;
    rcp.rn.f32          %f9, %f8;               // scale

    mov.u32             %r4, %r2;
APPLY:
    setp.ge.u32         %p1, %r4, %r1;
    @%p1 bra            DONE;
    mul.wide.u32        %rd4, %r4, 4;
    add.s64             %rd5, %rd1, %rd4;
    add.s64             %rd6, %rd2, %rd4;
    add.s64             %rd7, %rd3, %rd4;
    ld.global.f32       %f10, [%rd5];
    ld.global.f32       %f11, [%rd6];
    ld.global.f32       %f12, [%rd7];
    mul.f32             %f10, %f10, %f9;
    fma.rn.f32          %f12, %f10, %f11, %f12; // x + rmsnorm(y) * w
    mul.f32             %f12, %f12, %f13;
    st.global.f32       [%rd7], %f12;
    add.u32             %r4, %r4, %r3;
    bra.uni             APPLY;
DONE:
    ret;
}

// -----------------------------------------------------------------------------
// Kernel: scale   x[i] *= s  for i < n. Grid-stride.
// -----------------------------------------------------------------------------
.visible .entry scale(
    .param .u64 p_x,            // f32 [n] (in/out)
    .param .u32 p_n,
    .param .f32 p_s
)
{
    .reg .pred  %p<2>;
    .reg .b32   %r<8>;
    .reg .f32   %f<4>;
    .reg .b64   %rd<4>;

    ld.param.u64        %rd1, [p_x];
    ld.param.u32        %r1,  [p_n];
    ld.param.f32        %f1,  [p_s];
    cvta.to.global.u64  %rd1, %rd1;
    mov.u32             %r2, %tid.x;
    mov.u32             %r3, %ntid.x;
    mov.u32             %r4, %ctaid.x;
    mov.u32             %r5, %nctaid.x;
    mad.lo.u32          %r6, %r4, %r3, %r2;
    mul.lo.u32          %r7, %r5, %r3;
LOOP:
    setp.ge.u32         %p1, %r6, %r1;
    @%p1 bra            DONE;
    mul.wide.u32        %rd2, %r6, 4;
    add.s64             %rd2, %rd1, %rd2;
    ld.global.f32       %f2, [%rd2];
    mul.f32             %f2, %f2, %f1;
    st.global.f32       [%rd2], %f2;
    add.u32             %r6, %r6, %r7;
    bra.uni             LOOP;
DONE:
    ret;
}
