//
// minimaxh3.ptx - hand-written PTX kernels for MiniMax-H3 text-to-audio-video
// generation: a prompt becomes a short video with a stereo soundtrack.
//
// The host (minimaxh3.c) runs four networks, one after the other:
//
//   text encoder (Qwen3-VL-32B language model cut to 50 layers, width 5120,
//   64 query / 8 key-value heads of 128, causal, no final norm):
//     h = embed(tokens); per layer: h += o(attn(rope(norm(qkv(rms(h))))))
//                                   h += down(swiglu(gate|up(rms(h))))
//                         rms_mod, dequant_q4k / q6k + gemm_f16, qk_norm_rope,
//                         attn_d128 (causal, grouped), swiglu
//   diffusion transformer (50 blocks + 2 token-refiner blocks, width 5376,
//   56 heads of 128): one packed sequence [text | audio L | audio R | video]
//   with 3-D RoPE on 96 of each head's 128 dims; every block modulates its
//   norms with AdaLN vectors chosen per token by (timestep, modality):
//     x += gate1 * out(attn(qk_norm_rope(qkv(rms(x) * (1 + scale1) + shift1))))
//     x += gate2 * fc2(swiglu(fc1(rms(x) * (1 + scale2) + shift2)))
//                         adaln, rms_mod, gemm_f16 (mode 5: gated residual),
//                         qk_norm_rope, attn_d128, swiglu, linear_f32
//   video VAE decoder (a 36-layer ViT, width 2048, 32 heads of 64, RoPE on 48
//   dims): one latent token -> a 4 x 16 x 16 x 3 block of pixels, decoded in
//   overlapping chunks of 7 latent frames and 256-pixel tiles
//                         rms_mod, gemm_f16, qk_norm_rope, attn_d64, layernorm
//   audio VAE decoder (BigVGAN: 7 transposed convolutions, x800 in all, with
//   anti-aliased SnakeBeta residual blocks): 40 latents/s -> 32 kHz, per
//   channel        im2col1d + gemm_f16, col2im_t, aa_snake, axpby
//
// Big matrices stay in their GGUF formats on the GPU (Q4_K, Q6_K) and are
// expanded to f16 one slice of rows at a time just before their GEMM;
// every matrix product is an f16 tensor-core mma with f32 accumulation. The
// residual streams, norms, softmax statistics and small heads stay f32.
// Activations are row-major [tokens][channels] (audio: [time][channels]).
//

.version 8.0
.target sm_89            // Ada Lovelace (RTX 40xx)
.address_size 64

// -----------------------------------------------------------------------------
// Function: store_pair   gemm_f16's epilogue for two adjacent outputs (row,
//   col) and (row, col + 1): v = acc * alpha + bias, then the mode (see
//   gemm_f16); rows >= m are dropped.
// -----------------------------------------------------------------------------
.func store_pair (.reg .b64 c, .reg .b32 ldc, .reg .b32 row, .reg .b32 col,
                  .reg .f32 v0, .reg .f32 v1, .reg .b64 bias, .reg .b32 m,
                  .reg .b32 mode, .reg .b64 gate, .reg .b64 seg, .reg .b32 gld,
                  .reg .f32 alpha)
{
    .reg .pred  %sp<4>;
    .reg .b32   %sr<4>;
    .reg .b64   %sd<4>;
    .reg .f32   %sf<4>;
    .reg .b16   %sh;

    setp.ge.u32     %sp0, row, m;
    @%sp0 bra       SP_DONE;
    mul.f32         v0, v0, alpha;
    mul.f32         v1, v1, alpha;
    setp.eq.u64     %sp1, bias, 0;
    @%sp1 bra       SP_NOBIAS;
    mul.wide.u32    %sd0, col, 4;
    add.s64         %sd0, bias, %sd0;
    ld.global.nc.v2.f32 {%sf0, %sf1}, [%sd0];
    add.f32         v0, v0, %sf0;
    add.f32         v1, v1, %sf1;
SP_NOBIAS:
    mad.lo.u32      %sr0, row, ldc, col;    // element index
    setp.eq.u32     %sp1, mode, 1;
    @%sp1 bra       SP_F16;
    setp.eq.u32     %sp1, mode, 0;
    @%sp1 bra       SP_F32;
    setp.eq.u32     %sp1, mode, 5;
    @!%sp1 bra      SP_ADD;
    mov.u32         %sr2, 0;                // mode 5: gate of the row's segment
    setp.eq.u64     %sp2, seg, 0;
    @%sp2 bra       SP_GATE;
    cvt.u64.u32     %sd2, row;
    add.s64         %sd2, seg, %sd2;
    ld.global.nc.u8 %sh, [%sd2];
    cvt.u32.u16     %sr2, %sh;
SP_GATE:
    mad.lo.u32      %sr2, %sr2, gld, col;
    mul.wide.u32    %sd2, %sr2, 4;
    add.s64         %sd2, gate, %sd2;
    ld.global.nc.v2.f32 {%sf0, %sf1}, [%sd2];
    mul.f32         v0, v0, %sf0;
    mul.f32         v1, v1, %sf1;
SP_ADD:
    mul.wide.u32    %sd1, %sr0, 4;          // modes 4, 5: residual add
    add.s64         %sd1, c, %sd1;
    ld.global.v2.f32 {%sf2, %sf3}, [%sd1];
    add.f32         v0, v0, %sf2;
    add.f32         v1, v1, %sf3;
    st.global.v2.f32 [%sd1], {v0, v1};
    bra.uni         SP_DONE;
SP_F32:
    mul.wide.u32    %sd1, %sr0, 4;
    add.s64         %sd1, c, %sd1;
    st.global.v2.f32 [%sd1], {v0, v1};
    bra.uni         SP_DONE;
SP_F16:
    cvt.rn.f16x2.f32 %sr1, v1, v0;
    mul.wide.u32    %sd1, %sr0, 2;
    add.s64         %sd1, c, %sd1;
    st.global.b32   [%sd1], %sr1;
SP_DONE:
    ret;
}

// -----------------------------------------------------------------------------
// Kernel: dequant_q4k   Q4_K blocks -> f16 values (a matrix slice, row-major)
//   Block (144 bytes, 256 values = 8 sub-blocks of 32): f16 d, f16 dmin,
//   u8 scales[12] (a 6-bit scale and min per sub-block), u8 qs[128].
//   Sub-block j: w = d * sc_j * q - dmin * m_j, q = nibble (j & 1) of
//   qs[32 (j / 2) + l]; (sc_j, m_j) as ggml's get_scale_min_k4: for j < 4
//   the low 6 bits of scales[j] and scales[j + 4], else 4 bits of
//   scales[j + 4] plus the top 2 bits of scales[j - 4] (scale) / scales[j]
//   (min). One thread per sub-block, grid-stride; writes 32 halves.
// -----------------------------------------------------------------------------
.visible .entry dequant_q4k(
    .param .u64 p_src,          // Q4_K blocks
    .param .u64 p_dst,          // f16 [blocks * 256] (out)
    .param .u32 p_nsub          // blocks * 8
)
{
    .reg .pred  %p<3>;
    .reg .b32   %r<48>;
    .reg .b64   %rd<8>;
    .reg .f32   %f<8>;
    .reg .b16   %h<4>;

    ld.param.u32    %r0, [p_nsub];
    ld.param.u64    %rd0, [p_src];
    ld.param.u64    %rd1, [p_dst];
    mov.u32         %r1, %ctaid.x;
    mov.u32         %r2, %ntid.x;
    mov.u32         %r3, %tid.x;
    mad.lo.u32      %r4, %r1, %r2, %r3;
    mov.u32         %r5, %nctaid.x;
    mul.lo.u32      %r5, %r5, %r2;
LOOP:
    setp.ge.u32     %p0, %r4, %r0;
    @%p0 bra        DONE;
    shr.u32         %r6, %r4, 3;            // block
    and.b32         %r7, %r4, 7;            // sub-block j
    mul.wide.u32    %rd2, %r6, 144;
    add.s64         %rd2, %rd0, %rd2;
    ld.global.nc.b16 %h0, [%rd2];
    cvt.f32.f16     %f0, %h0;               // d
    ld.global.nc.b16 %h1, [%rd2+2];
    cvt.f32.f16     %f1, %h1;               // dmin
    // scale and min of sub-block j
    setp.lt.u32     %p1, %r7, 4;
    cvt.u64.u32     %rd3, %r7;
    add.s64         %rd3, %rd2, %rd3;       // &scales[j] - 4
    ld.global.nc.u8 %r8, [%rd3+4];          // scales[j]
    ld.global.nc.u8 %r9, [%rd3+8];          // scales[j + 4]
    @!%p1 bra       HI;
    and.b32         %r10, %r8, 63;          // sc
    and.b32         %r11, %r9, 63;          // m
    bra.uni         SCALED;
HI:
    ld.global.nc.u8 %r12, [%rd3];           // scales[j - 4]
    and.b32         %r10, %r9, 15;
    shr.u32         %r13, %r12, 6;
    shl.b32         %r13, %r13, 4;
    or.b32          %r10, %r10, %r13;       // sc
    shr.u32         %r11, %r9, 4;
    shr.u32         %r13, %r8, 6;
    shl.b32         %r13, %r13, 4;
    or.b32          %r11, %r11, %r13;       // m
SCALED:
    cvt.rn.f32.u32  %f2, %r10;
    mul.f32         %f2, %f0, %f2;          // d1 = d * sc
    cvt.rn.f32.u32  %f3, %r11;
    mul.f32         %f3, %f1, %f3;          // m1 = dmin * m
    // 32 quant bytes of the pair of sub-blocks
    shr.u32         %r14, %r7, 1;
    shl.b32         %r14, %r14, 5;
    add.u32         %r14, %r14, 16;
    cvt.u64.u32     %rd4, %r14;
    add.s64         %rd4, %rd2, %rd4;
    and.b32         %r15, %r7, 1;
    shl.b32         %r15, %r15, 2;          // nibble shift 0 / 4
    // output: 32 halves at block * 256 + 32 j
    shl.b32         %r16, %r6, 8;
    shl.b32         %r17, %r7, 5;
    add.u32         %r16, %r16, %r17;
    mul.wide.u32    %rd5, %r16, 2;
    add.s64         %rd5, %rd1, %rd5;
    mov.u32         %r18, 0;                // 4-byte word of qs
WORD:
    cvt.u64.u32     %rd6, %r18;
    add.s64         %rd6, %rd4, %rd6;
    ld.global.nc.u32 %r19, [%rd6];          // 4 quant bytes (144-byte blocks stay 16-byte aligned)
    shr.b32         %r19, %r19, %r15;       // nibble j & 1 in the low half of each byte
    and.b32         %r21, %r19, 15;
    shr.u32         %r22, %r19, 8;
    and.b32         %r22, %r22, 15;
    shr.u32         %r23, %r19, 16;
    and.b32         %r23, %r23, 15;
    shr.u32         %r24, %r19, 24;
    and.b32         %r24, %r24, 15;
    cvt.rn.f32.u32  %f4, %r21;
    cvt.rn.f32.u32  %f5, %r22;
    cvt.rn.f32.u32  %f6, %r23;
    cvt.rn.f32.u32  %f7, %r24;
    mul.f32         %f4, %f2, %f4;
    sub.f32         %f4, %f4, %f3;
    mul.f32         %f5, %f2, %f5;
    sub.f32         %f5, %f5, %f3;
    mul.f32         %f6, %f2, %f6;
    sub.f32         %f6, %f6, %f3;
    mul.f32         %f7, %f2, %f7;
    sub.f32         %f7, %f7, %f3;
    cvt.rn.f16x2.f32 %r25, %f5, %f4;
    cvt.rn.f16x2.f32 %r26, %f7, %f6;
    st.global.v2.b32 [%rd5], {%r25, %r26};
    add.s64         %rd5, %rd5, 8;
    add.u32         %r18, %r18, 4;
    setp.lt.u32     %p2, %r18, 32;
    @%p2 bra        WORD;
    add.u32         %r4, %r4, %r5;
    bra.uni         LOOP;
DONE:
    ret;
}

// -----------------------------------------------------------------------------
// Kernel: dequant_q6k   Q6_K blocks -> f16 values
//   Block (210 bytes, 256 values): u8 ql[128], u8 qh[64], i8 scales[16],
//   f16 d. Half n (values 128 n ..) uses ql[64 n ..], qh[32 n ..],
//   scales[8 n ..]; its value 32 k + l (k < 4, l < 32) is
//   q = (nibble (k >> 1) of ql[l + 32 (k & 1)]) | (bits 2k, 2k+1 of qh[l]) << 4,
//   w = d * scales[l / 16 + 2 k] * (q - 32).
//   One thread per 16 values (half n, quarter k, l from 16 il), grid-stride.
//   210-byte blocks are only 2-byte aligned: bytes are read one by one.
// -----------------------------------------------------------------------------
.visible .entry dequant_q6k(
    .param .u64 p_src,
    .param .u64 p_dst,          // f16 (out)
    .param .u32 p_ngrp          // blocks * 16
)
{
    .reg .pred  %p<3>;
    .reg .b32   %r<40>;
    .reg .b64   %rd<10>;
    .reg .f32   %f<8>;
    .reg .b16   %h<2>;

    ld.param.u32    %r0, [p_ngrp];
    ld.param.u64    %rd0, [p_src];
    ld.param.u64    %rd1, [p_dst];
    mov.u32         %r1, %ctaid.x;
    mov.u32         %r2, %ntid.x;
    mov.u32         %r3, %tid.x;
    mad.lo.u32      %r4, %r1, %r2, %r3;
    mov.u32         %r5, %nctaid.x;
    mul.lo.u32      %r5, %r5, %r2;
LOOP:
    setp.ge.u32     %p0, %r4, %r0;
    @%p0 bra        DONE;
    shr.u32         %r6, %r4, 4;            // block
    and.b32         %r7, %r4, 15;
    shr.u32         %r8, %r7, 3;            // half n
    shr.u32         %r9, %r7, 1;
    and.b32         %r9, %r9, 3;            // quarter k
    and.b32         %r10, %r7, 1;           // il
    mul.wide.u32    %rd2, %r6, 210;
    add.s64         %rd2, %rd0, %rd2;
    ld.global.nc.b16 %h0, [%rd2+208];
    cvt.f32.f16     %f0, %h0;               // d
    // scale scales[8 n + il + 2 k] (signed)
    shl.b32         %r11, %r8, 3;
    add.u32         %r11, %r11, %r10;
    shl.b32         %r12, %r9, 1;
    add.u32         %r11, %r11, %r12;
    cvt.u64.u32     %rd3, %r11;
    add.s64         %rd3, %rd2, %rd3;
    ld.global.nc.s8 %r13, [%rd3+192];
    cvt.rn.f32.s32  %f1, %r13;
    mul.f32         %f1, %f0, %f1;          // d * scale
    // ql + 64 n + 32 (k & 1) + 16 il, qh + 32 n + 16 il
    shl.b32         %r14, %r8, 6;
    and.b32         %r15, %r9, 1;
    shl.b32         %r15, %r15, 5;
    add.u32         %r14, %r14, %r15;
    shl.b32         %r16, %r10, 4;
    add.u32         %r14, %r14, %r16;
    cvt.u64.u32     %rd4, %r14;
    add.s64         %rd4, %rd2, %rd4;       // ql pointer
    shl.b32         %r17, %r8, 5;
    add.u32         %r17, %r17, %r16;
    add.u32         %r17, %r17, 128;
    cvt.u64.u32     %rd5, %r17;
    add.s64         %rd5, %rd2, %rd5;       // qh pointer
    shr.u32         %r18, %r9, 1;
    shl.b32         %r18, %r18, 2;          // ql nibble shift
    shl.b32         %r19, %r9, 1;           // qh shift 2k
    // output: block * 256 + 128 n + 32 k + 16 il
    shl.b32         %r20, %r6, 8;
    shl.b32         %r21, %r8, 7;
    add.u32         %r20, %r20, %r21;
    shl.b32         %r21, %r9, 5;
    add.u32         %r20, %r20, %r21;
    add.u32         %r20, %r20, %r16;
    mul.wide.u32    %rd6, %r20, 2;
    add.s64         %rd6, %rd1, %rd6;
    mov.u32         %r22, 0;
VAL:
    cvt.u64.u32     %rd7, %r22;
    add.s64         %rd8, %rd4, %rd7;
    ld.global.nc.u8 %r23, [%rd8];
    ld.global.nc.u8 %r24, [%rd8+1];
    add.s64         %rd9, %rd5, %rd7;
    ld.global.nc.u8 %r25, [%rd9];
    ld.global.nc.u8 %r26, [%rd9+1];
    shr.u32         %r23, %r23, %r18;
    and.b32         %r23, %r23, 15;
    shr.u32         %r25, %r25, %r19;
    and.b32         %r25, %r25, 3;
    shl.b32         %r25, %r25, 4;
    or.b32          %r23, %r23, %r25;
    sub.s32         %r23, %r23, 32;
    shr.u32         %r24, %r24, %r18;
    and.b32         %r24, %r24, 15;
    shr.u32         %r26, %r26, %r19;
    and.b32         %r26, %r26, 3;
    shl.b32         %r26, %r26, 4;
    or.b32          %r24, %r24, %r26;
    sub.s32         %r24, %r24, 32;
    cvt.rn.f32.s32  %f2, %r23;
    cvt.rn.f32.s32  %f3, %r24;
    mul.f32         %f2, %f1, %f2;
    mul.f32         %f3, %f1, %f3;
    cvt.rn.f16x2.f32 %r27, %f3, %f2;
    st.global.b32   [%rd6], %r27;
    add.s64         %rd6, %rd6, 4;
    add.u32         %r22, %r22, 2;
    setp.lt.u32     %p2, %r22, 16;
    @%p2 bra        VAL;
    add.u32         %r4, %r4, %r5;
    bra.uni         LOOP;
DONE:
    ret;
}

// -----------------------------------------------------------------------------
// Kernel: rms_mod   per row: v = x / sqrt(mean(x^2) + eps) [* w], then the
//   AdaLN modulation v + v * scale[s] + shift[s] of the row's segment
//   s = seg[row] (s = 0 without seg), and the outputs: y16 = v * oscale (f16)
//   and/or y32 = v (f32). w, shift/scale, seg, y16, y32 may each be 0.
//   shift and scale rows are mstride elements apart per segment.
//   One warp per row (n % 128 == 0), 8 rows per 256-thread block.
// -----------------------------------------------------------------------------
.visible .entry rms_mod(
    .param .u64 p_x,            // f32 [rows][n]
    .param .u64 p_w,            // f32 [n] or 0
    .param .u64 p_shift,        // f32 [S][mstride] or 0
    .param .u64 p_scale,        // f32 [S][mstride] or 0
    .param .u32 p_mstride,
    .param .u64 p_seg,          // u8 [rows] or 0
    .param .u64 p_y16,          // f16 [rows][n] or 0
    .param .u64 p_y32,          // f32 [rows][n] or 0
    .param .u32 p_rows,
    .param .u32 p_n,
    .param .f32 p_eps,
    .param .f32 p_oscale
)
{
    .reg .pred  %p<8>;
    .reg .b32   %r<24>;
    .reg .b64   %rd<20>;
    .reg .f32   %f<32>;
    .reg .b16   %h;

    mov.u32         %r0, %tid.x;
    and.b32         %r1, %r0, 31;           // lane
    shr.u32         %r2, %r0, 5;
    mov.u32         %r3, %ctaid.x;
    shl.b32         %r3, %r3, 3;
    add.u32         %r3, %r3, %r2;          // row
    ld.param.u32    %r4, [p_rows];
    setp.ge.u32     %p0, %r3, %r4;
    @%p0 bra        DONE;
    ld.param.u32    %r5, [p_n];
    mul.wide.u32    %rd0, %r3, %r5;
    shl.b64         %rd0, %rd0, 2;
    ld.param.u64    %rd1, [p_x];
    add.s64         %rd1, %rd1, %rd0;       // x row
    shl.b32         %r7, %r1, 2;            // first column of this lane

    mov.f32         %f0, 0f00000000;
    mov.u32         %r8, %r7;
SUMSQ:
    mul.wide.u32    %rd2, %r8, 4;
    add.s64         %rd3, %rd1, %rd2;
    ld.global.v4.f32 {%f4, %f5, %f6, %f7}, [%rd3];
    fma.rn.f32      %f0, %f4, %f4, %f0;
    fma.rn.f32      %f0, %f5, %f5, %f0;
    fma.rn.f32      %f0, %f6, %f6, %f0;
    fma.rn.f32      %f0, %f7, %f7, %f0;
    add.u32         %r8, %r8, 128;
    setp.lt.u32     %p1, %r8, %r5;
    @%p1 bra        SUMSQ;
    shfl.sync.bfly.b32 %f1, %f0, 16, 31, 0xffffffff;
    add.f32         %f0, %f0, %f1;
    shfl.sync.bfly.b32 %f1, %f0, 8, 31, 0xffffffff;
    add.f32         %f0, %f0, %f1;
    shfl.sync.bfly.b32 %f1, %f0, 4, 31, 0xffffffff;
    add.f32         %f0, %f0, %f1;
    shfl.sync.bfly.b32 %f1, %f0, 2, 31, 0xffffffff;
    add.f32         %f0, %f0, %f1;
    shfl.sync.bfly.b32 %f1, %f0, 1, 31, 0xffffffff;
    add.f32         %f0, %f0, %f1;
    cvt.rn.f32.u32  %f2, %r5;
    div.rn.f32      %f0, %f0, %f2;
    ld.param.f32    %f2, [p_eps];
    add.f32         %f0, %f0, %f2;
    sqrt.rn.f32     %f0, %f0;
    rcp.rn.f32      %f3, %f0;               // 1 / rms

    ld.param.u64    %rd4, [p_w];
    setp.ne.u64     %p2, %rd4, 0;
    ld.param.u64    %rd5, [p_shift];
    ld.param.u64    %rd6, [p_scale];
    setp.ne.u64     %p3, %rd5, 0;
    // segment row of the modulation
    mov.u32         %r9, 0;
    ld.param.u64    %rd7, [p_seg];
    setp.eq.u64     %p4, %rd7, 0;
    @%p4 bra        NOSEG;
    cvt.u64.u32     %rd8, %r3;
    add.s64         %rd8, %rd7, %rd8;
    ld.global.nc.u8 %h, [%rd8];
    cvt.u32.u16     %r9, %h;
NOSEG:
    ld.param.u32    %r10, [p_mstride];
    mul.lo.u32      %r9, %r9, %r10;         // segment offset
    ld.param.u64    %rd9, [p_y16];
    setp.ne.u64     %p5, %rd9, 0;
    ld.param.u64    %rd10, [p_y32];
    setp.ne.u64     %p6, %rd10, 0;
    ld.param.f32    %f20, [p_oscale];
    mul.wide.u32    %rd11, %r3, %r5;
    shl.b64         %rd12, %rd11, 1;
    add.s64         %rd9, %rd9, %rd12;      // y16 row
    shl.b64         %rd12, %rd11, 2;
    add.s64         %rd10, %rd10, %rd12;    // y32 row
    mov.u32         %r8, %r7;
APPLY:
    mul.wide.u32    %rd2, %r8, 4;
    add.s64         %rd3, %rd1, %rd2;
    ld.global.v4.f32 {%f4, %f5, %f6, %f7}, [%rd3];
    mul.f32         %f4, %f4, %f3;
    mul.f32         %f5, %f5, %f3;
    mul.f32         %f6, %f6, %f3;
    mul.f32         %f7, %f7, %f3;
    @!%p2 bra       NOW;
    add.s64         %rd13, %rd4, %rd2;
    ld.global.nc.v4.f32 {%f8, %f9, %f10, %f11}, [%rd13];
    mul.f32         %f4, %f4, %f8;
    mul.f32         %f5, %f5, %f9;
    mul.f32         %f6, %f6, %f10;
    mul.f32         %f7, %f7, %f11;
NOW:
    @!%p3 bra       NOMOD;
    add.u32         %r11, %r9, %r8;
    mul.wide.u32    %rd14, %r11, 4;
    add.s64         %rd15, %rd6, %rd14;
    ld.global.nc.v4.f32 {%f8, %f9, %f10, %f11}, [%rd15];     // scale
    add.s64         %rd15, %rd5, %rd14;
    ld.global.nc.v4.f32 {%f12, %f13, %f14, %f15}, [%rd15];   // shift
    fma.rn.f32      %f8, %f4, %f8, %f4;
    add.f32         %f4, %f8, %f12;
    fma.rn.f32      %f9, %f5, %f9, %f5;
    add.f32         %f5, %f9, %f13;
    fma.rn.f32      %f10, %f6, %f10, %f6;
    add.f32         %f6, %f10, %f14;
    fma.rn.f32      %f11, %f7, %f11, %f7;
    add.f32         %f7, %f11, %f15;
NOMOD:
    @!%p6 bra       NO32;
    add.s64         %rd16, %rd10, %rd2;
    st.global.v4.f32 [%rd16], {%f4, %f5, %f6, %f7};
NO32:
    @!%p5 bra       NEXT;
    mul.f32         %f16, %f4, %f20;
    mul.f32         %f17, %f5, %f20;
    mul.f32         %f18, %f6, %f20;
    mul.f32         %f19, %f7, %f20;
    cvt.rn.f16x2.f32 %r12, %f17, %f16;
    cvt.rn.f16x2.f32 %r13, %f19, %f18;
    mul.wide.u32    %rd17, %r8, 2;
    add.s64         %rd17, %rd9, %rd17;
    st.global.v2.b32 [%rd17], {%r12, %r13};
NEXT:
    add.u32         %r8, %r8, 128;
    setp.lt.u32     %p1, %r8, %r5;
    @%p1 bra        APPLY;
DONE:
    ret;
}

// -----------------------------------------------------------------------------
// Kernel: layernorm   y16 = (x - mean) / sqrt(var + eps) * w + b, per row
//   (the video VAE decoder's norm_out). One warp per row (n % 128 == 0),
//   8 rows per 256-thread block.
// -----------------------------------------------------------------------------
.visible .entry layernorm(
    .param .u64 p_x,            // f32 [rows][n]
    .param .u64 p_w,            // f32 [n]
    .param .u64 p_b,            // f32 [n]
    .param .u64 p_y16,          // f16 [rows][n] (out)
    .param .u32 p_rows,
    .param .u32 p_n,
    .param .f32 p_eps
)
{
    .reg .pred  %p<4>;
    .reg .b32   %r<16>;
    .reg .b64   %rd<12>;
    .reg .f32   %f<20>;

    mov.u32         %r0, %tid.x;
    and.b32         %r1, %r0, 31;
    shr.u32         %r2, %r0, 5;
    mov.u32         %r3, %ctaid.x;
    shl.b32         %r3, %r3, 3;
    add.u32         %r3, %r3, %r2;          // row
    ld.param.u32    %r4, [p_rows];
    setp.ge.u32     %p0, %r3, %r4;
    @%p0 bra        DONE;
    ld.param.u32    %r5, [p_n];
    mul.wide.u32    %rd0, %r3, %r5;
    shl.b64         %rd1, %rd0, 2;
    ld.param.u64    %rd2, [p_x];
    add.s64         %rd2, %rd2, %rd1;       // x row
    shl.b32         %r7, %r1, 2;

    mov.f32         %f0, 0f00000000;
    mov.u32         %r8, %r7;
SUM:
    mul.wide.u32    %rd3, %r8, 4;
    add.s64         %rd4, %rd2, %rd3;
    ld.global.v4.f32 {%f4, %f5, %f6, %f7}, [%rd4];
    add.f32         %f0, %f0, %f4;
    add.f32         %f0, %f0, %f5;
    add.f32         %f0, %f0, %f6;
    add.f32         %f0, %f0, %f7;
    add.u32         %r8, %r8, 128;
    setp.lt.u32     %p1, %r8, %r5;
    @%p1 bra        SUM;
    shfl.sync.bfly.b32 %f1, %f0, 16, 31, 0xffffffff;
    add.f32         %f0, %f0, %f1;
    shfl.sync.bfly.b32 %f1, %f0, 8, 31, 0xffffffff;
    add.f32         %f0, %f0, %f1;
    shfl.sync.bfly.b32 %f1, %f0, 4, 31, 0xffffffff;
    add.f32         %f0, %f0, %f1;
    shfl.sync.bfly.b32 %f1, %f0, 2, 31, 0xffffffff;
    add.f32         %f0, %f0, %f1;
    shfl.sync.bfly.b32 %f1, %f0, 1, 31, 0xffffffff;
    add.f32         %f0, %f0, %f1;
    cvt.rn.f32.u32  %f2, %r5;
    div.rn.f32      %f3, %f0, %f2;          // mean
    mov.f32         %f0, 0f00000000;
    mov.u32         %r8, %r7;
VAR:
    mul.wide.u32    %rd3, %r8, 4;
    add.s64         %rd4, %rd2, %rd3;
    ld.global.v4.f32 {%f4, %f5, %f6, %f7}, [%rd4];
    sub.f32         %f4, %f4, %f3;
    sub.f32         %f5, %f5, %f3;
    sub.f32         %f6, %f6, %f3;
    sub.f32         %f7, %f7, %f3;
    fma.rn.f32      %f0, %f4, %f4, %f0;
    fma.rn.f32      %f0, %f5, %f5, %f0;
    fma.rn.f32      %f0, %f6, %f6, %f0;
    fma.rn.f32      %f0, %f7, %f7, %f0;
    add.u32         %r8, %r8, 128;
    setp.lt.u32     %p1, %r8, %r5;
    @%p1 bra        VAR;
    shfl.sync.bfly.b32 %f1, %f0, 16, 31, 0xffffffff;
    add.f32         %f0, %f0, %f1;
    shfl.sync.bfly.b32 %f1, %f0, 8, 31, 0xffffffff;
    add.f32         %f0, %f0, %f1;
    shfl.sync.bfly.b32 %f1, %f0, 4, 31, 0xffffffff;
    add.f32         %f0, %f0, %f1;
    shfl.sync.bfly.b32 %f1, %f0, 2, 31, 0xffffffff;
    add.f32         %f0, %f0, %f1;
    shfl.sync.bfly.b32 %f1, %f0, 1, 31, 0xffffffff;
    add.f32         %f0, %f0, %f1;
    div.rn.f32      %f0, %f0, %f2;
    ld.param.f32    %f1, [p_eps];
    add.f32         %f0, %f0, %f1;
    sqrt.rn.f32     %f0, %f0;
    rcp.rn.f32      %f8, %f0;               // 1 / std
    ld.param.u64    %rd5, [p_w];
    ld.param.u64    %rd6, [p_b];
    ld.param.u64    %rd7, [p_y16];
    shl.b64         %rd1, %rd0, 1;
    add.s64         %rd7, %rd7, %rd1;
    mov.u32         %r8, %r7;
OUT:
    mul.wide.u32    %rd3, %r8, 4;
    add.s64         %rd4, %rd2, %rd3;
    ld.global.v4.f32 {%f4, %f5, %f6, %f7}, [%rd4];
    add.s64         %rd8, %rd5, %rd3;
    ld.global.nc.v4.f32 {%f9, %f10, %f11, %f12}, [%rd8];
    add.s64         %rd8, %rd6, %rd3;
    ld.global.nc.v4.f32 {%f13, %f14, %f15, %f16}, [%rd8];
    sub.f32         %f4, %f4, %f3;
    mul.f32         %f4, %f4, %f8;
    fma.rn.f32      %f4, %f4, %f9, %f13;
    sub.f32         %f5, %f5, %f3;
    mul.f32         %f5, %f5, %f8;
    fma.rn.f32      %f5, %f5, %f10, %f14;
    sub.f32         %f6, %f6, %f3;
    mul.f32         %f6, %f6, %f8;
    fma.rn.f32      %f6, %f6, %f11, %f15;
    sub.f32         %f7, %f7, %f3;
    mul.f32         %f7, %f7, %f8;
    fma.rn.f32      %f7, %f7, %f12, %f16;
    cvt.rn.f16x2.f32 %r9, %f5, %f4;
    cvt.rn.f16x2.f32 %r10, %f7, %f6;
    mul.wide.u32    %rd9, %r8, 2;
    add.s64         %rd9, %rd7, %rd9;
    st.global.v2.b32 [%rd9], {%r9, %r10};
    add.u32         %r8, %r8, 128;
    setp.lt.u32     %p1, %r8, %r5;
    @%p1 bra        OUT;
DONE:
    ret;
}

// -----------------------------------------------------------------------------
// Kernel: qk_norm_rope   in place on a fused projection (f16 [rows][ld]):
//   every q head (nq of them, at columns qoff + h*hstride) and k head (nk, at
//   koff + h*hstride) gets an RMS norm over its D values (times qw / kw when
//   given), then a rotary embedding of its first `rot` dims in rotate-half
//   form: dim i < rot/2 pairs with i + rot/2 and both turn by angle a_i of
//   the row's table cs (f32 [rows][rot/2][2] cos, sin):
//     x'_i = x_i c - x_(i+rot/2) s,   x'_(i+rot/2) = x_i s + x_(i+rot/2) c.
//   Dims >= rot keep their values (partial rotary). cs = 0: no rotation.
//   One warp per (row, head), D / 32 values per lane (D = 64 or 128); the
//   partner of a lane's dims sits rot/2 / (D/32) lanes away (shfl).
// -----------------------------------------------------------------------------
.visible .entry qk_norm_rope(
    .param .u64 p_x,            // f16 [rows][ld] (in place)
    .param .u32 p_ld,
    .param .u32 p_rows,
    .param .u32 p_nq,
    .param .u32 p_nk,
    .param .u32 p_qoff,
    .param .u32 p_koff,
    .param .u32 p_hstride,
    .param .u32 p_d,            // 64 or 128
    .param .u64 p_qw,           // f32 [D] or 0
    .param .u64 p_kw,           // f32 [D] or 0
    .param .f32 p_eps,
    .param .u64 p_cs,           // f32 [rows][rot/2][2] or 0
    .param .u32 p_rot
)
{
    .reg .pred  %p<8>;
    .reg .b32   %r<40>;
    .reg .b64   %rd<12>;
    .reg .f32   %f<32>;
    .reg .b16   %h<4>;

    mov.u32         %r0, %tid.x;
    and.b32         %r1, %r0, 31;           // lane
    mov.u32         %r2, %ctaid.x;
    mov.u32         %r3, %ntid.x;
    mad.lo.u32      %r4, %r2, %r3, %r0;
    shr.u32         %r4, %r4, 5;            // warp = (row, head)
    ld.param.u32    %r5, [p_nq];
    ld.param.u32    %r6, [p_nk];
    add.u32         %r7, %r5, %r6;
    div.u32         %r8, %r4, %r7;          // row
    rem.u32         %r9, %r4, %r7;          // head index
    ld.param.u32    %r10, [p_rows];
    setp.ge.u32     %p0, %r8, %r10;
    @%p0 bra        DONE;
    ld.param.u32    %r11, [p_hstride];
    ld.param.u32    %r12, [p_d];
    setp.lt.u32     %p1, %r9, %r5;          // a q head
    @%p1 ld.param.u32 %r13, [p_qoff];
    @%p1 mov.u32    %r14, %r9;
    @!%p1 ld.param.u32 %r13, [p_koff];
    @!%p1 sub.u32   %r14, %r9, %r5;
    mad.lo.u32      %r13, %r14, %r11, %r13; // head column
    @%p1 ld.param.u64 %rd0, [p_qw];
    @!%p1 ld.param.u64 %rd0, [p_kw];
    shr.u32         %r15, %r12, 5;          // values per lane: 2 or 4
    mul.lo.u32      %r16, %r1, %r15;        // first dim of this lane
    ld.param.u32    %r17, [p_ld];
    mad.lo.u32      %r18, %r8, %r17, %r13;
    add.u32         %r18, %r18, %r16;
    mul.wide.u32    %rd1, %r18, 2;
    ld.param.u64    %rd2, [p_x];
    add.s64         %rd2, %rd2, %rd1;       // this lane's values
    setp.eq.u32     %p2, %r15, 4;
    mov.f32         %f2, 0f00000000;
    mov.f32         %f3, 0f00000000;
    @%p2 bra        LOAD4;
    ld.global.b32   %r19, [%rd2];
    mov.b32         {%h0, %h1}, %r19;
    bra.uni         LOADED;
LOAD4:
    ld.global.v2.b32 {%r19, %r20}, [%rd2];
    mov.b32         {%h0, %h1}, %r19;
    mov.b32         {%h2, %h3}, %r20;
    cvt.f32.f16     %f2, %h2;
    cvt.f32.f16     %f3, %h3;
LOADED:
    cvt.f32.f16     %f0, %h0;
    cvt.f32.f16     %f1, %h1;
    // RMS over the head
    mul.f32         %f4, %f0, %f0;
    fma.rn.f32      %f4, %f1, %f1, %f4;
    fma.rn.f32      %f4, %f2, %f2, %f4;
    fma.rn.f32      %f4, %f3, %f3, %f4;
    shfl.sync.bfly.b32 %f5, %f4, 16, 31, 0xffffffff;
    add.f32         %f4, %f4, %f5;
    shfl.sync.bfly.b32 %f5, %f4, 8, 31, 0xffffffff;
    add.f32         %f4, %f4, %f5;
    shfl.sync.bfly.b32 %f5, %f4, 4, 31, 0xffffffff;
    add.f32         %f4, %f4, %f5;
    shfl.sync.bfly.b32 %f5, %f4, 2, 31, 0xffffffff;
    add.f32         %f4, %f4, %f5;
    shfl.sync.bfly.b32 %f5, %f4, 1, 31, 0xffffffff;
    add.f32         %f4, %f4, %f5;
    cvt.rn.f32.u32  %f5, %r12;
    div.rn.f32      %f4, %f4, %f5;
    ld.param.f32    %f5, [p_eps];
    add.f32         %f4, %f4, %f5;
    sqrt.rn.f32     %f4, %f4;
    rcp.rn.f32      %f4, %f4;
    mul.f32         %f0, %f0, %f4;
    mul.f32         %f1, %f1, %f4;
    mul.f32         %f2, %f2, %f4;
    mul.f32         %f3, %f3, %f4;
    setp.eq.u64     %p3, %rd0, 0;
    @%p3 bra        ROPE;
    mul.wide.u32    %rd3, %r16, 4;
    add.s64         %rd3, %rd0, %rd3;
    ld.global.nc.v2.f32 {%f6, %f7}, [%rd3];
    mul.f32         %f0, %f0, %f6;
    mul.f32         %f1, %f1, %f7;
    @!%p2 bra       ROPE;
    ld.global.nc.v2.f32 {%f6, %f7}, [%rd3+8];
    mul.f32         %f2, %f2, %f6;
    mul.f32         %f3, %f3, %f7;
ROPE:
    // partner values: every lane takes part in the shuffles
    ld.param.u64    %rd4, [p_cs];
    ld.param.u32    %r21, [p_rot];
    shr.u32         %r22, %r21, 1;          // half
    div.u32         %r23, %r22, %r15;       // lane distance
    setp.lt.u32     %p4, %r16, %r22;        // first half
    add.u32         %r24, %r1, %r23;
    sub.u32         %r25, %r1, %r23;
    selp.u32        %r24, %r24, %r25, %p4;
    setp.lt.u32     %p5, %r16, %r21;        // rotated dims
    setp.ne.u64     %p6, %rd4, 0;
    and.pred        %p5, %p5, %p6;
    selp.u32        %r24, %r24, %r1, %p5;
    and.b32         %r24, %r24, 31;
    shfl.sync.idx.b32 %f8, %f0, %r24, 31, 0xffffffff;
    shfl.sync.idx.b32 %f9, %f1, %r24, 31, 0xffffffff;
    shfl.sync.idx.b32 %f10, %f2, %r24, 31, 0xffffffff;
    shfl.sync.idx.b32 %f11, %f3, %r24, 31, 0xffffffff;
    @!%p5 bra       STORE;
    // angle index a = i mod half for this lane's first dim
    rem.u32         %r26, %r16, %r22;
    mad.lo.u32      %r27, %r8, %r22, %r26;
    mul.wide.u32    %rd5, %r27, 8;
    add.s64         %rd5, %rd4, %rd5;
    ld.global.nc.v4.f32 {%f12, %f13, %f14, %f15}, [%rd5];   // (c, s) of a, a + 1
    @%p4 bra        FIRST;
    // second half: x' = p s + x c
    mul.f32         %f20, %f8, %f13;
    fma.rn.f32      %f0, %f0, %f12, %f20;
    mul.f32         %f20, %f9, %f15;
    fma.rn.f32      %f1, %f1, %f14, %f20;
    @!%p2 bra       STORE;
    ld.global.nc.v4.f32 {%f12, %f13, %f14, %f15}, [%rd5+16];
    mul.f32         %f20, %f10, %f13;
    fma.rn.f32      %f2, %f2, %f12, %f20;
    mul.f32         %f20, %f11, %f15;
    fma.rn.f32      %f3, %f3, %f14, %f20;
    bra.uni         STORE;
FIRST:
    // first half: x' = x c - p s
    mul.f32         %f20, %f8, %f13;
    mul.f32         %f21, %f0, %f12;
    sub.f32         %f0, %f21, %f20;
    mul.f32         %f20, %f9, %f15;
    mul.f32         %f21, %f1, %f14;
    sub.f32         %f1, %f21, %f20;
    @!%p2 bra       STORE;
    ld.global.nc.v4.f32 {%f12, %f13, %f14, %f15}, [%rd5+16];
    mul.f32         %f20, %f10, %f13;
    mul.f32         %f21, %f2, %f12;
    sub.f32         %f2, %f21, %f20;
    mul.f32         %f20, %f11, %f15;
    mul.f32         %f21, %f3, %f14;
    sub.f32         %f3, %f21, %f20;
STORE:
    cvt.rn.f16x2.f32 %r28, %f1, %f0;
    @%p2 bra        STORE4;
    st.global.b32   [%rd2], %r28;
    bra.uni         DONE;
STORE4:
    cvt.rn.f16x2.f32 %r29, %f3, %f2;
    st.global.v2.b32 [%rd2], {%r28, %r29};
DONE:
    ret;
}

// -----------------------------------------------------------------------------
// Kernel: swiglu   out[r][j] = silu(a) * b * so with a = in[r][j] * si,
//   b = in[r][F + j] * si (gate half first, then the up half, as ggml_swiglu
//   splits one projection). si and so undo / apply the 1/128 scaling that
//   keeps f16 activations in range. One thread per output pair, grid-stride.
// -----------------------------------------------------------------------------
.visible .entry swiglu(
    .param .u64 p_in,           // f16 [rows][ldi]
    .param .u32 p_ldi,
    .param .u64 p_out,          // f16 [rows][ldo] (out)
    .param .u32 p_ldo,
    .param .u32 p_rows,
    .param .u32 p_f,            // F (even)
    .param .f32 p_si,
    .param .f32 p_so
)
{
    .reg .pred  %p<2>;
    .reg .b32   %r<24>;
    .reg .b64   %rd<8>;
    .reg .f32   %f<16>;
    .reg .b16   %h<4>;

    ld.param.u32    %r0, [p_rows];
    ld.param.u32    %r1, [p_f];
    shr.u32         %r2, %r1, 1;            // pairs per row
    mul.lo.u32      %r3, %r0, %r2;          // total
    ld.param.u32    %r4, [p_ldi];
    ld.param.u32    %r5, [p_ldo];
    ld.param.u64    %rd0, [p_in];
    ld.param.u64    %rd1, [p_out];
    ld.param.f32    %f14, [p_si];
    ld.param.f32    %f15, [p_so];
    mov.u32         %r6, %ctaid.x;
    mov.u32         %r7, %ntid.x;
    mov.u32         %r8, %tid.x;
    mad.lo.u32      %r9, %r6, %r7, %r8;
    mov.u32         %r10, %nctaid.x;
    mul.lo.u32      %r10, %r10, %r7;
LOOP:
    setp.ge.u32     %p0, %r9, %r3;
    @%p0 bra        DONE;
    div.u32         %r11, %r9, %r2;         // row
    rem.u32         %r12, %r9, %r2;
    shl.b32         %r12, %r12, 1;          // column j
    mad.lo.u32      %r13, %r11, %r4, %r12;
    mul.wide.u32    %rd2, %r13, 2;
    add.s64         %rd2, %rd0, %rd2;
    ld.global.nc.b32 %r14, [%rd2];          // a pair
    mul.wide.u32    %rd3, %r1, 2;
    add.s64         %rd3, %rd2, %rd3;
    ld.global.nc.b32 %r15, [%rd3];          // b pair
    mov.b32         {%h0, %h1}, %r14;
    mov.b32         {%h2, %h3}, %r15;
    cvt.f32.f16     %f0, %h0;
    cvt.f32.f16     %f1, %h1;
    cvt.f32.f16     %f2, %h2;
    cvt.f32.f16     %f3, %h3;
    mul.f32         %f0, %f0, %f14;
    mul.f32         %f1, %f1, %f14;
    mul.f32         %f2, %f2, %f14;
    mul.f32         %f3, %f3, %f14;
    // silu(a) = a / (1 + e^-a)
    mul.f32         %f4, %f0, 0fBFB8AA3B;
    ex2.approx.ftz.f32 %f4, %f4;
    add.f32         %f4, %f4, 0f3F800000;
    div.rn.f32      %f4, %f0, %f4;
    mul.f32         %f5, %f1, 0fBFB8AA3B;
    ex2.approx.ftz.f32 %f5, %f5;
    add.f32         %f5, %f5, 0f3F800000;
    div.rn.f32      %f5, %f1, %f5;
    mul.f32         %f4, %f4, %f2;
    mul.f32         %f5, %f5, %f3;
    mul.f32         %f4, %f4, %f15;
    mul.f32         %f5, %f5, %f15;
    cvt.rn.f16x2.f32 %r16, %f5, %f4;
    mad.lo.u32      %r17, %r11, %r5, %r12;
    mul.wide.u32    %rd4, %r17, 2;
    add.s64         %rd4, %rd1, %rd4;
    st.global.b32   [%rd4], %r16;
    add.u32         %r9, %r9, %r10;
    bra.uni         LOOP;
DONE:
    ret;
}

// -----------------------------------------------------------------------------
// Kernel: adaln   the AdaLN modulation vectors of every block for every
//   timestep in the sequence: out[(l R + r) J + j] = b[l J + j] +
//   sum_i W[l J + j][i] * temb[r][i] (8 inputs: the interpolated row of the
//   adaln_t_table curve). W and b f16, all blocks back to back. Block l's
//   rows are [timestep r][modality m][6][hidden] (shift, scale, gate of
//   attention, then of the MLP), so (r, m) is one row of 6 * hidden values.
//   One thread per (l, j), grid-stride.
// -----------------------------------------------------------------------------
.visible .entry adaln(
    .param .u64 p_w,            // f16 [L][J][8]
    .param .u64 p_b,            // f16 [L][J]
    .param .u64 p_t,            // f32 [R][8]
    .param .u64 p_out,          // f32 [L][R][J] (out)
    .param .u32 p_j,
    .param .u32 p_l,
    .param .u32 p_r
)
{
    .reg .pred  %p<3>;
    .reg .b32   %r<24>;
    .reg .b64   %rd<10>;
    .reg .f32   %f<24>;
    .reg .b16   %h<10>;

    ld.param.u32    %r0, [p_j];
    ld.param.u32    %r1, [p_l];
    ld.param.u32    %r2, [p_r];
    mul.lo.u32      %r3, %r0, %r1;          // total
    ld.param.u64    %rd0, [p_w];
    ld.param.u64    %rd1, [p_b];
    ld.param.u64    %rd2, [p_t];
    ld.param.u64    %rd3, [p_out];
    mov.u32         %r4, %ctaid.x;
    mov.u32         %r5, %ntid.x;
    mov.u32         %r6, %tid.x;
    mad.lo.u32      %r7, %r4, %r5, %r6;
    mov.u32         %r8, %nctaid.x;
    mul.lo.u32      %r8, %r8, %r5;
LOOP:
    setp.ge.u32     %p0, %r7, %r3;
    @%p0 bra        DONE;
    mul.wide.u32    %rd4, %r7, 16;
    add.s64         %rd4, %rd0, %rd4;
    ld.global.nc.v4.b32 {%r9, %r10, %r11, %r12}, [%rd4];
    mov.b32         {%h0, %h1}, %r9;
    mov.b32         {%h2, %h3}, %r10;
    mov.b32         {%h4, %h5}, %r11;
    mov.b32         {%h6, %h7}, %r12;
    cvt.f32.f16     %f0, %h0;
    cvt.f32.f16     %f1, %h1;
    cvt.f32.f16     %f2, %h2;
    cvt.f32.f16     %f3, %h3;
    cvt.f32.f16     %f4, %h4;
    cvt.f32.f16     %f5, %h5;
    cvt.f32.f16     %f6, %h6;
    cvt.f32.f16     %f7, %h7;
    mul.wide.u32    %rd5, %r7, 2;
    add.s64         %rd5, %rd1, %rd5;
    ld.global.nc.b16 %h8, [%rd5];
    cvt.f32.f16     %f8, %h8;               // bias
    div.u32         %r13, %r7, %r0;         // block l
    rem.u32         %r14, %r7, %r0;         // j
    mul.lo.u32      %r15, %r13, %r2;        // l R
    mov.u32         %r16, 0;                // r
    mov.u64         %rd6, %rd2;
ROW:
    ld.global.nc.v4.f32 {%f10, %f11, %f12, %f13}, [%rd6];
    ld.global.nc.v4.f32 {%f14, %f15, %f16, %f17}, [%rd6+16];
    mul.f32         %f9, %f0, %f10;
    fma.rn.f32      %f9, %f1, %f11, %f9;
    fma.rn.f32      %f9, %f2, %f12, %f9;
    fma.rn.f32      %f9, %f3, %f13, %f9;
    fma.rn.f32      %f9, %f4, %f14, %f9;
    fma.rn.f32      %f9, %f5, %f15, %f9;
    fma.rn.f32      %f9, %f6, %f16, %f9;
    fma.rn.f32      %f9, %f7, %f17, %f9;
    add.f32         %f9, %f9, %f8;
    add.u32         %r17, %r15, %r16;
    mad.lo.u32      %r17, %r17, %r0, %r14;
    mul.wide.u32    %rd7, %r17, 4;
    add.s64         %rd7, %rd3, %rd7;
    st.global.f32   [%rd7], %f9;
    add.s64         %rd6, %rd6, 32;
    add.u32         %r16, %r16, 1;
    setp.lt.u32     %p1, %r16, %r2;
    @%p1 bra        ROW;
    add.u32         %r7, %r7, %r8;
    bra.uni         LOOP;
DONE:
    ret;
}

// -----------------------------------------------------------------------------
// Kernel: linear_f32   y[m][n] (=, or += with acc) b[n] + sum_k x[m][k] w[n][k]
//   in f32, for the small projections kept in full precision (patch
//   embeddings, the final video / audio heads, the VAE's x_embedder).
//   One warp per output: lanes stride over k, then a butterfly sum; 8
//   outputs per 256-thread block.
// -----------------------------------------------------------------------------
.visible .entry linear_f32(
    .param .u64 p_x,            // f32 [M][ldx]
    .param .u32 p_ldx,
    .param .u64 p_w,            // f32 [N][K]
    .param .u64 p_b,            // f32 [N] or 0
    .param .u64 p_y,            // f32 [M][ldy] (out)
    .param .u32 p_ldy,
    .param .u32 p_m,
    .param .u32 p_n,
    .param .u32 p_k,
    .param .u32 p_acc
)
{
    .reg .pred  %p<4>;
    .reg .b32   %r<20>;
    .reg .b64   %rd<10>;
    .reg .f32   %f<8>;

    mov.u32         %r0, %tid.x;
    and.b32         %r1, %r0, 31;
    shr.u32         %r2, %r0, 5;
    mov.u32         %r3, %ctaid.x;
    shl.b32         %r3, %r3, 3;
    add.u32         %r3, %r3, %r2;          // output index
    ld.param.u32    %r4, [p_m];
    ld.param.u32    %r5, [p_n];
    mul.lo.u32      %r6, %r4, %r5;
    setp.ge.u32     %p0, %r3, %r6;
    @%p0 bra        DONE;
    div.u32         %r7, %r3, %r5;          // m
    rem.u32         %r8, %r3, %r5;          // n
    ld.param.u32    %r9, [p_k];
    ld.param.u32    %r10, [p_ldx];
    mul.lo.u32      %r11, %r7, %r10;
    mul.wide.u32    %rd0, %r11, 4;
    ld.param.u64    %rd1, [p_x];
    add.s64         %rd1, %rd1, %rd0;
    mul.lo.u32      %r12, %r8, %r9;
    mul.wide.u32    %rd2, %r12, 4;
    ld.param.u64    %rd3, [p_w];
    add.s64         %rd3, %rd3, %rd2;
    mov.f32         %f0, 0f00000000;
    mov.u32         %r13, %r1;
KL:
    setp.ge.u32     %p1, %r13, %r9;
    @%p1 bra        RED;
    mul.wide.u32    %rd4, %r13, 4;
    add.s64         %rd5, %rd1, %rd4;
    ld.global.nc.f32 %f1, [%rd5];
    add.s64         %rd6, %rd3, %rd4;
    ld.global.nc.f32 %f2, [%rd6];
    fma.rn.f32      %f0, %f1, %f2, %f0;
    add.u32         %r13, %r13, 32;
    bra.uni         KL;
RED:
    shfl.sync.bfly.b32 %f1, %f0, 16, 31, 0xffffffff;
    add.f32         %f0, %f0, %f1;
    shfl.sync.bfly.b32 %f1, %f0, 8, 31, 0xffffffff;
    add.f32         %f0, %f0, %f1;
    shfl.sync.bfly.b32 %f1, %f0, 4, 31, 0xffffffff;
    add.f32         %f0, %f0, %f1;
    shfl.sync.bfly.b32 %f1, %f0, 2, 31, 0xffffffff;
    add.f32         %f0, %f0, %f1;
    shfl.sync.bfly.b32 %f1, %f0, 1, 31, 0xffffffff;
    add.f32         %f0, %f0, %f1;
    setp.ne.u32     %p2, %r1, 0;
    @%p2 bra        DONE;
    ld.param.u64    %rd7, [p_b];
    setp.eq.u64     %p3, %rd7, 0;
    @%p3 bra        NOB;
    mul.wide.u32    %rd8, %r8, 4;
    add.s64         %rd8, %rd7, %rd8;
    ld.global.nc.f32 %f1, [%rd8];
    add.f32         %f0, %f0, %f1;
NOB:
    ld.param.u32    %r14, [p_ldy];
    mad.lo.u32      %r15, %r7, %r14, %r8;
    mul.wide.u32    %rd9, %r15, 4;
    ld.param.u64    %rd7, [p_y];
    add.s64         %rd9, %rd7, %rd9;
    ld.param.u32    %r16, [p_acc];
    setp.eq.u32     %p3, %r16, 0;
    @%p3 bra        STORE;
    ld.global.f32   %f1, [%rd9];
    add.f32         %f0, %f0, %f1;
STORE:
    st.global.f32   [%rd9], %f0;
DONE:
    ret;
}

// -----------------------------------------------------------------------------
// Kernel: cast_f16   y = x * s as f16 (an f32 matrix [rows][ldx] -> f16
//   [rows][ldy], the first cols columns; cols even). Grid-stride over pairs.
// -----------------------------------------------------------------------------
.visible .entry cast_f16(
    .param .u64 p_x,            // f32
    .param .u32 p_ldx,
    .param .u64 p_y,            // f16 (out)
    .param .u32 p_ldy,
    .param .u32 p_rows,
    .param .u32 p_cols,
    .param .f32 p_s
)
{
    .reg .pred  %p<2>;
    .reg .b32   %r<20>;
    .reg .b64   %rd<6>;
    .reg .f32   %f<4>;

    ld.param.u32    %r0, [p_rows];
    ld.param.u32    %r1, [p_cols];
    shr.u32         %r2, %r1, 1;
    mul.lo.u32      %r3, %r0, %r2;
    ld.param.u32    %r4, [p_ldx];
    ld.param.u32    %r5, [p_ldy];
    ld.param.u64    %rd0, [p_x];
    ld.param.u64    %rd1, [p_y];
    ld.param.f32    %f2, [p_s];
    mov.u32         %r6, %ctaid.x;
    mov.u32         %r7, %ntid.x;
    mov.u32         %r8, %tid.x;
    mad.lo.u32      %r9, %r6, %r7, %r8;
    mov.u32         %r10, %nctaid.x;
    mul.lo.u32      %r10, %r10, %r7;
LOOP:
    setp.ge.u32     %p0, %r9, %r3;
    @%p0 bra        DONE;
    div.u32         %r11, %r9, %r2;
    rem.u32         %r12, %r9, %r2;
    shl.b32         %r12, %r12, 1;
    mad.lo.u32      %r13, %r11, %r4, %r12;
    mul.wide.u32    %rd2, %r13, 4;
    add.s64         %rd2, %rd0, %rd2;
    ld.global.nc.v2.f32 {%f0, %f1}, [%rd2];
    mul.f32         %f0, %f0, %f2;
    mul.f32         %f1, %f1, %f2;
    cvt.rn.f16x2.f32 %r14, %f1, %f0;
    mad.lo.u32      %r15, %r11, %r5, %r12;
    mul.wide.u32    %rd3, %r15, 2;
    add.s64         %rd3, %rd1, %rd3;
    st.global.b32   [%rd3], %r14;
    add.u32         %r9, %r9, %r10;
    bra.uni         LOOP;
DONE:
    ret;
}

// -----------------------------------------------------------------------------
// Kernel: axpby   y = a * y + b * x (f32, n values). Grid-stride.
// -----------------------------------------------------------------------------
.visible .entry axpby(
    .param .u64 p_y,
    .param .u64 p_x,
    .param .f32 p_a,
    .param .f32 p_b,
    .param .u32 p_n
)
{
    .reg .pred  %p<2>;
    .reg .b32   %r<12>;
    .reg .b64   %rd<6>;
    .reg .f32   %f<6>;

    ld.param.u32    %r0, [p_n];
    ld.param.u64    %rd0, [p_y];
    ld.param.u64    %rd1, [p_x];
    ld.param.f32    %f0, [p_a];
    ld.param.f32    %f1, [p_b];
    mov.u32         %r1, %ctaid.x;
    mov.u32         %r2, %ntid.x;
    mov.u32         %r3, %tid.x;
    mad.lo.u32      %r4, %r1, %r2, %r3;
    mov.u32         %r5, %nctaid.x;
    mul.lo.u32      %r5, %r5, %r2;
LOOP:
    setp.ge.u32     %p0, %r4, %r0;
    @%p0 bra        DONE;
    mul.wide.u32    %rd2, %r4, 4;
    add.s64         %rd3, %rd0, %rd2;
    add.s64         %rd4, %rd1, %rd2;
    ld.global.f32   %f2, [%rd3];
    ld.global.nc.f32 %f3, [%rd4];
    mul.f32         %f2, %f2, %f0;
    fma.rn.f32      %f2, %f3, %f1, %f2;
    st.global.f32   [%rd3], %f2;
    add.u32         %r4, %r4, %r5;
    bra.uni         LOOP;
DONE:
    ret;
}

// -----------------------------------------------------------------------------
// Kernel: im2col1d   the A matrix of a 1-D convolution as a GEMM:
//   dst[t][ci K + k] = src[t - pad + k dil][ci] (0 outside [0, L)), f16,
//   columns cin K .. kpad zero. src f32 [L][lds] (time-major, channel
//   columns), stride 1 (L outputs). One thread per dst element, grid-stride.
// -----------------------------------------------------------------------------
.visible .entry im2col1d(
    .param .u64 p_src,          // f32 [L][lds]
    .param .u32 p_lds,
    .param .u64 p_dst,          // f16 [L][kpad] (out)
    .param .u32 p_l,
    .param .u32 p_cin,
    .param .u32 p_k,
    .param .u32 p_dil,
    .param .u32 p_pad,
    .param .u32 p_kpad
)
{
    .reg .pred  %p<4>;
    .reg .b32   %r<24>;
    .reg .b64   %rd<6>;
    .reg .f32   %f<2>;
    .reg .b16   %h;

    ld.param.u32    %r0, [p_l];
    ld.param.u32    %r1, [p_kpad];
    mul.lo.u32      %r2, %r0, %r1;          // total
    ld.param.u32    %r3, [p_cin];
    ld.param.u32    %r4, [p_k];
    mul.lo.u32      %r5, %r3, %r4;          // real columns
    ld.param.u32    %r6, [p_dil];
    ld.param.u32    %r7, [p_pad];
    ld.param.u32    %r8, [p_lds];
    ld.param.u64    %rd0, [p_src];
    ld.param.u64    %rd1, [p_dst];
    mov.u32         %r9, %ctaid.x;
    mov.u32         %r10, %ntid.x;
    mov.u32         %r11, %tid.x;
    mad.lo.u32      %r12, %r9, %r10, %r11;
    mov.u32         %r13, %nctaid.x;
    mul.lo.u32      %r13, %r13, %r10;
LOOP:
    setp.ge.u32     %p0, %r12, %r2;
    @%p0 bra        DONE;
    div.u32         %r14, %r12, %r1;        // t
    rem.u32         %r15, %r12, %r1;        // column
    mov.f32         %f0, 0f00000000;
    setp.ge.u32     %p1, %r15, %r5;
    @%p1 bra        STORE;
    div.u32         %r16, %r15, %r4;        // ci
    rem.u32         %r17, %r15, %r4;        // k
    mad.lo.u32      %r18, %r17, %r6, %r14;
    sub.s32         %r18, %r18, %r7;        // source time
    setp.lt.s32     %p2, %r18, 0;
    setp.ge.s32     %p3, %r18, %r0;
    or.pred         %p2, %p2, %p3;
    @%p2 bra        STORE;
    mad.lo.u32      %r19, %r18, %r8, %r16;
    mul.wide.u32    %rd2, %r19, 4;
    add.s64         %rd2, %rd0, %rd2;
    ld.global.nc.f32 %f0, [%rd2];
STORE:
    cvt.rn.f16.f32  %h, %f0;
    mul.wide.u32    %rd3, %r12, 2;
    add.s64         %rd3, %rd1, %rd3;
    st.global.b16   [%rd3], %h;
    add.u32         %r12, %r12, %r13;
    bra.uni         LOOP;
DONE:
    ret;
}

// -----------------------------------------------------------------------------
// Kernel: col2im_t   the scatter half of a transposed 1-D convolution done as
//   a GEMM: z[s][co K + k] = sum_ci x[s][ci] w[ci][co][k]; then
//   y[t][co] = b[co] + sum over (s, k) with s r + k - pad = t of z[s][co K + k]
//   (stride r, output length (Lin - 1) r + K - 2 pad). One thread per
//   (t, co), grid-stride.
// -----------------------------------------------------------------------------
.visible .entry col2im_t(
    .param .u64 p_z,            // f32 [Lin][ldz]
    .param .u32 p_ldz,
    .param .u64 p_b,            // f32 [Cout]
    .param .u64 p_y,            // f32 [Lout][ldy] (out)
    .param .u32 p_ldy,
    .param .u32 p_lin,
    .param .u32 p_lout,
    .param .u32 p_cout,
    .param .u32 p_k,
    .param .u32 p_r,
    .param .u32 p_pad
)
{
    .reg .pred  %p<4>;
    .reg .b32   %r<28>;
    .reg .b64   %rd<6>;
    .reg .f32   %f<4>;

    ld.param.u32    %r0, [p_lout];
    ld.param.u32    %r1, [p_cout];
    mul.lo.u32      %r2, %r0, %r1;
    ld.param.u32    %r3, [p_k];
    ld.param.u32    %r4, [p_r];
    ld.param.u32    %r5, [p_pad];
    ld.param.u32    %r6, [p_lin];
    ld.param.u32    %r7, [p_ldz];
    ld.param.u32    %r8, [p_ldy];
    ld.param.u64    %rd0, [p_z];
    ld.param.u64    %rd1, [p_b];
    ld.param.u64    %rd2, [p_y];
    mov.u32         %r9, %ctaid.x;
    mov.u32         %r10, %ntid.x;
    mov.u32         %r11, %tid.x;
    mad.lo.u32      %r12, %r9, %r10, %r11;
    mov.u32         %r13, %nctaid.x;
    mul.lo.u32      %r13, %r13, %r10;
LOOP:
    setp.ge.u32     %p0, %r12, %r2;
    @%p0 bra        DONE;
    div.u32         %r14, %r12, %r1;        // t
    rem.u32         %r15, %r12, %r1;        // co
    mul.wide.u32    %rd3, %r15, 4;
    add.s64         %rd3, %rd1, %rd3;
    ld.global.nc.f32 %f0, [%rd3];
    add.u32         %r16, %r14, %r5;        // t + pad = s r + k
    mul.lo.u32      %r17, %r15, %r3;        // co K
    mov.u32         %r18, 0;                // k
KL:
    setp.ge.u32     %p1, %r18, %r3;
    @%p1 bra        STORE;
    setp.lt.u32     %p2, %r16, %r18;
    @%p2 bra        STORE;                  // k only grows
    sub.u32         %r19, %r16, %r18;
    rem.u32         %r20, %r19, %r4;
    setp.ne.u32     %p2, %r20, 0;
    @%p2 bra        KN;
    div.u32         %r21, %r19, %r4;        // s
    setp.ge.u32     %p3, %r21, %r6;
    @%p3 bra        KN;
    mad.lo.u32      %r22, %r21, %r7, %r17;
    add.u32         %r22, %r22, %r18;
    mul.wide.u32    %rd4, %r22, 4;
    add.s64         %rd4, %rd0, %rd4;
    ld.global.nc.f32 %f1, [%rd4];
    add.f32         %f0, %f0, %f1;
KN:
    add.u32         %r18, %r18, 1;
    bra.uni         KL;
STORE:
    mad.lo.u32      %r23, %r14, %r8, %r15;
    mul.wide.u32    %rd5, %r23, 4;
    add.s64         %rd5, %rd2, %rd5;
    st.global.f32   [%rd5], %f0;
    add.u32         %r12, %r12, %r13;
    bra.uni         LOOP;
DONE:
    ret;
}

// -----------------------------------------------------------------------------
// Kernel: aa_snake   BigVGAN's anti-aliased SnakeBeta activation, per channel
//   (time-major f32 [L][ld], C channels):
//     1. upsample x2: replicate-pad x by 5, transposed conv (stride 2) with
//        the 12-tap filter up, keep samples 15 .. 15 + 2L:
//          u[n] = sum_i x[clamp(i - 5)] up[n + 15 - 2 i]
//     2. snake: u + sin(u e^alpha)^2 / (e^beta + 1e-9)
//     3. downsample x2: replicate-pad u by 5 / 6, 12-tap filter dn, stride 2:
//          y[t] = sum_j dn[j] u[clamp(2 t + j - 5)]
//   so each output needs 12 upsampled samples of 6 taps each. One thread per
//   (t, c), grid-stride.
// -----------------------------------------------------------------------------
.visible .entry aa_snake(
    .param .u64 p_x,            // f32 [L][ld]
    .param .u64 p_y,            // f32 [L][ld] (out)
    .param .u32 p_ld,
    .param .u32 p_l,
    .param .u32 p_c,
    .param .u64 p_alpha,        // f32 [C] (log scale)
    .param .u64 p_beta,         // f32 [C] (log scale)
    .param .u64 p_up,           // f32 [12]
    .param .u64 p_dn            // f32 [12]
)
{
    .reg .pred  %p<6>;
    .reg .b32   %r<32>;
    .reg .b64   %rd<10>;
    .reg .f32   %f<16>;

    ld.param.u32    %r0, [p_l];
    ld.param.u32    %r1, [p_c];
    mul.lo.u32      %r2, %r0, %r1;
    ld.param.u32    %r3, [p_ld];
    ld.param.u64    %rd0, [p_x];
    ld.param.u64    %rd1, [p_y];
    ld.param.u64    %rd2, [p_alpha];
    ld.param.u64    %rd3, [p_beta];
    ld.param.u64    %rd4, [p_up];
    ld.param.u64    %rd5, [p_dn];
    shl.b32         %r4, %r0, 1;            // 2L upsampled samples
    sub.u32         %r5, %r4, 1;
    sub.u32         %r6, %r0, 1;
    mov.u32         %r7, %ctaid.x;
    mov.u32         %r8, %ntid.x;
    mov.u32         %r9, %tid.x;
    mad.lo.u32      %r10, %r7, %r8, %r9;
    mov.u32         %r11, %nctaid.x;
    mul.lo.u32      %r11, %r11, %r8;
LOOP:
    setp.ge.u32     %p0, %r10, %r2;
    @%p0 bra        DONE;
    div.u32         %r12, %r10, %r1;        // t
    rem.u32         %r13, %r10, %r1;        // c
    mul.wide.u32    %rd6, %r13, 4;
    add.s64         %rd7, %rd2, %rd6;
    ld.global.nc.f32 %f0, [%rd7];
    mul.f32         %f0, %f0, 0f3FB8AA3B;
    ex2.approx.f32  %f0, %f0;               // e^alpha
    add.s64         %rd7, %rd3, %rd6;
    ld.global.nc.f32 %f1, [%rd7];
    mul.f32         %f1, %f1, 0f3FB8AA3B;
    ex2.approx.f32  %f1, %f1;
    add.f32         %f1, %f1, 0f3089705F;   // e^beta + 1e-9
    rcp.rn.f32      %f1, %f1;
    mov.f32         %f2, 0f00000000;        // y
    mov.u32         %r14, 0;                // j
JL:
    // u index m = clamp(2 t + j - 5, 0, 2L - 1)
    shl.b32         %r15, %r12, 1;
    add.u32         %r15, %r15, %r14;
    sub.s32         %r15, %r15, 5;
    max.s32         %r15, %r15, 0;
    min.s32         %r15, %r15, %r5;
    // u[m] = sum over i with k = m + 15 - 2 i in [0, 12) of x[clamp(i - 5)] up[k]
    add.u32         %r16, %r15, 15;         // m + 15
    mov.f32         %f3, 0f00000000;
    and.b32         %r17, %r16, 1;          // k parity
    mov.u32         %r18, %r17;             // k
KL:
    sub.u32         %r19, %r16, %r18;
    shr.u32         %r19, %r19, 1;          // i
    sub.s32         %r20, %r19, 5;
    max.s32         %r20, %r20, 0;
    min.s32         %r20, %r20, %r6;        // source sample
    mad.lo.u32      %r21, %r20, %r3, %r13;
    mul.wide.u32    %rd8, %r21, 4;
    add.s64         %rd8, %rd0, %rd8;
    ld.global.nc.f32 %f4, [%rd8];
    mul.wide.u32    %rd9, %r18, 4;
    add.s64         %rd9, %rd4, %rd9;
    ld.global.nc.f32 %f5, [%rd9];
    fma.rn.f32      %f3, %f4, %f5, %f3;
    add.u32         %r18, %r18, 2;
    setp.lt.u32     %p1, %r18, 12;
    @%p1 bra        KL;
    // snake; sin.approx is only accurate on [-pi, pi]: reduce by 2 pi first
    mul.f32         %f6, %f3, %f0;
    mul.f32         %f8, %f6, 0f3E22F983;   // / (2 pi)
    cvt.rni.f32.f32 %f8, %f8;
    fma.rn.f32      %f6, %f8, 0fC0C90000, %f6;   // - k 6.28125
    fma.rn.f32      %f6, %f8, 0fBAFDAA22, %f6;   // - k 0.0019353072
    sin.approx.f32  %f6, %f6;
    mul.f32         %f6, %f6, %f6;
    fma.rn.f32      %f3, %f6, %f1, %f3;
    mul.wide.u32    %rd9, %r14, 4;
    add.s64         %rd9, %rd5, %rd9;
    ld.global.nc.f32 %f7, [%rd9];
    fma.rn.f32      %f2, %f7, %f3, %f2;
    add.u32         %r14, %r14, 1;
    setp.lt.u32     %p2, %r14, 12;
    @%p2 bra        JL;
    mad.lo.u32      %r22, %r12, %r3, %r13;
    mul.wide.u32    %rd8, %r22, 4;
    add.s64         %rd8, %rd1, %rd8;
    st.global.f32   [%rd8], %f2;
    add.u32         %r10, %r10, %r11;
    bra.uni         LOOP;
DONE:
    ret;
}

// -----------------------------------------------------------------------------
// Kernel: gemm_f16   C[M][N] = A[M][K] . B[N][K]^T + bias, with an epilogue
//   A: f16 activations [M][K] (rows readable up to M rounded up to 128),
//   B: f16 weights [N][K] (a PyTorch Linear weight as stored), bias f32 [N]
//   or 0. Needs N % 128 == 0 and K % 32 == 0.
//   Block tile 128 x 128, k-tile 32; 256 threads = 8 warps as 2 (rows) x 4
//   (cols), each warp 64 x 32 = 4 x 4 mma.m16n8k16 tiles (f16 in, f32 acc).
//   Tiles go global -> shared with cp.async in a 3-stage ring (two k-tiles in
//   flight while one is computed) and shared -> registers with ldmatrix.
//   Shared rows are 64 bytes (4 chunks of 8 halves); chunk c of row r is
//   stored at chunk c ^ ((r >> 1) & 3) so that the 8 row addresses of every
//   ldmatrix phase hit 8 different 16-byte bank groups.
//   mode (the epilogue, per pair of adjacent outputs v = acc * alpha + bias;
//   alpha undoes an input scaled to keep f16 in range, or scales the output):
//     0  C f32 = v           1  C f16 = v            4  C f32 += v
//     5  C f32 += v * gate[s][col], s = seg[row] (seg u8 [M], or s = 0 when
//        seg is 0): the gated residual of an AdaLN block, where every row
//        uses the gate of its segment (text, audio or video tokens)
//   grid (N / 128, ceil(M / 128)), block 256. C row stride ldc, gate row
//   stride gld (elements).
// -----------------------------------------------------------------------------
.visible .entry gemm_f16(
    .param .u64 p_a,            // f16 [M][K]
    .param .u64 p_b,            // f16 [N][K]
    .param .u64 p_bias,         // f32 [N] or 0
    .param .u64 p_c,            // f32 or f16 [M][ldc] (out)
    .param .u32 p_m,
    .param .u32 p_n,
    .param .u32 p_k,
    .param .u32 p_ldc,
    .param .u32 p_mode,
    .param .u64 p_gate,         // f32 [S][gld] (mode 5)
    .param .u64 p_seg,          // u8 [M] or 0 (mode 5)
    .param .u32 p_gld,
    .param .f32 p_alpha
)
.maxntid 256, 1, 1
{
    .reg .pred  %p<4>;
    .reg .b32   %r<52>;
    .reg .b64   %rd<16>;
    .reg .f32   %acc<64>;
    .reg .b32   %fa<16>;
    .reg .b32   %fb<8>;
    .reg .f32   %fal;
    .shared .align 128 .b8 smem_a[24576];   // 3 stages x 128 rows x 64 bytes
    .shared .align 128 .b8 smem_b[24576];

    ld.param.u64    %rd0, [p_a];
    ld.param.u64    %rd1, [p_b];
    ld.param.u32    %r0, [p_k];
    mov.u32         %r1, %tid.x;
    and.b32         %r2, %r1, 31;           // lane
    shr.u32         %r3, %r1, 5;            // warp
    mov.u32         %r4, %ctaid.x;
    shl.b32         %r4, %r4, 7;            // n0
    mov.u32         %r5, %ctaid.y;
    shl.b32         %r5, %r5, 7;            // m0

    // --- loader: this thread copies chunk (t & 3) of rows t >> 2 and
    //     (t >> 2) + 64 of both tiles, 16 bytes each
    shr.u32         %r6, %r1, 2;            // row
    and.b32         %r7, %r1, 3;            // chunk
    shr.u32         %r8, %r6, 1;
    and.b32         %r8, %r8, 3;
    xor.b32         %r8, %r8, %r7;
    shl.b32         %r8, %r8, 4;
    shl.b32         %r9, %r6, 6;
    add.u32         %r9, %r9, %r8;          // shared offset of (row, chunk)
    mov.u32         %r10, smem_a;
    add.u32         %r10, %r10, %r9;        // A dst, stage 0
    mov.u32         %r11, smem_b;
    add.u32         %r11, %r11, %r9;        // B dst, stage 0
    shl.b32         %r12, %r7, 3;           // k offset of the chunk
    add.u32         %r13, %r5, %r6;         // A row
    mad.lo.u32      %r13, %r13, %r0, %r12;
    mul.wide.u32    %rd2, %r13, 2;
    add.s64         %rd2, %rd0, %rd2;       // A src (row), advances 64 B per k-tile
    add.u32         %r14, %r4, %r6;         // B row
    mad.lo.u32      %r14, %r14, %r0, %r12;
    mul.wide.u32    %rd3, %r14, 2;
    add.s64         %rd3, %rd1, %rd3;       // B src
    mul.wide.u32    %rd4, %r0, 128;         // 64 rows of K halves, in bytes

    // --- ldmatrix offsets (see the swizzle above). A: rows wm*64 + (lane & 15)
    //     (+16 per m-tile), chunk 2*kk + (lane >> 4). B: rows wn*32 +
    //     (lane & 7) + 8*(lane >> 4) (+16 per n-tile pair), chunk 2*kk +
    //     ((lane >> 3) & 1). Within a 16-row group (row >> 1) & 3 depends
    //     only on the lane, so one swizzle value serves every tile.
    and.b32         %r15, %r3, 1;           // wm
    shr.u32         %r16, %r3, 1;           // wn
    and.b32         %r17, %r2, 15;
    shl.b32         %r18, %r15, 6;
    add.u32         %r18, %r18, %r17;
    shl.b32         %r18, %r18, 6;          // A row base
    shr.u32         %r19, %r17, 1;
    and.b32         %r19, %r19, 3;          // A swizzle
    shr.u32         %r20, %r2, 4;           // A chunk for kk = 0
    xor.b32         %r21, %r20, %r19;
    shl.b32         %r21, %r21, 4;
    add.u32         %r21, %r21, %r18;       // oA0
    add.u32         %r22, %r20, 2;
    xor.b32         %r22, %r22, %r19;
    shl.b32         %r22, %r22, 4;
    add.u32         %r22, %r22, %r18;       // oA1
    and.b32         %r23, %r2, 7;
    shr.u32         %r24, %r2, 4;
    shl.b32         %r24, %r24, 3;
    add.u32         %r24, %r24, %r23;
    shl.b32         %r25, %r16, 5;
    add.u32         %r24, %r24, %r25;
    shl.b32         %r24, %r24, 6;          // B row base
    shr.u32         %r25, %r23, 1;          // B swizzle
    shr.u32         %r26, %r2, 3;
    and.b32         %r26, %r26, 1;          // B chunk for kk = 0
    xor.b32         %r27, %r26, %r25;
    shl.b32         %r27, %r27, 4;
    add.u32         %r27, %r27, %r24;       // oB0
    add.u32         %r28, %r26, 2;
    xor.b32         %r28, %r28, %r25;
    shl.b32         %r28, %r28, 4;
    add.u32         %r28, %r28, %r24;       // oB1

    // accumulators
    mov.f32 %acc0, 0f00000000; mov.f32 %acc1, 0f00000000; mov.f32 %acc2, 0f00000000; mov.f32 %acc3, 0f00000000; mov.f32 %acc4, 0f00000000; mov.f32 %acc5, 0f00000000; mov.f32 %acc6, 0f00000000; mov.f32 %acc7, 0f00000000;
    mov.f32 %acc8, 0f00000000; mov.f32 %acc9, 0f00000000; mov.f32 %acc10, 0f00000000; mov.f32 %acc11, 0f00000000; mov.f32 %acc12, 0f00000000; mov.f32 %acc13, 0f00000000; mov.f32 %acc14, 0f00000000; mov.f32 %acc15, 0f00000000;
    mov.f32 %acc16, 0f00000000; mov.f32 %acc17, 0f00000000; mov.f32 %acc18, 0f00000000; mov.f32 %acc19, 0f00000000; mov.f32 %acc20, 0f00000000; mov.f32 %acc21, 0f00000000; mov.f32 %acc22, 0f00000000; mov.f32 %acc23, 0f00000000;
    mov.f32 %acc24, 0f00000000; mov.f32 %acc25, 0f00000000; mov.f32 %acc26, 0f00000000; mov.f32 %acc27, 0f00000000; mov.f32 %acc28, 0f00000000; mov.f32 %acc29, 0f00000000; mov.f32 %acc30, 0f00000000; mov.f32 %acc31, 0f00000000;
    mov.f32 %acc32, 0f00000000; mov.f32 %acc33, 0f00000000; mov.f32 %acc34, 0f00000000; mov.f32 %acc35, 0f00000000; mov.f32 %acc36, 0f00000000; mov.f32 %acc37, 0f00000000; mov.f32 %acc38, 0f00000000; mov.f32 %acc39, 0f00000000;
    mov.f32 %acc40, 0f00000000; mov.f32 %acc41, 0f00000000; mov.f32 %acc42, 0f00000000; mov.f32 %acc43, 0f00000000; mov.f32 %acc44, 0f00000000; mov.f32 %acc45, 0f00000000; mov.f32 %acc46, 0f00000000; mov.f32 %acc47, 0f00000000;
    mov.f32 %acc48, 0f00000000; mov.f32 %acc49, 0f00000000; mov.f32 %acc50, 0f00000000; mov.f32 %acc51, 0f00000000; mov.f32 %acc52, 0f00000000; mov.f32 %acc53, 0f00000000; mov.f32 %acc54, 0f00000000; mov.f32 %acc55, 0f00000000;
    mov.f32 %acc56, 0f00000000; mov.f32 %acc57, 0f00000000; mov.f32 %acc58, 0f00000000; mov.f32 %acc59, 0f00000000; mov.f32 %acc60, 0f00000000; mov.f32 %acc61, 0f00000000; mov.f32 %acc62, 0f00000000; mov.f32 %acc63, 0f00000000;

    shr.u32         %r29, %r0, 5;           // k-tiles
    // prologue: k-tiles 0 and 1 into stages 0 and 1 (group per k-tile)
    mov.u32         %r30, 0;                // kt being loaded
    mov.u32         %r31, 0;                // stage being loaded
LOAD_PRO:
    setp.ge.u32     %p0, %r30, %r29;
    @%p0 bra        LOAD_PRO_COMMIT;
    mul.lo.u32      %r32, %r31, 8192;
    add.u32         %r33, %r10, %r32;
    add.u32         %r34, %r11, %r32;
    add.s64         %rd5, %rd2, %rd4;
    add.s64         %rd6, %rd3, %rd4;
    cp.async.cg.shared.global [%r33], [%rd2], 16;
    cp.async.cg.shared.global [%r33+4096], [%rd5], 16;
    cp.async.cg.shared.global [%r34], [%rd3], 16;
    cp.async.cg.shared.global [%r34+4096], [%rd6], 16;
    add.s64         %rd2, %rd2, 64;
    add.s64         %rd3, %rd3, 64;
LOAD_PRO_COMMIT:
    cp.async.commit_group;
    add.u32         %r30, %r30, 1;
    add.u32         %r31, %r31, 1;
    setp.lt.u32     %p0, %r30, 2;
    @%p0 bra        LOAD_PRO;

    mov.u32         %r35, 0;                // kt computed
    mov.u32         %r36, 0;                // its stage
    mov.u32         %r37, smem_a;
    mov.u32         %r38, smem_b;
KLOOP:
    cp.async.wait_group 1;                  // k-tile kt has landed
    bar.sync        0;
    // refill: k-tile kt + 2 into the stage computed last iteration
    add.u32         %r30, %r35, 2;
    setp.ge.u32     %p0, %r30, %r29;
    @%p0 bra        KLOOP_COMMIT;
    add.u32         %r31, %r36, 2;
    setp.ge.u32     %p1, %r31, 3;
    @%p1 sub.u32    %r31, %r31, 3;
    mul.lo.u32      %r32, %r31, 8192;
    add.u32         %r33, %r10, %r32;
    add.u32         %r34, %r11, %r32;
    add.s64         %rd5, %rd2, %rd4;
    add.s64         %rd6, %rd3, %rd4;
    cp.async.cg.shared.global [%r33], [%rd2], 16;
    cp.async.cg.shared.global [%r33+4096], [%rd5], 16;
    cp.async.cg.shared.global [%r34], [%rd3], 16;
    cp.async.cg.shared.global [%r34+4096], [%rd6], 16;
    add.s64         %rd2, %rd2, 64;
    add.s64         %rd3, %rd3, 64;
KLOOP_COMMIT:
    cp.async.commit_group;

    mul.lo.u32      %r32, %r36, 8192;
    add.u32         %r39, %r37, %r32;       // A stage
    add.u32         %r40, %r38, %r32;       // B stage
    // k16 step 0
    add.u32         %r41, %r39, %r21;
    ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%fa0, %fa1, %fa2, %fa3}, [%r41+0];
    ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%fa4, %fa5, %fa6, %fa7}, [%r41+1024];
    ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%fa8, %fa9, %fa10, %fa11}, [%r41+2048];
    ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%fa12, %fa13, %fa14, %fa15}, [%r41+3072];
    add.u32         %r42, %r40, %r27;
    ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%fb0, %fb1, %fb2, %fb3}, [%r42+0];
    ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%fb4, %fb5, %fb6, %fb7}, [%r42+1024];
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%acc0, %acc1, %acc2, %acc3}, {%fa0, %fa1, %fa2, %fa3}, {%fb0, %fb1}, {%acc0, %acc1, %acc2, %acc3};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%acc4, %acc5, %acc6, %acc7}, {%fa0, %fa1, %fa2, %fa3}, {%fb2, %fb3}, {%acc4, %acc5, %acc6, %acc7};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%acc8, %acc9, %acc10, %acc11}, {%fa0, %fa1, %fa2, %fa3}, {%fb4, %fb5}, {%acc8, %acc9, %acc10, %acc11};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%acc12, %acc13, %acc14, %acc15}, {%fa0, %fa1, %fa2, %fa3}, {%fb6, %fb7}, {%acc12, %acc13, %acc14, %acc15};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%acc16, %acc17, %acc18, %acc19}, {%fa4, %fa5, %fa6, %fa7}, {%fb0, %fb1}, {%acc16, %acc17, %acc18, %acc19};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%acc20, %acc21, %acc22, %acc23}, {%fa4, %fa5, %fa6, %fa7}, {%fb2, %fb3}, {%acc20, %acc21, %acc22, %acc23};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%acc24, %acc25, %acc26, %acc27}, {%fa4, %fa5, %fa6, %fa7}, {%fb4, %fb5}, {%acc24, %acc25, %acc26, %acc27};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%acc28, %acc29, %acc30, %acc31}, {%fa4, %fa5, %fa6, %fa7}, {%fb6, %fb7}, {%acc28, %acc29, %acc30, %acc31};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%acc32, %acc33, %acc34, %acc35}, {%fa8, %fa9, %fa10, %fa11}, {%fb0, %fb1}, {%acc32, %acc33, %acc34, %acc35};
