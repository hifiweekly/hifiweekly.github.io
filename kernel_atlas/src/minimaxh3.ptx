    st.global.b32   [%rd4+144], %r52;
    mul.f32 %f14, %o40, %f12; mul.f32 %f15, %o41, %f12;
    cvt.rn.f16x2.f32 %r52, %f15, %f14;
    st.global.b32   [%rd4+160], %r52;
    mul.f32 %f14, %o44, %f12; mul.f32 %f15, %o45, %f12;
    cvt.rn.f16x2.f32 %r52, %f15, %f14;
    st.global.b32   [%rd4+176], %r52;
    mul.f32 %f14, %o48, %f12; mul.f32 %f15, %o49, %f12;
    cvt.rn.f16x2.f32 %r52, %f15, %f14;
    st.global.b32   [%rd4+192], %r52;
    mul.f32 %f14, %o52, %f12; mul.f32 %f15, %o53, %f12;
    cvt.rn.f16x2.f32 %r52, %f15, %f14;
    st.global.b32   [%rd4+208], %r52;
    mul.f32 %f14, %o56, %f12; mul.f32 %f15, %o57, %f12;
    cvt.rn.f16x2.f32 %r52, %f15, %f14;
    st.global.b32   [%rd4+224], %r52;
    mul.f32 %f14, %o60, %f12; mul.f32 %f15, %o61, %f12;
    cvt.rn.f16x2.f32 %r52, %f15, %f14;
    st.global.b32   [%rd4+240], %r52;
ROW1:
    add.u32         %r53, %r31, 8;
    setp.ge.u32     %p4, %r53, %r5;
    @%p4 bra        DONE;
    mad.lo.u32      %r51, %r53, %r49, %r50;
    mul.wide.u32    %rd4, %r51, 2;
    add.s64         %rd4, %rd3, %rd4;
    mul.f32 %f14, %o2, %f13; mul.f32 %f15, %o3, %f13;
    cvt.rn.f16x2.f32 %r52, %f15, %f14;
    st.global.b32   [%rd4+0], %r52;
    mul.f32 %f14, %o6, %f13; mul.f32 %f15, %o7, %f13;
    cvt.rn.f16x2.f32 %r52, %f15, %f14;
    st.global.b32   [%rd4+16], %r52;
    mul.f32 %f14, %o10, %f13; mul.f32 %f15, %o11, %f13;
    cvt.rn.f16x2.f32 %r52, %f15, %f14;
    st.global.b32   [%rd4+32], %r52;
    mul.f32 %f14, %o14, %f13; mul.f32 %f15, %o15, %f13;
    cvt.rn.f16x2.f32 %r52, %f15, %f14;
    st.global.b32   [%rd4+48], %r52;
    mul.f32 %f14, %o18, %f13; mul.f32 %f15, %o19, %f13;
    cvt.rn.f16x2.f32 %r52, %f15, %f14;
    st.global.b32   [%rd4+64], %r52;
    mul.f32 %f14, %o22, %f13; mul.f32 %f15, %o23, %f13;
    cvt.rn.f16x2.f32 %r52, %f15, %f14;
    st.global.b32   [%rd4+80], %r52;
    mul.f32 %f14, %o26, %f13; mul.f32 %f15, %o27, %f13;
    cvt.rn.f16x2.f32 %r52, %f15, %f14;
    st.global.b32   [%rd4+96], %r52;
    mul.f32 %f14, %o30, %f13; mul.f32 %f15, %o31, %f13;
    cvt.rn.f16x2.f32 %r52, %f15, %f14;
    st.global.b32   [%rd4+112], %r52;
    mul.f32 %f14, %o34, %f13; mul.f32 %f15, %o35, %f13;
    cvt.rn.f16x2.f32 %r52, %f15, %f14;
    st.global.b32   [%rd4+128], %r52;
    mul.f32 %f14, %o38, %f13; mul.f32 %f15, %o39, %f13;
    cvt.rn.f16x2.f32 %r52, %f15, %f14;
    st.global.b32   [%rd4+144], %r52;
    mul.f32 %f14, %o42, %f13; mul.f32 %f15, %o43, %f13;
    cvt.rn.f16x2.f32 %r52, %f15, %f14;
    st.global.b32   [%rd4+160], %r52;
    mul.f32 %f14, %o46, %f13; mul.f32 %f15, %o47, %f13;
    cvt.rn.f16x2.f32 %r52, %f15, %f14;
    st.global.b32   [%rd4+176], %r52;
    mul.f32 %f14, %o50, %f13; mul.f32 %f15, %o51, %f13;
    cvt.rn.f16x2.f32 %r52, %f15, %f14;
    st.global.b32   [%rd4+192], %r52;
    mul.f32 %f14, %o54, %f13; mul.f32 %f15, %o55, %f13;
    cvt.rn.f16x2.f32 %r52, %f15, %f14;
    st.global.b32   [%rd4+208], %r52;
    mul.f32 %f14, %o58, %f13; mul.f32 %f15, %o59, %f13;
    cvt.rn.f16x2.f32 %r52, %f15, %f14;
    st.global.b32   [%rd4+224], %r52;
    mul.f32 %f14, %o62, %f13; mul.f32 %f15, %o63, %f13;
    cvt.rn.f16x2.f32 %r52, %f15, %f14;
    st.global.b32   [%rd4+240], %r52;
DONE:
    ret;
}

// -----------------------------------------------------------------------------
// Kernel: attn_d64   O = softmax(Q K^T * scale) V for every head, reading Q, K
//   and V where the fused projection left them: token t's q of head h at
//   columns qoff + h*hstride .. +64 of row t of qkv (f16 [N][ld]), its k and v
//   at koff / voff + (h / group)*hstride (group > 1: grouped-query attention).
//   64-dim heads, 64 queries per block (4 warps x 16 rows), key tiles of 64.
//   Key tiles go to shared memory with cp.async, two buffers (the next tile
//   loads while this one is used); rows past N are zero-filled (cp.async
//   with src-size 0) and masked. Shared rows are 128 bytes (8 chunks of 16):
//   chunk c of row r is stored at chunk c ^ (r & 7). S = Q K^T and O += P V
//   are mma.m16n8k16 (f16 in, f32 acc); the softmax is the online one in
//   base 2 (scores times scale * log2(e), exponentials with ex2). P never
//   leaves registers: the S accumulators of two adjacent 8-key tiles are the
//   A fragment of one 16-key mma step. causal != 0: key <= query.
//   The Q tile is staged in the second buffer before the first prefetch.
//   grid (ceil(N / 64), H), block 128. O f16 [N][ldo], head h at h*64.
// -----------------------------------------------------------------------------
.visible .entry attn_d64(
    .param .u64 p_qkv,          // f16 [N][ld]
    .param .u64 p_o,            // f16 [N][ldo] (out)
    .param .u32 p_n,
    .param .u32 p_ld,
    .param .u32 p_ldo,
    .param .u32 p_qoff,
    .param .u32 p_koff,
    .param .u32 p_voff,
    .param .u32 p_hstride,
    .param .u32 p_group,
    .param .f32 p_scale,
    .param .u32 p_causal
)
.maxntid 128, 1, 1
{
    .reg .pred  %p<8>;
    .reg .b32   %r<64>;
    .reg .b32   %ko<4>;
    .reg .b32   %vo<4>;
    .reg .b64   %rd<16>;
    .reg .f32   %f<24>;
    .reg .f32   %s<32>;
    .reg .f32   %o<32>;
    .reg .b32   %qa<16>;
    .reg .b32   %kb<4>;
    .reg .b32   %pa<4>;
    .shared .align 128 .b8 sm[32768];      // [K0 V0 | K1 V1], Q staged in buffer 1

    mov.u32         %r0, %tid.x;
    and.b32         %r1, %r0, 31;           // lane
    shr.u32         %r2, %r0, 5;            // warp
    mov.u32         %r3, %ctaid.x;
    shl.b32         %r3, %r3, 6;            // q0
    mov.u32         %r4, %ctaid.y;          // h
    ld.param.u32    %r5, [p_n];
    ld.param.u32    %r6, [p_ld];
    ld.param.u32    %r7, [p_hstride];
    ld.param.u32    %r8, [p_group];
    div.u32         %r9, %r4, %r8;          // kv head
    ld.param.u32    %r10, [p_qoff];
    mad.lo.u32      %r10, %r4, %r7, %r10;   // q column
    ld.param.u32    %r11, [p_koff];
    mad.lo.u32      %r11, %r9, %r7, %r11;   // k column
    ld.param.u32    %r12, [p_voff];
    mad.lo.u32      %r12, %r9, %r7, %r12;   // v column
    ld.param.u64    %rd0, [p_qkv];

    // --- loader: thread t copies chunk t % 8 of rows t / 8 + 16 j; the
    //     swizzled chunk depends only on t (every row step is a multiple of 8)
    and.b32         %r13, %r0, 7;     // chunk
    shr.u32         %r14, %r0, 3;     // first row
    and.b32         %r15, %r14, 7;
    xor.b32         %r15, %r15, %r13;
    shl.b32         %r15, %r15, 4;
    mad.lo.u32      %r15, %r14, 128, %r15;  // shared offset of (first row, chunk)
    mov.u32         %r16, sm;
    add.u32         %r16, %r16, %r15;       // loader dst, buffer 0 K
    shl.b32         %r17, %r13, 4;          // chunk byte offset in a global row
    // Q tile -> buffer 1
    add.u32         %r20, %r14, 0;
    add.u32         %r20, %r20, %r3;
    setp.lt.u32     %p0, %r20, %r5;
    selp.u32        %r21, 16, 0, %p0;
    selp.u32        %r20, %r20, 0, %p0;
    mad.lo.u32      %r20, %r20, %r6, %r10;
    mul.wide.u32    %rd1, %r20, 2;
    add.s64         %rd1, %rd0, %rd1;
    cvt.u64.u32     %rd2, %r17;
    add.s64         %rd1, %rd1, %rd2;
    cp.async.cg.shared.global [%r16+16384+0], [%rd1], 16, %r21;
    add.u32         %r20, %r14, 16;
    add.u32         %r20, %r20, %r3;
    setp.lt.u32     %p0, %r20, %r5;
    selp.u32        %r21, 16, 0, %p0;
    selp.u32        %r20, %r20, 0, %p0;
    mad.lo.u32      %r20, %r20, %r6, %r10;
    mul.wide.u32    %rd1, %r20, 2;
    add.s64         %rd1, %rd0, %rd1;
    cvt.u64.u32     %rd2, %r17;
    add.s64         %rd1, %rd1, %rd2;
    cp.async.cg.shared.global [%r16+16384+2048], [%rd1], 16, %r21;
    add.u32         %r20, %r14, 32;
    add.u32         %r20, %r20, %r3;
    setp.lt.u32     %p0, %r20, %r5;
    selp.u32        %r21, 16, 0, %p0;
    selp.u32        %r20, %r20, 0, %p0;
    mad.lo.u32      %r20, %r20, %r6, %r10;
    mul.wide.u32    %rd1, %r20, 2;
    add.s64         %rd1, %rd0, %rd1;
    cvt.u64.u32     %rd2, %r17;
    add.s64         %rd1, %rd1, %rd2;
    cp.async.cg.shared.global [%r16+16384+4096], [%rd1], 16, %r21;
    add.u32         %r20, %r14, 48;
    add.u32         %r20, %r20, %r3;
    setp.lt.u32     %p0, %r20, %r5;
    selp.u32        %r21, 16, 0, %p0;
    selp.u32        %r20, %r20, 0, %p0;
    mad.lo.u32      %r20, %r20, %r6, %r10;
    mul.wide.u32    %rd1, %r20, 2;
    add.s64         %rd1, %rd0, %rd1;
    cvt.u64.u32     %rd2, %r17;
    add.s64         %rd1, %rd1, %rd2;
    cp.async.cg.shared.global [%r16+16384+6144], [%rd1], 16, %r21;
    cp.async.commit_group;
    // key tile 0 -> buffer 0
    mov.u32         %r22, 0;                // first key of the tile being loaded
    add.u32         %r20, %r14, 0;
    add.u32         %r20, %r20, %r22;
    setp.lt.u32     %p0, %r20, %r5;
    selp.u32        %r21, 16, 0, %p0;
    selp.u32        %r20, %r20, 0, %p0;
    mad.lo.u32      %r20, %r20, %r6, %r11;
    mul.wide.u32    %rd1, %r20, 2;
    add.s64         %rd1, %rd0, %rd1;
    cvt.u64.u32     %rd2, %r17;
    add.s64         %rd1, %rd1, %rd2;
    cp.async.cg.shared.global [%r16+0], [%rd1], 16, %r21;
    add.u32         %r20, %r14, 16;
    add.u32         %r20, %r20, %r22;
    setp.lt.u32     %p0, %r20, %r5;
    selp.u32        %r21, 16, 0, %p0;
    selp.u32        %r20, %r20, 0, %p0;
    mad.lo.u32      %r20, %r20, %r6, %r11;
    mul.wide.u32    %rd1, %r20, 2;
    add.s64         %rd1, %rd0, %rd1;
    cvt.u64.u32     %rd2, %r17;
    add.s64         %rd1, %rd1, %rd2;
    cp.async.cg.shared.global [%r16+2048], [%rd1], 16, %r21;
    add.u32         %r20, %r14, 32;
    add.u32         %r20, %r20, %r22;
    setp.lt.u32     %p0, %r20, %r5;
    selp.u32        %r21, 16, 0, %p0;
    selp.u32        %r20, %r20, 0, %p0;
    mad.lo.u32      %r20, %r20, %r6, %r11;
    mul.wide.u32    %rd1, %r20, 2;
    add.s64         %rd1, %rd0, %rd1;
    cvt.u64.u32     %rd2, %r17;
    add.s64         %rd1, %rd1, %rd2;
    cp.async.cg.shared.global [%r16+4096], [%rd1], 16, %r21;
    add.u32         %r20, %r14, 48;
    add.u32         %r20, %r20, %r22;
    setp.lt.u32     %p0, %r20, %r5;
    selp.u32        %r21, 16, 0, %p0;
    selp.u32        %r20, %r20, 0, %p0;
    mad.lo.u32      %r20, %r20, %r6, %r11;
    mul.wide.u32    %rd1, %r20, 2;
    add.s64         %rd1, %rd0, %rd1;
    cvt.u64.u32     %rd2, %r17;
    add.s64         %rd1, %rd1, %rd2;
    cp.async.cg.shared.global [%r16+6144], [%rd1], 16, %r21;
    add.u32         %r20, %r14, 0;
    add.u32         %r20, %r20, %r22;
    setp.lt.u32     %p0, %r20, %r5;
    selp.u32        %r21, 16, 0, %p0;
    selp.u32        %r20, %r20, 0, %p0;
    mad.lo.u32      %r20, %r20, %r6, %r12;
    mul.wide.u32    %rd1, %r20, 2;
    add.s64         %rd1, %rd0, %rd1;
    cvt.u64.u32     %rd2, %r17;
    add.s64         %rd1, %rd1, %rd2;
    cp.async.cg.shared.global [%r16+8192+0], [%rd1], 16, %r21;
    add.u32         %r20, %r14, 16;
    add.u32         %r20, %r20, %r22;
    setp.lt.u32     %p0, %r20, %r5;
    selp.u32        %r21, 16, 0, %p0;
    selp.u32        %r20, %r20, 0, %p0;
    mad.lo.u32      %r20, %r20, %r6, %r12;
    mul.wide.u32    %rd1, %r20, 2;
    add.s64         %rd1, %rd0, %rd1;
    cvt.u64.u32     %rd2, %r17;
    add.s64         %rd1, %rd1, %rd2;
    cp.async.cg.shared.global [%r16+8192+2048], [%rd1], 16, %r21;
    add.u32         %r20, %r14, 32;
    add.u32         %r20, %r20, %r22;
    setp.lt.u32     %p0, %r20, %r5;
    selp.u32        %r21, 16, 0, %p0;
    selp.u32        %r20, %r20, 0, %p0;
    mad.lo.u32      %r20, %r20, %r6, %r12;
    mul.wide.u32    %rd1, %r20, 2;
    add.s64         %rd1, %rd0, %rd1;
    cvt.u64.u32     %rd2, %r17;
    add.s64         %rd1, %rd1, %rd2;
    cp.async.cg.shared.global [%r16+8192+4096], [%rd1], 16, %r21;
    add.u32         %r20, %r14, 48;
    add.u32         %r20, %r20, %r22;
    setp.lt.u32     %p0, %r20, %r5;
    selp.u32        %r21, 16, 0, %p0;
    selp.u32        %r20, %r20, 0, %p0;
    mad.lo.u32      %r20, %r20, %r6, %r12;
    mul.wide.u32    %rd1, %r20, 2;
    add.s64         %rd1, %rd0, %rd1;
    cvt.u64.u32     %rd2, %r17;
    add.s64         %rd1, %rd1, %rd2;
    cp.async.cg.shared.global [%r16+8192+6144], [%rd1], 16, %r21;
    cp.async.commit_group;

    // --- ldmatrix offsets. Q (A operand): rows 16 w + (lane & 15), chunk
    //     2 kk + (lane >> 4). K (B operand): rows 16 np + (lane & 7) +
    //     8 (lane >> 4), chunk 2 kk + ((lane >> 3) & 1). V (B operand,
    //     transposed): rows 16 kc + (lane & 7) + 8 ((lane >> 3) & 1), chunk
    //     2 np + (lane >> 4). Every row group starts at a multiple of 8, so the
    //     swizzle is lane & 7 throughout.
    and.b32         %r23, %r1, 7;           // swizzle
    shr.u32         %r24, %r1, 4;           // lane >> 4
    shr.u32         %r25, %r1, 3;
    and.b32         %r25, %r25, 1;          // (lane >> 3) & 1
    shl.b32         %r26, %r24, 3;
    add.u32         %r26, %r26, %r23;
    mul.lo.u32      %r26, %r26, 128;        // K row base
    add.u32         %r27, %r25, 0;
    xor.b32         %r27, %r27, %r23;
    shl.b32         %r27, %r27, 4;
    add.u32         %ko0, %r26, %r27;
    add.u32         %r27, %r25, 2;
    xor.b32         %r27, %r27, %r23;
    shl.b32         %r27, %r27, 4;
    add.u32         %ko1, %r26, %r27;
    add.u32         %r27, %r25, 4;
    xor.b32         %r27, %r27, %r23;
    shl.b32         %r27, %r27, 4;
    add.u32         %ko2, %r26, %r27;
    add.u32         %r27, %r25, 6;
    xor.b32         %r27, %r27, %r23;
    shl.b32         %r27, %r27, 4;
    add.u32         %ko3, %r26, %r27;
    shl.b32         %r26, %r25, 3;
    add.u32         %r26, %r26, %r23;
    mul.lo.u32      %r26, %r26, 128;        // V row base
    add.u32         %r27, %r24, 0;
    xor.b32         %r27, %r27, %r23;
    shl.b32         %r27, %r27, 4;
    add.u32         %vo0, %r26, %r27;
    add.u32         %r27, %r24, 2;
    xor.b32         %r27, %r27, %r23;
    shl.b32         %r27, %r27, 4;
    add.u32         %vo1, %r26, %r27;
    add.u32         %r27, %r24, 4;
    xor.b32         %r27, %r27, %r23;
    shl.b32         %r27, %r27, 4;
    add.u32         %vo2, %r26, %r27;
    add.u32         %r27, %r24, 6;
    xor.b32         %r27, %r27, %r23;
    shl.b32         %r27, %r27, 4;
    add.u32         %vo3, %r26, %r27;

    // Q fragments (both groups landed), then a barrier before buffer 1 is reused
    cp.async.wait_group 0;
    bar.sync        0;
    and.b32         %r26, %r1, 15;
    shl.b32         %r27, %r2, 4;
    add.u32         %r26, %r26, %r27;
    mul.lo.u32      %r26, %r26, 128;
    mov.u32         %r27, sm;
    add.u32         %r26, %r26, %r27;
    add.u32         %r26, %r26, 16384;    // Q row base
    add.u32         %r28, %r24, 0;
    xor.b32         %r28, %r28, %r23;
    shl.b32         %r28, %r28, 4;
    add.u32         %r28, %r28, %r26;
    ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%qa0, %qa1, %qa2, %qa3}, [%r28];
    add.u32         %r28, %r24, 2;
    xor.b32         %r28, %r28, %r23;
    shl.b32         %r28, %r28, 4;
    add.u32         %r28, %r28, %r26;
    ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%qa4, %qa5, %qa6, %qa7}, [%r28];
    add.u32         %r28, %r24, 4;
    xor.b32         %r28, %r28, %r23;
    shl.b32         %r28, %r28, 4;
    add.u32         %r28, %r28, %r26;
    ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%qa8, %qa9, %qa10, %qa11}, [%r28];
    add.u32         %r28, %r24, 6;
    xor.b32         %r28, %r28, %r23;
    shl.b32         %r28, %r28, 4;
    add.u32         %r28, %r28, %r26;
    ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%qa12, %qa13, %qa14, %qa15}, [%r28];
    bar.sync        0;

    // running max (base-2 scaled scores) and sum for rows g and g + 8
