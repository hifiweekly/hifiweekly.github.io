// -----------------------------------------------------------------------------
// Kernel: add_cast   ys = f16(a + b), ya = f16(a) (each optional; b may be 0
//   for ys = f16(a)). n elements (even), one thread per pair, grid-stride.
// -----------------------------------------------------------------------------
.visible .entry add_cast(
    .param .u64 p_a,            // f32 [n]
    .param .u64 p_b,            // f32 [n] or 0
    .param .u64 p_ys,           // f16 [n] or 0
    .param .u64 p_ya,           // f16 [n] or 0
    .param .u32 p_n
)
{
    .reg .pred  %p<4>;
    .reg .b32   %r<12>;
    .reg .b64   %rd<10>;
    .reg .f32   %f<4>;

    ld.param.u64    %rd0, [p_a];
    ld.param.u64    %rd1, [p_b];
    ld.param.u64    %rd2, [p_ys];
    ld.param.u64    %rd3, [p_ya];
    ld.param.u32    %r0, [p_n];
    shr.u32         %r0, %r0, 1;
    setp.ne.u64     %p1, %rd1, 0;
    setp.ne.u64     %p2, %rd2, 0;
    setp.ne.u64     %p3, %rd3, 0;
    mov.u32         %r1, %ctaid.x;
    mov.u32         %r2, %ntid.x;
    mov.u32         %r3, %tid.x;
    mad.lo.u32      %r4, %r1, %r2, %r3;
    mov.u32         %r5, %nctaid.x;
    mul.lo.u32      %r5, %r5, %r2;
LOOP:
    setp.ge.u32     %p0, %r4, %r0;
    @%p0 bra        DONE;
    mul.wide.u32    %rd4, %r4, 8;
    add.s64         %rd5, %rd0, %rd4;
    ld.global.nc.v2.f32 {%f0, %f1}, [%rd5];
    mul.wide.u32    %rd6, %r4, 4;
    @!%p3 bra       SUM;
    cvt.rn.f16x2.f32 %r6, %f1, %f0;
    add.s64         %rd7, %rd3, %rd6;
    st.global.b32   [%rd7], %r6;
SUM:
    @!%p2 bra       NEXT;
    @!%p1 bra       STORE;
    add.s64         %rd5, %rd1, %rd4;
    ld.global.nc.v2.f32 {%f2, %f3}, [%rd5];
    add.f32         %f0, %f0, %f2;
    add.f32         %f1, %f1, %f3;
STORE:
    cvt.rn.f16x2.f32 %r6, %f1, %f0;
    add.s64         %rd7, %rd2, %rd6;
    st.global.b32   [%rd7], %r6;
NEXT:
    add.u32         %r4, %r4, %r5;
    bra.uni         LOOP;
DONE:
    ret;
}

// -----------------------------------------------------------------------------
// Kernel: depth2space   the scatter of a 2 x 2, stride 2 transposed
//   convolution done as a GEMM: src [h*w][4*O] holds, for input pixel (y, x),
//   column o*4 + dy*2 + dx = output (2y + dy, 2x + dx), channel o (the
//   weight's [O][2][2][I] rows); dst [(2h)*(2w)][O]. Both f16. One thread per
//   pair of output channels, grid-stride.
// -----------------------------------------------------------------------------
.visible .entry depth2space(
    .param .u64 p_src,          // f16 [h*w][4*O]
    .param .u64 p_dst,          // f16 [4*h*w][O]
    .param .u32 p_h,
    .param .u32 p_w,
    .param .u32 p_o             // output channels (even)
)
{
    .reg .pred  %p<2>;
    .reg .b32   %r<32>;
    .reg .b64   %rd<8>;
    .reg .b16   %h<2>;

    ld.param.u64    %rd0, [p_src];
    ld.param.u64    %rd1, [p_dst];
    ld.param.u32    %r0, [p_h];
    ld.param.u32    %r1, [p_w];
    ld.param.u32    %r2, [p_o];
    shl.b32         %r3, %r1, 1;            // output width
    shr.u32         %r4, %r2, 1;            // pairs per pixel
    mul.lo.u32      %r5, %r0, %r1;
    shl.b32         %r5, %r5, 2;
    mul.lo.u32      %r5, %r5, %r4;          // total
    shl.b32         %r6, %r2, 2;            // src row length
    mov.u32         %r7, %ctaid.x;
    mov.u32         %r8, %ntid.x;
    mov.u32         %r9, %tid.x;
    mad.lo.u32      %r10, %r7, %r8, %r9;
    mov.u32         %r11, %nctaid.x;
    mul.lo.u32      %r11, %r11, %r8;
LOOP:
    setp.ge.u32     %p0, %r10, %r5;
    @%p0 bra        DONE;
    rem.u32         %r12, %r10, %r4;
    shl.b32         %r12, %r12, 1;          // o
    div.u32         %r13, %r10, %r4;        // output pixel
    div.u32         %r14, %r13, %r3;        // Y
    rem.u32         %r15, %r13, %r3;        // X
    shr.u32         %r16, %r14, 1;          // y
    and.b32         %r17, %r14, 1;          // dy
    shr.u32         %r18, %r15, 1;          // x
    and.b32         %r19, %r15, 1;          // dx
    mad.lo.u32      %r20, %r16, %r1, %r18;  // input pixel
    shl.b32         %r21, %r17, 1;
    add.u32         %r21, %r21, %r19;       // dy*2 + dx
    shl.b32         %r22, %r12, 2;
    add.u32         %r22, %r22, %r21;
    mad.lo.u32      %r23, %r20, %r6, %r22;
    mul.wide.u32    %rd2, %r23, 2;
    add.s64         %rd2, %rd0, %rd2;
    ld.global.nc.b16 %h0, [%rd2];           // channel o
    ld.global.nc.b16 %h1, [%rd2+8];         // channel o + 1 (4 columns on)
    mov.b32         %r24, {%h0, %h1};
    mad.lo.u32      %r25, %r13, %r2, %r12;
    mul.wide.u32    %rd3, %r25, 2;
    add.s64         %rd3, %rd1, %rd3;
    st.global.b32   [%rd3], %r24;
    add.u32         %r10, %r10, %r11;
    bra.uni         LOOP;
DONE:
    ret;
}

// -----------------------------------------------------------------------------
// Kernel: im2col3   a 3 x 3, pad 1 convolution as a matrix: row (y, x) of dst
//   = the 3 x 3 x C neighbourhood in (ky, kx, c) order (the weight's
//   [O][3][3][I] layout), zero outside the map. src / dst f16. One thread per
//   8 channels (16 bytes), grid-stride. C % 8 == 0.
// -----------------------------------------------------------------------------
.visible .entry im2col3(
    .param .u64 p_src,          // f16 [h][w][C]
    .param .u64 p_dst,          // f16 [h*w][9*C]
    .param .u32 p_h,
    .param .u32 p_w,
    .param .u32 p_c
)
{
    .reg .pred  %p<4>;
    .reg .b32   %r<32>;
    .reg .b64   %rd<8>;
    .reg .b32   %v<4>;

    ld.param.u64    %rd0, [p_src];
    ld.param.u64    %rd1, [p_dst];
    ld.param.u32    %r0, [p_h];
    ld.param.u32    %r1, [p_w];
    ld.param.u32    %r2, [p_c];
    shr.u32         %r3, %r2, 3;            // chunks per channel vector
    mul.lo.u32      %r4, %r3, 9;            // chunks per row of dst
    mul.lo.u32      %r5, %r0, %r1;
    mul.lo.u32      %r5, %r5, %r4;          // total
    mov.u32         %r6, %ctaid.x;
    mov.u32         %r7, %ntid.x;
    mov.u32         %r8, %tid.x;
    mad.lo.u32      %r9, %r6, %r7, %r8;
    mov.u32         %r10, %nctaid.x;
    mul.lo.u32      %r10, %r10, %r7;
LOOP:
    setp.ge.u32     %p0, %r9, %r5;
    @%p0 bra        DONE;
    div.u32         %r11, %r9, %r4;         // pixel
    rem.u32         %r12, %r9, %r4;         // chunk in row
    div.u32         %r13, %r12, %r3;        // tap ky*3 + kx
    rem.u32         %r14, %r12, %r3;        // chunk in channels
    div.u32         %r15, %r11, %r1;        // y
    rem.u32         %r16, %r11, %r1;        // x
    div.u32         %r17, %r13, 3;
    rem.u32         %r18, %r13, 3;
    add.u32         %r15, %r15, %r17;
    sub.u32         %r15, %r15, 1;          // source row (wraps if -1)
    add.u32         %r16, %r16, %r18;
    sub.u32         %r16, %r16, 1;
    mov.b32         %v0, 0;
    mov.b32         %v1, 0;
    mov.b32         %v2, 0;
    mov.b32         %v3, 0;
    setp.ge.u32     %p1, %r15, %r0;         // unsigned: catches -1 too
    setp.ge.u32     %p2, %r16, %r1;
    or.pred         %p1, %p1, %p2;
    @%p1 bra        STORE;
    mad.lo.u32      %r19, %r15, %r1, %r16;
    mad.lo.u32      %r19, %r19, %r3, %r14;
    mul.wide.u32    %rd2, %r19, 16;
    add.s64         %rd2, %rd0, %rd2;
    ld.global.nc.v4.b32 {%v0, %v1, %v2, %v3}, [%rd2];
STORE:
    mul.wide.u32    %rd3, %r9, 16;
    add.s64         %rd3, %rd1, %rd3;
    st.global.v4.b32 [%rd3], {%v0, %v1, %v2, %v3};
    add.u32         %r9, %r9, %r10;
    bra.uni         LOOP;
DONE:
    ret;
}

// -----------------------------------------------------------------------------
// Kernel: upsample_add   dst = f16(cur + nearest_2x(prev)): one step of the
//   pixel decoder (prev [h][w][C], cur [2h][2w][C], f32). One thread per 4
//   channels, grid-stride.
// -----------------------------------------------------------------------------
.visible .entry upsample_add(
    .param .u64 p_prev,         // f32 [h][w][C]
    .param .u64 p_cur,          // f32 [2h][2w][C]
    .param .u64 p_dst,          // f16 [2h][2w][C]
    .param .u32 p_h,
    .param .u32 p_w,
    .param .u32 p_c
)
{
    .reg .pred  %p<2>;
    .reg .b32   %r<24>;
    .reg .b64   %rd<8>;
    .reg .f32   %f<8>;

    ld.param.u64    %rd0, [p_prev];
    ld.param.u64    %rd1, [p_cur];
    ld.param.u64    %rd2, [p_dst];
    ld.param.u32    %r0, [p_h];
    ld.param.u32    %r1, [p_w];
    ld.param.u32    %r2, [p_c];
    shr.u32         %r3, %r2, 2;            // float4s per pixel
    shl.b32         %r4, %r1, 1;            // output width
    mul.lo.u32      %r5, %r0, %r1;
    shl.b32         %r5, %r5, 2;
    mul.lo.u32      %r5, %r5, %r3;          // total
    mov.u32         %r6, %ctaid.x;
    mov.u32         %r7, %ntid.x;
    mov.u32         %r8, %tid.x;
    mad.lo.u32      %r9, %r6, %r7, %r8;
    mov.u32         %r10, %nctaid.x;
    mul.lo.u32      %r10, %r10, %r7;
LOOP:
    setp.ge.u32     %p0, %r9, %r5;
    @%p0 bra        DONE;
    div.u32         %r11, %r9, %r3;         // output pixel
    rem.u32         %r12, %r9, %r3;
    div.u32         %r13, %r11, %r4;
    rem.u32         %r14, %r11, %r4;
    shr.u32         %r13, %r13, 1;
    shr.u32         %r14, %r14, 1;
    mad.lo.u32      %r15, %r13, %r1, %r14;  // input pixel
    mad.lo.u32      %r15, %r15, %r3, %r12;
    mul.wide.u32    %rd3, %r15, 16;
    add.s64         %rd3, %rd0, %rd3;
    ld.global.nc.v4.f32 {%f0, %f1, %f2, %f3}, [%rd3];
    mul.wide.u32    %rd4, %r9, 16;
    add.s64         %rd4, %rd1, %rd4;
    ld.global.nc.v4.f32 {%f4, %f5, %f6, %f7}, [%rd4];
    add.f32         %f0, %f0, %f4;
    add.f32         %f1, %f1, %f5;
    add.f32         %f2, %f2, %f6;
    add.f32         %f3, %f3, %f7;
    cvt.rn.f16x2.f32 %r16, %f1, %f0;
    cvt.rn.f16x2.f32 %r17, %f3, %f2;
    mul.wide.u32    %rd5, %r9, 8;
    add.s64         %rd5, %rd2, %rd5;
    st.global.v2.b32 [%rd5], {%r16, %r17};
    add.u32         %r9, %r9, %r10;
    bra.uni         LOOP;
DONE:
    ret;
}

// -----------------------------------------------------------------------------
// Kernel: gn_stats   GroupNorm statistics: acc[g] += {sum, sum of squares}
//   (f64) over the n pixels of x [n][256] and the 32 channels of group g = 8
//   groups. Thread t owns channel t, so warp g owns group g: each thread sums
//   its channel over this block's rows, the warp reduces, lane 0 adds to acc
//   with an f64 atomic. acc must be zeroed first. block 256, any grid.
// -----------------------------------------------------------------------------
.visible .entry gn_stats(
    .param .u64 p_x,            // f32 [n][256]
    .param .u64 p_acc,          // f64 [8][2] (accumulated)
    .param .u32 p_n
)
{
    .reg .pred  %p<3>;
    .reg .b32   %r<16>;
    .reg .b64   %rd<8>;
    .reg .f32   %f<8>;
    .reg .f64   %d<4>;

    ld.param.u64    %rd0, [p_x];
    ld.param.u64    %rd1, [p_acc];
    ld.param.u32    %r0, [p_n];
    mov.u32         %r1, %tid.x;
    mov.u32         %r2, %ctaid.x;
    mov.u32         %r3, %nctaid.x;
    // rows [n * b / grid, n * (b + 1) / grid)
    mul.wide.u32    %rd2, %r0, %r2;
    cvt.u64.u32     %rd3, %r3;
    div.u64         %rd2, %rd2, %rd3;
    cvt.u32.u64     %r4, %rd2;
    add.u32         %r5, %r2, 1;
    mul.wide.u32    %rd2, %r0, %r5;
    div.u64         %rd2, %rd2, %rd3;
    cvt.u32.u64     %r5, %rd2;
    mov.f32         %f0, 0f00000000;
    mov.f32         %f1, 0f00000000;
ROWS:
    setp.ge.u32     %p0, %r4, %r5;
    @%p0 bra        REDUCE;
    shl.b32         %r6, %r4, 8;
    add.u32         %r6, %r6, %r1;
    mul.wide.u32    %rd4, %r6, 4;
    add.s64         %rd4, %rd0, %rd4;
    ld.global.nc.f32 %f2, [%rd4];
    add.f32         %f0, %f0, %f2;
    fma.rn.f32      %f1, %f2, %f2, %f1;
    add.u32         %r4, %r4, 1;
    bra.uni         ROWS;
REDUCE:
    shfl.sync.bfly.b32 %f2, %f0, 16, 31, 0xffffffff;
    add.f32         %f0, %f0, %f2;
    shfl.sync.bfly.b32 %f2, %f0, 8, 31, 0xffffffff;
    add.f32         %f0, %f0, %f2;
    shfl.sync.bfly.b32 %f2, %f0, 4, 31, 0xffffffff;
    add.f32         %f0, %f0, %f2;
    shfl.sync.bfly.b32 %f2, %f0, 2, 31, 0xffffffff;
    add.f32         %f0, %f0, %f2;
    shfl.sync.bfly.b32 %f2, %f0, 1, 31, 0xffffffff;
    add.f32         %f0, %f0, %f2;
    shfl.sync.bfly.b32 %f2, %f1, 16, 31, 0xffffffff;
    add.f32         %f1, %f1, %f2;
    shfl.sync.bfly.b32 %f2, %f1, 8, 31, 0xffffffff;
    add.f32         %f1, %f1, %f2;
    shfl.sync.bfly.b32 %f2, %f1, 4, 31, 0xffffffff;
    add.f32         %f1, %f1, %f2;
    shfl.sync.bfly.b32 %f2, %f1, 2, 31, 0xffffffff;
    add.f32         %f1, %f1, %f2;
    shfl.sync.bfly.b32 %f2, %f1, 1, 31, 0xffffffff;
    add.f32         %f1, %f1, %f2;
    and.b32         %r7, %r1, 31;
    setp.ne.u32     %p1, %r7, 0;
    @%p1 bra        DONE;
    shr.u32         %r8, %r1, 5;            // group
    mul.wide.u32    %rd5, %r8, 16;
    add.s64         %rd5, %rd1, %rd5;
    cvt.f64.f32     %d0, %f0;
    cvt.f64.f32     %d1, %f1;
    atom.global.add.f64 %d2, [%rd5], %d0;
    atom.global.add.f64 %d3, [%rd5+8], %d1;
DONE:
    ret;
}

// -----------------------------------------------------------------------------
// Kernel: gn_apply   y = relu((x - mean_g) / sqrt(var_g + eps) * w + b), the
//   GroupNorm (8 groups of 32 channels) + ReLU of the pixel decoder, from
//   gn_stats' sums. Outputs y32 f32 and / or y16 f16 (0 = skip). The 8
//   (mean, 1/std) pairs are computed once per block into shared memory.
//   One thread per 4 channels, grid-stride, block 256.
// -----------------------------------------------------------------------------
.visible .entry gn_apply(
    .param .u64 p_x,            // f32 [n][256]
    .param .u64 p_acc,          // f64 [8][2]
    .param .u64 p_w,            // f32 [256]
    .param .u64 p_b,
    .param .u64 p_y32,          // f32 [n][256] or 0 (may be x)
    .param .u64 p_y16,          // f16 [n][256] or 0
    .param .u32 p_n,
    .param .f32 p_eps
)
{
    .reg .pred  %p<4>;
    .reg .b32   %r<16>;
    .reg .b64   %rd<16>;
    .reg .f32   %f<20>;
    .reg .f64   %d<8>;
    .shared .align 8 .f32 st[16];           // mean, 1/std per group

    ld.param.u64    %rd0, [p_x];
    ld.param.u64    %rd1, [p_acc];
    ld.param.u64    %rd2, [p_w];
    ld.param.u64    %rd3, [p_b];
    ld.param.u64    %rd4, [p_y32];
    ld.param.u64    %rd5, [p_y16];
    ld.param.u32    %r0, [p_n];
    mov.u32         %r1, %tid.x;
    setp.ge.u32     %p0, %r1, 8;
    @%p0 bra        STATS_DONE;
    mul.wide.u32    %rd6, %r1, 16;
    add.s64         %rd6, %rd1, %rd6;
    ld.global.f64   %d0, [%rd6];
    ld.global.f64   %d1, [%rd6+8];
    cvt.rn.f64.u32  %d2, %r0;
    mul.f64         %d2, %d2, 0d4040000000000000;   // n * 32 values
    div.rn.f64      %d3, %d0, %d2;          // mean
    div.rn.f64      %d4, %d1, %d2;
    mul.f64         %d5, %d3, %d3;
    sub.f64         %d4, %d4, %d5;          // variance
    max.f64         %d4, %d4, 0d0000000000000000;
    cvt.rn.f32.f64  %f0, %d3;
    cvt.rn.f32.f64  %f1, %d4;
    ld.param.f32    %f2, [p_eps];
    add.f32         %f1, %f1, %f2;
    sqrt.rn.f32     %f1, %f1;
    rcp.rn.f32      %f1, %f1;
    mov.u32         %r2, st;
    shl.b32         %r3, %r1, 3;
    add.u32         %r2, %r2, %r3;
    st.shared.v2.f32 [%r2], {%f0, %f1};
STATS_DONE:
    bar.sync        0;
    setp.ne.u64     %p1, %rd4, 0;
    setp.ne.u64     %p2, %rd5, 0;
    shl.b32         %r4, %r0, 6;            // total float4s (n * 64)
    mov.u32         %r5, %ctaid.x;
    mov.u32         %r6, %ntid.x;
    mad.lo.u32      %r7, %r5, %r6, %r1;
    mov.u32         %r8, %nctaid.x;
    mul.lo.u32      %r8, %r8, %r6;
LOOP:
    setp.ge.u32     %p0, %r7, %r4;
    @%p0 bra        DONE;
    and.b32         %r9, %r7, 63;           // float4 in the row
    shr.u32         %r10, %r9, 3;           // group (8 float4s each)
    mov.u32         %r11, st;
    shl.b32         %r12, %r10, 3;
    add.u32         %r11, %r11, %r12;
    ld.shared.v2.f32 {%f0, %f1}, [%r11];
    mul.wide.u32    %rd7, %r7, 16;
    add.s64         %rd8, %rd0, %rd7;
    ld.global.v4.f32 {%f4, %f5, %f6, %f7}, [%rd8];
    mul.wide.u32    %rd9, %r9, 16;
    add.s64         %rd10, %rd2, %rd9;
    ld.global.nc.v4.f32 {%f8, %f9, %f10, %f11}, [%rd10];
    add.s64         %rd10, %rd3, %rd9;
    ld.global.nc.v4.f32 {%f12, %f13, %f14, %f15}, [%rd10];
    sub.f32         %f4, %f4, %f0;
    sub.f32         %f5, %f5, %f0;
    sub.f32         %f6, %f6, %f0;
    sub.f32         %f7, %f7, %f0;
    mul.f32         %f4, %f4, %f1;
    mul.f32         %f5, %f5, %f1;
    mul.f32         %f6, %f6, %f1;
    mul.f32         %f7, %f7, %f1;
    fma.rn.f32      %f4, %f4, %f8, %f12;
    fma.rn.f32      %f5, %f5, %f9, %f13;
    fma.rn.f32      %f6, %f6, %f10, %f14;
    fma.rn.f32      %f7, %f7, %f11, %f15;
    max.f32         %f4, %f4, 0f00000000;
    max.f32         %f5, %f5, 0f00000000;
    max.f32         %f6, %f6, 0f00000000;
    max.f32         %f7, %f7, 0f00000000;
    @!%p1 bra       HALF;
    add.s64         %rd11, %rd4, %rd7;
    st.global.v4.f32 [%rd11], {%f4, %f5, %f6, %f7};
HALF:
    @!%p2 bra       NEXT;
    cvt.rn.f16x2.f32 %r13, %f5, %f4;
    cvt.rn.f16x2.f32 %r14, %f7, %f6;
    mul.wide.u32    %rd12, %r7, 8;
    add.s64         %rd12, %rd5, %rd12;
    st.global.v2.b32 [%rd12], {%r13, %r14};
NEXT:
    add.u32         %r7, %r7, %r8;
    bra.uni         LOOP;
DONE:
    ret;
}

// -----------------------------------------------------------------------------
// Kernel: linear_small   y[m][n] = act(W[n] . x[m] + b[n]) in f32, one warp
//   per output: for the heads too narrow for gemm_f16 (box deltas, presence
//   logit, the pooled prompt, query scores). act: 0 none, 1 relu.
//   grid ceil(M * N / 8), block 256.
// -----------------------------------------------------------------------------
.visible .entry linear_small(
    .param .u64 p_x,            // f32 [M][ldx]
    .param .u32 p_ldx,
    .param .u64 p_w,            // f32 [N][K]
    .param .u64 p_b,            // f32 [N] or 0
    .param .u64 p_y,            // f32 [M][ldy] (out)
    .param .u32 p_ldy,
    .param .u32 p_m,
    .param .u32 p_n,
    .param .u32 p_k,
    .param .u32 p_act
)
{
    .reg .pred  %p<4>;
    .reg .b32   %r<20>;
    .reg .b64   %rd<12>;
    .reg .f32   %f<6>;

    mov.u32         %r0, %tid.x;
    and.b32         %r1, %r0, 31;
    shr.u32         %r2, %r0, 5;
    mov.u32         %r3, %ctaid.x;
    shl.b32         %r3, %r3, 3;
    add.u32         %r3, %r3, %r2;          // output index m * N + n
    ld.param.u32    %r4, [p_m];
    ld.param.u32    %r5, [p_n];
    ld.param.u32    %r6, [p_k];
    mul.lo.u32      %r7, %r4, %r5;
    setp.ge.u32     %p0, %r3, %r7;
    @%p0 bra        DONE;
    div.u32         %r8, %r3, %r5;          // m
    rem.u32         %r9, %r3, %r5;          // n
    ld.param.u64    %rd0, [p_x];
    ld.param.u32    %r10, [p_ldx];
    mul.lo.u32      %r11, %r8, %r10;
    mul.wide.u32    %rd1, %r11, 4;
    add.s64         %rd0, %rd0, %rd1;
    ld.param.u64    %rd2, [p_w];
    mul.lo.u32      %r12, %r9, %r6;
    mul.wide.u32    %rd3, %r12, 4;
    add.s64         %rd2, %rd2, %rd3;
    mov.f32         %f0, 0f00000000;
    mov.u32         %r13, %r1;
DOT:
    setp.ge.u32     %p1, %r13, %r6;
    @%p1 bra        RED;
    mul.wide.u32    %rd4, %r13, 4;
    add.s64         %rd5, %rd0, %rd4;
    ld.global.f32   %f1, [%rd5];
    add.s64         %rd6, %rd2, %rd4;
    ld.global.nc.f32 %f2, [%rd6];
    fma.rn.f32      %f0, %f1, %f2, %f0;
    add.u32         %r13, %r13, 32;
    bra.uni         DOT;
RED:
    shfl.sync.bfly.b32 %f1, %f0, 16, 31, 0xffffffff;
    add.f32         %f0, %f0, %f1;
    shfl.sync.bfly.b32 %f1, %f0, 8, 31, 0xffffffff;
    add.f32         %f0, %f0, %f1;
    shfl.sync.bfly.b32 %f1, %f0, 4, 31, 0xffffffff;
    add.f32         %f0, %f0, %f1;
    shfl.sync.bfly.b32 %f1, %f0, 2, 31, 0xffffffff;
    add.f32         %f0, %f0, %f1;
    shfl.sync.bfly.b32 %f1, %f0, 1, 31, 0xffffffff;
    add.f32         %f0, %f0, %f1;
    setp.ne.u32     %p2, %r1, 0;
    @%p2 bra        DONE;
    ld.param.u64    %rd7, [p_b];
    setp.eq.u64     %p3, %rd7, 0;
    @%p3 bra        ACT;
    mul.wide.u32    %rd8, %r9, 4;
    add.s64         %rd8, %rd7, %rd8;
    ld.global.nc.f32 %f1, [%rd8];
    add.f32         %f0, %f0, %f1;
ACT:
    ld.param.u32    %r14, [p_act];
    setp.ne.u32     %p3, %r14, 0;
    @%p3 max.f32    %f0, %f0, 0f00000000;
    ld.param.u64    %rd9, [p_y];
    ld.param.u32    %r15, [p_ldy];
    mad.lo.u32      %r16, %r8, %r15, %r9;
    mul.wide.u32    %rd10, %r16, 4;
    add.s64         %rd9, %rd9, %rd10;
    st.global.f32   [%rd9], %f0;
DONE:
    ret;
}

// -----------------------------------------------------------------------------
// Kernel: box_sine   the decoder's sine embedding of its reference boxes
//   (cx, cy, w, h in [0, 1]) for ref_point_head: 128 values for each of y, x,
//   w, h (that order), value i of coordinate v = sin(2 pi v / T_i) for even i,
//   cos for odd i, T_i = 10000^(2 floor(i / 2) / 128).
//   One thread per output, grid-stride.
// -----------------------------------------------------------------------------
.visible .entry box_sine(
    .param .u64 p_ref,          // f32 [Q][4]
    .param .u64 p_out,          // f16 [Q][512]
    .param .u32 p_q
)
{
    .reg .pred  %p<3>;
    .reg .b32   %r<16>;
    .reg .b64   %rd<6>;
    .reg .f32   %f<8>;
    .reg .b16   %h<2>;

    ld.param.u64    %rd0, [p_ref];
    ld.param.u64    %rd1, [p_out];
    ld.param.u32    %r0, [p_q];
    shl.b32         %r1, %r0, 9;            // total
    mov.u32         %r2, %ctaid.x;
    mov.u32         %r3, %ntid.x;
    mov.u32         %r4, %tid.x;
    mad.lo.u32      %r5, %r2, %r3, %r4;
    mov.u32         %r6, %nctaid.x;
    mul.lo.u32      %r6, %r6, %r3;
LOOP:
    setp.ge.u32     %p0, %r5, %r1;
    @%p0 bra        DONE;
    shr.u32         %r7, %r5, 9;            // query
    and.b32         %r8, %r5, 511;
    shr.u32         %r9, %r8, 7;            // block: 0 y, 1 x, 2 w, 3 h
    and.b32         %r10, %r8, 127;         // i
    // coordinate index: y -> 1, x -> 0, w -> 2, h -> 3
    setp.lt.u32     %p1, %r9, 2;
    xor.b32         %r11, %r9, 1;
    selp.b32        %r11, %r11, %r9, %p1;
    shl.b32         %r12, %r7, 2;
    add.u32         %r12, %r12, %r11;
    mul.wide.u32    %rd2, %r12, 4;
    add.s64         %rd2, %rd0, %rd2;
    ld.global.f32   %f0, [%rd2];
    mul.f32         %f0, %f0, 0f40C90FDB;   // * 2 pi
    and.b32         %r13, %r10, 126;        // 2 floor(i / 2)
    cvt.rn.f32.u32  %f1, %r13;
    mul.f32         %f1, %f1, 0f3C000000;   // / 128
    mul.f32         %f1, %f1, 0f41549A78;   // * log2(10000)
    neg.f32         %f1, %f1;
    ex2.approx.ftz.f32 %f1, %f1;            // 1 / T_i
    mul.f32         %f0, %f0, %f1;
    and.b32         %r14, %r10, 1;
    setp.eq.u32     %p2, %r14, 0;
    @%p2 sin.approx.ftz.f32 %f2, %f0;
    @!%p2 cos.approx.ftz.f32 %f2, %f0;
    cvt.rn.f16.f32  %h0, %f2;
    mul.wide.u32    %rd3, %r5, 2;
    add.s64         %rd3, %rd1, %rd3;
    st.global.b16   [%rd3], %h0;
    add.u32         %r5, %r5, %r6;
    bra.uni         LOOP;
DONE:
    ret;
}

// sign(8d) log2(|8d| + 1) / log2(8)
.func (.reg .f32 y) log_delta (.reg .f32 d)
{
    .reg .pred  %lp;
    .reg .f32   %l<3>;

    mul.f32         %l0, d, 0f41000000;
    abs.f32         %l1, %l0;
    add.f32         %l1, %l1, 0f3F800000;
    lg2.approx.f32  %l1, %l1;
    mul.f32         %l1, %l1, 0f3EAAAAAB;   // / 3
    setp.lt.f32     %lp, %l0, 0f00000000;
    @%lp neg.f32    %l1, %l1;
    setp.eq.f32     %lp, %l0, 0f00000000;
    @%lp mov.f32    %l1, 0f00000000;
    mov.f32         y, %l1;
    ret;
}

// -----------------------------------------------------------------------------
// Kernel: rpb_mlp   the decoder's box relative position bias ("boxRPB log"):
//   for query q's box (x0, y0, x1, y1) and key column i of the 72 x 72 grid
//   (coordinate i / 72), the deltas d = (i/72 - x0, i/72 - x1) are squashed
//   to sign(8d) log2(|8d| + 1) / 3 and mapped by an MLP 2 -> 256 (relu) -> 8
//   to one bias per head; rows likewise with y. flash_attn adds
//   by[h][q][row] + bx[h][q][column] to the score of a key.
//   One thread per (query, axis, i); query q writes row q + 1 of the outputs
//   (row 0 is the presence token: no bias, left zero).
// -----------------------------------------------------------------------------
.visible .entry rpb_mlp(
    .param .u64 p_ref,          // f32 [Q][4] cx, cy, w, h
    .param .u64 p_wx1,          // f32 [256][2], [256]
    .param .u64 p_bx1,
    .param .u64 p_wx2,          // f32 [8][256], [8]
    .param .u64 p_bx2,
    .param .u64 p_wy1,
    .param .u64 p_by1,
    .param .u64 p_wy2,
    .param .u64 p_by2,
    .param .u64 p_bx,           // f32 [8][Q+1][g] (out)
    .param .u64 p_by,
    .param .u32 p_q,
    .param .u32 p_g             // grid side (72)
)
{
    .reg .pred  %p<4>;
    .reg .b32   %r<24>;
    .reg .b64   %rd<20>;
    .reg .f32   %f<32>;

    ld.param.u32    %r0, [p_q];
    ld.param.u32    %r1, [p_g];
    mov.u32         %r2, %ctaid.x;
    mov.u32         %r3, %ntid.x;
    mov.u32         %r4, %tid.x;
    mad.lo.u32      %r5, %r2, %r3, %r4;
    mul.lo.u32      %r6, %r0, %r1;
    shl.b32         %r7, %r6, 1;
    setp.ge.u32     %p0, %r5, %r7;
    @%p0 bra        DONE;
    div.u32         %r8, %r5, %r6;          // axis: 0 x, 1 y
    rem.u32         %r9, %r5, %r6;
    div.u32         %r10, %r9, %r1;         // query
    rem.u32         %r11, %r9, %r1;         // i
    setp.eq.u32     %p1, %r8, 0;
    ld.param.u64    %rd0, [p_ref];
    shl.b32         %r12, %r10, 2;
    mul.wide.u32    %rd1, %r12, 4;
    add.s64         %rd0, %rd0, %rd1;
    ld.global.v4.f32 {%f0, %f1, %f2, %f3}, [%rd0];
    // centre and size along the axis
    selp.f32        %f4, %f0, %f1, %p1;
    selp.f32        %f5, %f2, %f3, %p1;
    mul.f32         %f5, %f5, 0f3F000000;
    sub.f32         %f6, %f4, %f5;          // lo edge
    add.f32         %f7, %f4, %f5;          // hi edge
    cvt.rn.f32.u32  %f8, %r11;
    cvt.rn.f32.u32  %f9, %r1;
    div.rn.f32      %f8, %f8, %f9;          // i / g
    sub.f32         %f10, %f8, %f6;
    sub.f32         %f11, %f8, %f7;
    call.uni        (%f10), log_delta, (%f10);
    call.uni        (%f11), log_delta, (%f11);
    // weights of this axis
    ld.param.u64    %rd2, [p_wx1];
    ld.param.u64    %rd3, [p_bx1];
    ld.param.u64    %rd4, [p_wx2];
    ld.param.u64    %rd5, [p_bx2];
    ld.param.u64    %rd6, [p_bx];
    @%p1 bra        AXIS_SET;
    ld.param.u64    %rd2, [p_wy1];
    ld.param.u64    %rd3, [p_by1];
    ld.param.u64    %rd4, [p_wy2];
    ld.param.u64    %rd5, [p_by2];
    ld.param.u64    %rd6, [p_by];
AXIS_SET:
    ld.global.nc.v4.f32 {%f12, %f13, %f14, %f15}, [%rd5];
    ld.global.nc.v4.f32 {%f16, %f17, %f18, %f19}, [%rd5+16];
    mov.u32         %r13, 0;
HIDDEN:
    mul.wide.u32    %rd7, %r13, 8;
    add.s64         %rd7, %rd2, %rd7;
    ld.global.nc.v2.f32 {%f20, %f21}, [%rd7];
    mul.wide.u32    %rd8, %r13, 4;
    add.s64         %rd9, %rd3, %rd8;
    ld.global.nc.f32 %f22, [%rd9];
    fma.rn.f32      %f22, %f20, %f10, %f22;
    fma.rn.f32      %f22, %f21, %f11, %f22;
    max.f32         %f22, %f22, 0f00000000; // hidden unit
    add.s64         %rd10, %rd4, %rd8;      // column of W2
    ld.global.nc.f32 %f23, [%rd10];
    fma.rn.f32      %f12, %f23, %f22, %f12;
    ld.global.nc.f32 %f23, [%rd10+1024];
    fma.rn.f32      %f13, %f23, %f22, %f13;
    ld.global.nc.f32 %f23, [%rd10+2048];
    fma.rn.f32      %f14, %f23, %f22, %f14;
    ld.global.nc.f32 %f23, [%rd10+3072];
    fma.rn.f32      %f15, %f23, %f22, %f15;
    ld.global.nc.f32 %f23, [%rd10+4096];
    fma.rn.f32      %f16, %f23, %f22, %f16;
    ld.global.nc.f32 %f23, [%rd10+5120];
    fma.rn.f32      %f17, %f23, %f22, %f17;
    ld.global.nc.f32 %f23, [%rd10+6144];
    fma.rn.f32      %f18, %f23, %f22, %f18;
    ld.global.nc.f32 %f23, [%rd10+7168];
    fma.rn.f32      %f19, %f23, %f22, %f19;
    add.u32         %r13, %r13, 1;
    setp.lt.u32     %p2, %r13, 256;
    @%p2 bra        HIDDEN;
    // out[h][q + 1][i], head stride (Q + 1) * g
    add.u32         %r14, %r10, 1;
    mad.lo.u32      %r14, %r14, %r1, %r11;
    mul.wide.u32    %rd11, %r14, 4;
    add.s64         %rd11, %rd6, %rd11;
    add.u32         %r15, %r0, 1;
    mul.lo.u32      %r15, %r15, %r1;
    mul.wide.u32    %rd12, %r15, 4;         // head stride in bytes
    st.global.f32   [%rd11], %f12;
    add.s64         %rd11, %rd11, %rd12;
    st.global.f32   [%rd11], %f13;
    add.s64         %rd11, %rd11, %rd12;
    st.global.f32   [%rd11], %f14;
    add.s64         %rd11, %rd11, %rd12;
    st.global.f32   [%rd11], %f15;
    add.s64         %rd11, %rd11, %rd12;
    st.global.f32   [%rd11], %f16;
    add.s64         %rd11, %rd11, %rd12;
    st.global.f32   [%rd11], %f17;
    add.s64         %rd11, %rd11, %rd12;
    st.global.f32   [%rd11], %f18;
    add.s64         %rd11, %rd11, %rd12;
    st.global.f32   [%rd11], %f19;
DONE:
    ret;
}

// -----------------------------------------------------------------------------
// Kernel: box_update   box refinement: ref = sigmoid(logit(ref) + delta),
//   logit(x) = log(max(x, 1e-3) / max(1 - x, 1e-3)) after clamping x to
//   [0, 1]. One thread per coordinate.
// -----------------------------------------------------------------------------
.visible .entry box_update(
    .param .u64 p_ref,          // f32 [n] (in place)
    .param .u64 p_delta,        // f32 [n]
    .param .u32 p_n
)
{
    .reg .pred  %p<2>;
    .reg .b32   %r<6>;
    .reg .b64   %rd<4>;
    .reg .f32   %f<8>;

    mov.u32         %r0, %ctaid.x;
    mov.u32         %r1, %ntid.x;
    mov.u32         %r2, %tid.x;
    mad.lo.u32      %r3, %r0, %r1, %r2;
    ld.param.u32    %r4, [p_n];
    setp.ge.u32     %p0, %r3, %r4;
    @%p0 bra        DONE;
    ld.param.u64    %rd0, [p_ref];
    ld.param.u64    %rd1, [p_delta];
    mul.wide.u32    %rd2, %r3, 4;
    add.s64         %rd0, %rd0, %rd2;
    add.s64         %rd1, %rd1, %rd2;
    ld.global.f32   %f0, [%rd0];
    ld.global.f32   %f1, [%rd1];
    cvt.sat.f32.f32 %f0, %f0;               // clamp to [0, 1]
    max.f32         %f2, %f0, 0f3A83126F;   // max(x, 1e-3)
    sub.f32         %f3, 0f3F800000, %f0;
    max.f32         %f3, %f3, 0f3A83126F;
    div.rn.f32      %f2, %f2, %f3;
    lg2.approx.f32  %f2, %f2;
    mul.f32         %f2, %f2, 0f3F317218;   // ln
    add.f32         %f2, %f2, %f1;
    // sigmoid(z) = 1 / (1 + 2^(-z log2 e))
    mul.f32         %f4, %f2, 0fBFB8AA3B;
    ex2.approx.ftz.f32 %f4, %f4;
    add.f32         %f4, %f4, 0f3F800000;
    rcp.rn.f32      %f4, %f4;
    st.global.f32   [%rd0], %f4;
DONE:
    ret;
}

// -----------------------------------------------------------------------------
// Kernel: masked_mean   y[c] = mean of x[l][c] over the rows l with mask[l]
//   == 0 (the prompt tokens that are not padding). One thread per channel.
// -----------------------------------------------------------------------------
.visible .entry masked_mean(
    .param .u64 p_x,            // f32 [L][C]
    .param .u64 p_mask,         // u8 [L], 1 = padding
    .param .u64 p_y,            // f32 [C] (out)
    .param .u32 p_l,
    .param .u32 p_c
)
{
    .reg .pred  %p<3>;
    .reg .b32   %r<10>;
    .reg .b64   %rd<8>;
    .reg .f32   %f<4>;
    .reg .b16   %h;

    mov.u32         %r0, %ctaid.x;
    mov.u32         %r1, %ntid.x;
    mov.u32         %r2, %tid.x;
    mad.lo.u32      %r3, %r0, %r1, %r2;     // channel
    ld.param.u32    %r4, [p_c];
    setp.ge.u32     %p0, %r3, %r4;
    @%p0 bra        DONE;
    ld.param.u64    %rd0, [p_x];
    ld.param.u64    %rd1, [p_mask];
    ld.param.u32    %r5, [p_l];
    mov.f32         %f0, 0f00000000;
    mov.f32         %f1, 0f00000000;        // count
    mov.u32         %r6, 0;
ROW:
    setp.ge.u32     %p1, %r6, %r5;
    @%p1 bra        MEAN;
    cvt.u64.u32     %rd2, %r6;
    add.s64         %rd2, %rd1, %rd2;
    ld.global.u8    %h, [%rd2];
    setp.ne.u16     %p2, %h, 0;
    @%p2 bra        ROW_NEXT;
    mad.lo.u32      %r7, %r6, %r4, %r3;
    mul.wide.u32    %rd3, %r7, 4;
    add.s64         %rd3, %rd0, %rd3;
    ld.global.f32   %f2, [%rd3];
    add.f32         %f0, %f0, %f2;
    add.f32         %f1, %f1, 0f3F800000;
ROW_NEXT:
    add.u32         %r6, %r6, 1;
    bra.uni         ROW;
MEAN:
    max.f32         %f1, %f1, 0f3F800000;
    div.rn.f32      %f0, %f0, %f1;
    ld.param.u64    %rd4, [p_y];
    mul.wide.u32    %rd5, %r3, 4;
    add.s64         %rd4, %rd4, %rd5;
    st.global.f32   [%rd4], %f0;
DONE:
    ret;
}

// -----------------------------------------------------------------------------
// Kernel: mask_resize   the masks of the kept queries at the image size:
//   bilinear (align_corners = False, as F.interpolate) from s x s mask logits,
//   then mask = logit > 0 (sigmoid > 0.5). One thread per output pixel.
// -----------------------------------------------------------------------------
.visible .entry mask_resize(
    .param .u64 p_logits,       // f32 [Q][s*s]
    .param .u64 p_sel,          // u32 [n] query of each output mask
    .param .u64 p_out,          // u8 [n][h][w] (out)
    .param .u32 p_n,
    .param .u32 p_s,
    .param .u32 p_h,
    .param .u32 p_w
)
{
    .reg .pred  %p<3>;
    .reg .b32   %r<24>;
    .reg .b64   %rd<8>;
    .reg .f32   %f<20>;
    .reg .b16   %hb;

    ld.param.u32    %r0, [p_n];
    ld.param.u32    %r1, [p_s];
    ld.param.u32    %r2, [p_h];
    ld.param.u32    %r3, [p_w];
    mul.lo.u32      %r4, %r2, %r3;          // pixels per mask
    mul.lo.u32      %r5, %r4, %r0;
    mov.u32         %r6, %ctaid.x;
    mov.u32         %r7, %ntid.x;
    mov.u32         %r8, %tid.x;
    mad.lo.u32      %r9, %r6, %r7, %r8;
    mov.u32         %r10, %nctaid.x;
    mul.lo.u32      %r10, %r10, %r7;
    cvt.rn.f32.u32  %f0, %r1;
    cvt.rn.f32.u32  %f1, %r2;
    cvt.rn.f32.u32  %f2, %r3;
    div.rn.f32      %f3, %f0, %f1;          // row scale s / h
    div.rn.f32      %f4, %f0, %f2;          // column scale s / w
    sub.u32         %r11, %r1, 1;
    ld.param.u64    %rd0, [p_logits];
    ld.param.u64    %rd1, [p_sel];
    ld.param.u64    %rd2, [p_out];
LOOP:
    setp.ge.u32     %p0, %r9, %r5;
    @%p0 bra        DONE;
    div.u32         %r12, %r9, %r4;         // mask
    rem.u32         %r13, %r9, %r4;
    div.u32         %r14, %r13, %r3;        // y
    rem.u32         %r15, %r13, %r3;        // x
    mul.wide.u32    %rd3, %r12, 4;
    add.s64         %rd3, %rd1, %rd3;
    ld.global.u32   %r16, [%rd3];
    mul.lo.u32      %r17, %r1, %r1;
    mul.lo.u32      %r16, %r16, %r17;
    mul.wide.u32    %rd4, %r16, 4;
    add.s64         %rd4, %rd0, %rd4;       // this query's logits
    // source row: max(0, (y + 0.5) s / h - 0.5)
    cvt.rn.f32.u32  %f5, %r14;
    add.f32         %f5, %f5, 0f3F000000;
    mul.f32         %f5, %f5, %f3;
    sub.f32         %f5, %f5, 0f3F000000;
    max.f32         %f5, %f5, 0f00000000;
    cvt.rmi.u32.f32 %r18, %f5;
    min.u32         %r18, %r18, %r11;
    cvt.rn.f32.u32  %f6, %r18;
    sub.f32         %f6, %f5, %f6;          // row weight
    setp.lt.u32     %p1, %r18, %r11;
    selp.u32        %r19, 1, 0, %p1;
    add.u32         %r19, %r18, %r19;       // next row
    cvt.rn.f32.u32  %f7, %r15;
    add.f32         %f7, %f7, 0f3F000000;
    mul.f32         %f7, %f7, %f4;
    sub.f32         %f7, %f7, 0f3F000000;
    max.f32         %f7, %f7, 0f00000000;
    cvt.rmi.u32.f32 %r20, %f7;
    min.u32         %r20, %r20, %r11;
    cvt.rn.f32.u32  %f8, %r20;
    sub.f32         %f8, %f7, %f8;          // column weight
    setp.lt.u32     %p2, %r20, %r11;
    selp.u32        %r21, 1, 0, %p2;
    add.u32         %r21, %r20, %r21;
    mad.lo.u32      %r22, %r18, %r1, %r20;
    mul.wide.u32    %rd5, %r22, 4;
    add.s64         %rd5, %rd4, %rd5;
    ld.global.nc.f32 %f9, [%rd5];           // (y0, x0)
    sub.u32         %r23, %r21, %r20;
    mul.wide.u32    %rd6, %r23, 4;
    add.s64         %rd6, %rd5, %rd6;
    ld.global.nc.f32 %f10, [%rd6];          // (y0, x1)
    mad.lo.u32      %r22, %r19, %r1, %r20;
    mul.wide.u32    %rd5, %r22, 4;
    add.s64         %rd5, %rd4, %rd5;
    ld.global.nc.f32 %f11, [%rd5];          // (y1, x0)
    mul.wide.u32    %rd7, %r23, 4;
    add.s64         %rd6, %rd5, %rd7;
    ld.global.nc.f32 %f12, [%rd6];          // (y1, x1)
    sub.f32         %f13, 0f3F800000, %f8;
    mul.f32         %f14, %f9, %f13;
    fma.rn.f32      %f14, %f10, %f8, %f14;  // top row
    mul.f32         %f15, %f11, %f13;
    fma.rn.f32      %f15, %f12, %f8, %f15;  // bottom row
    sub.f32         %f16, 0f3F800000, %f6;
    mul.f32         %f17, %f14, %f16;
    fma.rn.f32      %f17, %f15, %f6, %f17;
    setp.gt.f32     %p1, %f17, 0f00000000;
    selp.u16        %hb, 1, 0, %p1;
    cvt.u64.u32     %rd7, %r9;
    add.s64         %rd7, %rd2, %rd7;
    st.global.u8    [%rd7], %hb;
    add.u32         %r9, %r9, %r10;
    bra.uni         LOOP;
DONE:
    ret;
}

// -----------------------------------------------------------------------------
// Kernel: f32_to_f16   dst = f16(src), n elements (even); weights at load.
// -----------------------------------------------------------------------------
.visible .entry f32_to_f16(
    .param .u64 p_src,          // f32 [n]
    .param .u64 p_dst,          // f16 [n]
    .param .u32 p_n
)
{
    .reg .pred  %p<2>;
    .reg .b32   %r<8>;
    .reg .b64   %rd<6>;
    .reg .f32   %f<2>;

    ld.param.u64    %rd0, [p_src];
    ld.param.u64    %rd1, [p_dst];
    ld.param.u32    %r0, [p_n];
    shr.u32         %r0, %r0, 1;
    mov.u32         %r1, %ctaid.x;
    mov.u32         %r2, %ntid.x;
    mov.u32         %r3, %tid.x;
    mad.lo.u32      %r4, %r1, %r2, %r3;
    mov.u32         %r5, %nctaid.x;
    mul.lo.u32      %r5, %r5, %r2;
LOOP:
    setp.ge.u32     %p0, %r4, %r0;
    @%p0 bra        DONE;
    mul.wide.u32    %rd2, %r4, 8;
    add.s64         %rd2, %rd0, %rd2;
    ld.global.nc.v2.f32 {%f0, %f1}, [%rd2];
    cvt.rn.f16x2.f32 %r6, %f1, %f0;
    mul.wide.u32    %rd3, %r4, 4;
    add.s64         %rd3, %rd1, %rd3;
    st.global.b32   [%rd3], %r6;
    add.u32         %r4, %r4, %r5;
    bra.uni         LOOP;
DONE:
    ret;
}
