//
// llama31.ptx - hand-written PTX kernels for Llama 3.1 (dense, text)
// inference, made for Llama-3.1-8B-Instruct.
//
// The host (llama31.c) runs a layer as (T tokens at a time; sizes for the 8B:
// 32 q heads, 8 kv heads, 128 dims):
//
//   xn = rmsnorm(x) * attn_norm                     rmsnorm, quant_q8
//   q, k, v = Wqkv . xn  (4096 | 1024 | 1024)       mv_q / gemm_q
//   q, k = RoPE (adjacent pairs, Llama 3 freqs)     rope_kv (k, v also to the
//                                                     f16 KV cache)
//   y = Wo . softmax(q K^T / sqrt(128)) V           attention, quant_q8, mv/gemm
//   x += y                                          (the matrix kernels' resid)
//   xn = rmsnorm(x) * ffn_norm
//   g|u = [Wgate; Wup] . xn, h = silu(g) * u        mv/gemm, swiglu
//   x += Wdown . h                                  mv/gemm
//
// and finally logits = Wout . rmsnorm(x) * output_norm, next = argmax.
//
// Weights are ggml's quantized blocks (see quant.h); a matrix is a q array
// and (for some types) an s array, each [rows][a fixed number of bytes per
// row], laid out so that every load is aligned:
//   Q8_0:   q int8 [cols], s = d f16 [cols/32]
//   Q4_1:   q = qs [cols/32][16], s = dm f16x2 [cols/32]
//   IQ4_NL: q = qs [cols/32][16], s = d f16 [cols/32]
//   Q4_K, Q5_K, IQ4_XS: the 144 / 176 / 136-byte blocks as stored [cols/256]
//   Q6_K:   q = ql | qh | scales (208 bytes) [cols/256], s = d f16 [cols/256]
//   Q3_K:   the 110-byte blocks padded to 112 [cols/256]
//   IQ3_S:  112-byte blocks [cols/256], fields reordered: qs[64] signs[32]
//           qh[8] scales[4] d, 2 bytes padding
// The 8B Q8_0 file needs only Q8_0; the other formats let the engine run
// other quantizations of the model (Q4_K_M, IQ4_XS, ...).
// Activations entering a matrix are quantized to int8 in blocks of 32 (as
// llama.cpp does): xq int8 [n] and xds f32x2 [n/32] = {d, d * sum_j q_j}. A
// weight block with half scales s_0, s_1 and offset m (w = s_h q + m) then
// contributes
//   d_x (s_0 dot(q_w, q_x)_0 + s_1 dot(q_w, q_x)_1) + m d_x sum(q_x)
// with exact integer dot products (dp4a in the matrix-vector kernel, int8
// tensor-core mma in the GEMM).
//

.version 8.0
.target sm_89            // Ada Lovelace (RTX 40xx)
.address_size 64

// -----------------------------------------------------------------------------
// Kernel: rmsnorm   y[i] = x[i] / sqrt(mean(x^2) + eps) * w[i]
//   One block (any multiple of 32 threads up to 1024) per row of n values;
//   gridDim.x = number of rows (tokens).
// -----------------------------------------------------------------------------
.visible .entry rmsnorm(
    .param .u64 p_x,            // f32 [n]
    .param .u64 p_w,            // f32 [n]
    .param .u64 p_y,            // f32 [n] (out)
    .param .u32 p_n,
    .param .f32 p_eps
)
{
    .reg .pred  %p<4>;
    .reg .b32   %r<16>;
    .reg .f32   %f<16>;
    .reg .b64   %rd<12>;
    .shared .align 4 .f32 rms_red[32];

    ld.param.u64        %rd1, [p_x];
    ld.param.u64        %rd2, [p_w];
    ld.param.u64        %rd3, [p_y];
    ld.param.u32        %r1,  [p_n];
    ld.param.f32        %f1,  [p_eps];
    cvta.to.global.u64  %rd1, %rd1;
    cvta.to.global.u64  %rd2, %rd2;
    cvta.to.global.u64  %rd3, %rd3;
    mov.u32             %r12, %ctaid.x;         // row
    mul.wide.u32        %rd8, %r12, %r1;
    shl.b64             %rd8, %rd8, 2;
    add.s64             %rd1, %rd1, %rd8;
    add.s64             %rd3, %rd3, %rd8;
    mov.u32             %r2, %tid.x;
    mov.u32             %r3, %ntid.x;

    mov.f32             %f2, 0f00000000;
    mov.u32             %r4, %r2;
SUMSQ:
    setp.ge.u32         %p1, %r4, %r1;
    @%p1 bra            SUMSQ_DONE;
    mul.wide.u32        %rd4, %r4, 4;
    add.s64             %rd5, %rd1, %rd4;
    ld.global.f32       %f3, [%rd5];
    fma.rn.f32          %f2, %f3, %f3, %f2;
    add.u32             %r4, %r4, %r3;
    bra.uni             SUMSQ;
SUMSQ_DONE:
    shfl.sync.bfly.b32  %f3, %f2, 16, 31, -1;
    add.f32             %f2, %f2, %f3;
    shfl.sync.bfly.b32  %f3, %f2, 8, 31, -1;
    add.f32             %f2, %f2, %f3;
    shfl.sync.bfly.b32  %f3, %f2, 4, 31, -1;
    add.f32             %f2, %f2, %f3;
    shfl.sync.bfly.b32  %f3, %f2, 2, 31, -1;
    add.f32             %f2, %f2, %f3;
    shfl.sync.bfly.b32  %f3, %f2, 1, 31, -1;
    add.f32             %f2, %f2, %f3;

    and.b32             %r5, %r2, 31;           // lane
    shr.u32             %r6, %r2, 5;            // warp
    mov.u32             %r7, rms_red;
    setp.ne.u32         %p2, %r5, 0;
    shl.b32             %r8, %r6, 2;
    add.u32             %r8, %r7, %r8;
    @!%p2 st.shared.f32 [%r8], %f2;
    bar.sync            0;

    // every thread adds up the per-warp partial sums
    shr.u32             %r9, %r3, 5;            // number of warps
    mov.f32             %f4, 0f00000000;
    mov.u32             %r10, 0;
WSUM:
    setp.ge.u32         %p3, %r10, %r9;
    @%p3 bra            WSUM_DONE;
    shl.b32             %r11, %r10, 2;
    add.u32             %r11, %r7, %r11;
    ld.shared.f32       %f5, [%r11];
    add.f32             %f4, %f4, %f5;
    add.u32             %r10, %r10, 1;
    bra.uni             WSUM;
WSUM_DONE:
    cvt.rn.f32.u32      %f6, %r1;
    div.rn.f32          %f7, %f4, %f6;          // mean(x^2)
    add.f32             %f7, %f7, %f1;
    sqrt.rn.f32         %f8, %f7;
    rcp.rn.f32          %f9, %f8;               // scale

    mov.u32             %r4, %r2;
SCALE:
    setp.ge.u32         %p1, %r4, %r1;
    @%p1 bra            DONE;
    mul.wide.u32        %rd4, %r4, 4;
    add.s64             %rd5, %rd1, %rd4;
    add.s64             %rd6, %rd2, %rd4;
    add.s64             %rd7, %rd3, %rd4;
    ld.global.f32       %f10, [%rd5];
    ld.global.f32       %f11, [%rd6];
    mul.f32             %f12, %f10, %f9;
    mul.f32             %f12, %f12, %f11;
    st.global.f32       [%rd7], %f12;
    add.u32             %r4, %r4, %r3;
    bra.uni             SCALE;
DONE:
    ret;
}

// -----------------------------------------------------------------------------
// Kernel: quant_q8   blocks of 32 floats -> int8 q[i] = round(x[i] / d),
//                    d = max|x| / 127 per block; ds[b] = {d, d * sum_j q_j}
//   One warp per block (lane = element), grid-stride over blocks.
// -----------------------------------------------------------------------------
.visible .entry quant_q8(
    .param .u64 p_x,            // f32 [nblk*32]
    .param .u64 p_q,            // s8  [nblk*32] (out)
    .param .u64 p_ds,           // f32x2 [nblk]  (out)
    .param .u32 p_nblk
)
{
    .reg .pred  %p<4>;
    .reg .b32   %r<16>;
    .reg .f32   %f<12>;
    .reg .b64   %rd<12>;

    ld.param.u64        %rd1, [p_x];
    ld.param.u64        %rd2, [p_q];
    ld.param.u64        %rd3, [p_ds];
    ld.param.u32        %r1,  [p_nblk];
    cvta.to.global.u64  %rd1, %rd1;
    cvta.to.global.u64  %rd2, %rd2;
    cvta.to.global.u64  %rd3, %rd3;

    mov.u32             %r2, %tid.x;
    mov.u32             %r3, %ntid.x;
    mov.u32             %r4, %ctaid.x;
    mov.u32             %r5, %nctaid.x;
    and.b32             %r6, %r2, 31;           // lane
    mad.lo.u32          %r7, %r4, %r3, %r2;
    shr.u32             %r7, %r7, 5;            // global warp = block index
    mul.lo.u32          %r8, %r5, %r3;
    shr.u32             %r8, %r8, 5;            // warps in grid
    setp.eq.u32         %p2, %r6, 0;

LOOP:
    setp.ge.u32         %p1, %r7, %r1;          // warp-uniform
    @%p1 bra            DONE;
    shl.b32             %r9, %r7, 5;
    add.u32             %r9, %r9, %r6;          // element
    mul.wide.u32        %rd4, %r9, 4;
    add.s64             %rd5, %rd1, %rd4;
    ld.global.f32       %f1, [%rd5];
    abs.f32             %f2, %f1;
    shfl.sync.bfly.b32  %f3, %f2, 16, 31, -1;
    max.f32             %f2, %f2, %f3;
    shfl.sync.bfly.b32  %f3, %f2, 8, 31, -1;
    max.f32             %f2, %f2, %f3;
    shfl.sync.bfly.b32  %f3, %f2, 4, 31, -1;
    max.f32             %f2, %f2, %f3;
    shfl.sync.bfly.b32  %f3, %f2, 2, 31, -1;
    max.f32             %f2, %f2, %f3;
    shfl.sync.bfly.b32  %f3, %f2, 1, 31, -1;
    max.f32             %f2, %f2, %f3;
    div.rn.f32          %f4, %f2, 0f42FE0000;   // d = amax / 127
    setp.gt.f32         %p3, %f4, 0f00000000;
    rcp.rn.f32          %f5, %f4;
    selp.f32            %f5, %f5, 0f00000000, %p3;
    mul.f32             %f6, %f1, %f5;
    cvt.rni.s32.f32     %r10, %f6;
    cvt.u64.u32         %rd6, %r9;
    add.s64             %rd7, %rd2, %rd6;
    st.global.u8        [%rd7], %r10;
    // sum of the block's q
    shfl.sync.bfly.b32  %r11, %r10, 16, 31, -1;
    add.s32             %r10, %r10, %r11;
    shfl.sync.bfly.b32  %r11, %r10, 8, 31, -1;
    add.s32             %r10, %r10, %r11;
    shfl.sync.bfly.b32  %r11, %r10, 4, 31, -1;
    add.s32             %r10, %r10, %r11;
    shfl.sync.bfly.b32  %r11, %r10, 2, 31, -1;
    add.s32             %r10, %r10, %r11;
    shfl.sync.bfly.b32  %r11, %r10, 1, 31, -1;
    add.s32             %r10, %r10, %r11;
    @!%p2 bra           NEXT;
    cvt.rn.f32.s32      %f7, %r10;
    mul.f32             %f7, %f7, %f4;
    mul.wide.u32        %rd8, %r7, 8;
    add.s64             %rd9, %rd3, %rd8;
    st.global.v2.f32    [%rd9], {%f4, %f7};
NEXT:
    add.u32             %r7, %r7, %r8;
    bra.uni             LOOP;
DONE:
    ret;
}

// =============================================================================
// Weight decoding. unpack16 turns 16 weights of a row into int8 with a scale
// (and, per 32 values, an offset), whatever the row's ggml type; the
// matrix-vector kernel and the GEMM both go through it, so they read every
// format the same way. Value i of a 32-value block is
//   w_i = s_h q_i + m      (h = i / 16: the two halves may have different
//                           scales, as in Q3_K / Q6_K; m is 0 except for Q4_1,
//                           Q4_K and Q5_K)
// with q_i a signed 8-bit integer.
// =============================================================================

// IQ3_S grid (ggml-common.h iq3s_grid): entry i = 4 unsigned magnitudes, byte j = value j
.global .align 16 .u32 iq3s_grid[512] = {
    0x01010101, 0x01010103, 0x01010105, 0x0101010b, 0x0101010f, 0x01010301, 0x01010303, 0x01010305,
    0x01010309, 0x0101030d, 0x01010501, 0x01010503, 0x0101050b, 0x01010707, 0x01010901, 0x01010905,
    0x0101090b, 0x0101090f, 0x01010b03, 0x01010b07, 0x01010d01, 0x01010d05, 0x01010f03, 0x01010f09,
    0x01010f0f, 0x01030101, 0x01030103, 0x01030105, 0x01030109, 0x01030301, 0x01030303, 0x0103030b,
    0x01030501, 0x01030507, 0x0103050f, 0x01030703, 0x0103070b, 0x01030909, 0x01030d03, 0x01030d0b,
    0x01030f05, 0x01050101, 0x01050103, 0x0105010b, 0x0105010f, 0x01050301, 0x01050307, 0x0105030d,
    0x01050503, 0x0105050b, 0x01050701, 0x01050709, 0x01050905, 0x0105090b, 0x0105090f, 0x01050b03,
    0x01050b07, 0x01050f01, 0x01050f07, 0x01070107, 0x01070303, 0x0107030b, 0x01070501, 0x01070505,
    0x01070703, 0x01070707, 0x0107070d, 0x01070909, 0x01070b01, 0x01070b05, 0x01070d0f, 0x01070f03,
    0x01070f0b, 0x01090101, 0x01090307, 0x0109030f, 0x01090503, 0x01090509, 0x01090705, 0x01090901,
    0x01090907, 0x01090b03, 0x01090f01, 0x010b0105, 0x010b0109, 0x010b0501, 0x010b0505, 0x010b050d,
    0x010b0707, 0x010b0903, 0x010b090b, 0x010b090f, 0x010b0d0d, 0x010b0f07, 0x010d010d, 0x010d0303,
    0x010d0307, 0x010d0703, 0x010d0b05, 0x010d0f03, 0x010f0101, 0x010f0105, 0x010f0109, 0x010f0501,
    0x010f0505, 0x010f050d, 0x010f0707, 0x010f0b01, 0x010f0b09, 0x03010101, 0x03010103, 0x03010105,
    0x03010109, 0x03010301, 0x03010303, 0x03010307, 0x0301030b, 0x0301030f, 0x03010501, 0x03010505,
    0x03010703, 0x03010709, 0x0301070d, 0x03010b09, 0x03010b0d, 0x03010d03, 0x03010f05, 0x03030101,
    0x03030103, 0x03030107, 0x0303010d, 0x03030301, 0x03030309, 0x03030503, 0x03030701, 0x03030707,
    0x03030903, 0x03030b01, 0x03030b05, 0x03030f01, 0x03030f0d, 0x03050101, 0x03050305, 0x0305030b,
    0x0305030f, 0x03050501, 0x03050509, 0x03050705, 0x03050901, 0x03050907, 0x03050b0b, 0x03050d01,
    0x03050f05, 0x03070103, 0x03070109, 0x0307010f, 0x03070301, 0x03070307, 0x03070503, 0x0307050f,
    0x03070701, 0x03070709, 0x03070903, 0x03070d05, 0x03070f01, 0x03090107, 0x0309010b, 0x03090305,
    0x03090309, 0x03090703, 0x03090707, 0x03090905, 0x0309090d, 0x03090b01, 0x03090b09, 0x030b0103,
    0x030b0301, 0x030b0307, 0x030b0503, 0x030b0701, 0x030b0705, 0x030b0b03, 0x030d0501, 0x030d0509,
    0x030d050f, 0x030d0909, 0x030d090d, 0x030f0103, 0x030f0107, 0x030f0301, 0x030f0305, 0x030f0503,
    0x030f070b, 0x030f0903, 0x030f0d05, 0x030f0f01, 0x05010101, 0x05010103, 0x05010107, 0x0501010b,
    0x0501010f, 0x05010301, 0x05010305, 0x05010309, 0x0501030d, 0x05010503, 0x05010507, 0x0501050f,
