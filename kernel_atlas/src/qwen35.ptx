//
// qwen35.ptx - hand-written PTX kernels for Qwen 3.5 (dense, text) inference.
//
// The model is a hybrid: of every 4 layers, 3 are Gated DeltaNet layers
// (linear attention with a 128 x 128 recurrent state per head) and the 4th is
// a gated full-attention layer. The host (qwen35.c) runs a layer as (T tokens
// at a time):
//
//   xn = rmsnorm(x) * attn_norm                     rmsnorm, quant_q8
//   linear-attention layer:
//     qkv | z = Wqkvz . xn   (8192 | 4096)          mv_* / gemm_q
//     beta | alpha = Wba . xn  (32 | 32)            mv_* / gemm_q
//     q|k|v = silu(causal conv1d over the last 4    gdn_conv (q, k heads also
//             tokens' qkv), per channel               L2-normalized), conv_save
//     per v head h (32, 128 dims; k head h % 16):   gdn_recur
//       g = exp(softplus(alpha + dt_bias) * a), b = sigmoid(beta)
//       S = g S + k ((v - g S^T k) b)^T,  o = S^T q / sqrt(128)
//     y = Wout . (rmsnorm(o) * ssm_norm * silu(z))  gated_norm, quant_q8, mv/gemm
//   full-attention layer (16 q heads, 4 kv heads, 256 dims):
//     q|gate, k, v = Wqkv . xn                      mv_* / gemm_q
//     q, k = rmsnorm(head) * q|k_norm, RoPE on      qk_norm_rope (k, v also to
//            the first 64 dims                        the f16 KV cache)
//     y = Wo . (softmax(q K^T / 16) V * sigmoid(gate))   attention, quant_q8, mv/gemm
//   x += y                                          (the matrix kernels' resid)
//   xn = rmsnorm(x) * post_attention_norm
//   g|u = [Wgate; Wup] . xn, h = silu(g) * u        mv/gemm, swiglu
//   x += Wdown . h                                  mv/gemm
//
// and finally logits = Wout . rmsnorm(x) * output_norm, next = argmax.
//
// Weights are ggml's quantized blocks (see quant.h) with the fields of the
// 32-value types in separate arrays so every load is aligned:
//   Q8_0: q int8 [rows][cols], d f16 [rows][cols/32]
//   Q4_1: qs u8 [rows][cols/2] (16 bytes per block), dm f16x2 [rows][cols/32]
//   Q5_K: the 176-byte blocks as stored, [rows][cols/256]
//   Q6_K: ql | qh | scales (208 bytes) [rows][cols/256], d f16 [rows][cols/256]
// Activations entering a matrix are quantized to int8 in blocks of 32 (as
// llama.cpp does): xq int8 [n] and xds f32x2 [n/32] = {d, d * sum_j q_j}. A
// weight block with scale s and offset m (w = s q + m) then contributes
//   s d_x dot(q_w, q_x) + m d_x sum(q_x)
// with exact integer dot products (dp4a in the matrix-vector kernels, int8
// tensor-core mma in the GEMM).
//

.version 8.0
.target sm_89            // Ada Lovelace (RTX 40xx)
.address_size 64

// -----------------------------------------------------------------------------
// Kernel: rmsnorm   y[i] = x[i] / sqrt(mean(x^2) + eps) * w[i]
//   One block (any multiple of 32 threads up to 1024) per row of n values;
//   gridDim.x = number of rows (tokens).
// -----------------------------------------------------------------------------
.visible .entry rmsnorm(
    .param .u64 p_x,            // f32 [n]
    .param .u64 p_w,            // f32 [n]
    .param .u64 p_y,            // f32 [n] (out)
    .param .u32 p_n,
    .param .f32 p_eps
)
{
    .reg .pred  %p<4>;
    .reg .b32   %r<16>;
    .reg .f32   %f<16>;
    .reg .b64   %rd<12>;
    .shared .align 4 .f32 rms_red[32];

    ld.param.u64        %rd1, [p_x];
    ld.param.u64        %rd2, [p_w];
    ld.param.u64        %rd3, [p_y];
    ld.param.u32        %r1,  [p_n];
    ld.param.f32        %f1,  [p_eps];
    cvta.to.global.u64  %rd1, %rd1;
    cvta.to.global.u64  %rd2, %rd2;
    cvta.to.global.u64  %rd3, %rd3;
    mov.u32             %r12, %ctaid.x;         // row
    mul.wide.u32        %rd8, %r12, %r1;
    shl.b64             %rd8, %rd8, 2;
    add.s64             %rd1, %rd1, %rd8;
    add.s64             %rd3, %rd3, %rd8;
    mov.u32             %r2, %tid.x;
    mov.u32             %r3, %ntid.x;

    mov.f32             %f2, 0f00000000;
    mov.u32             %r4, %r2;
SUMSQ:
    setp.ge.u32         %p1, %r4, %r1;
    @%p1 bra            SUMSQ_DONE;
    mul.wide.u32        %rd4, %r4, 4;
    add.s64             %rd5, %rd1, %rd4;
    ld.global.f32       %f3, [%rd5];
    fma.rn.f32          %f2, %f3, %f3, %f2;
    add.u32             %r4, %r4, %r3;
    bra.uni             SUMSQ;
SUMSQ_DONE:
    shfl.sync.bfly.b32  %f3, %f2, 16, 31, -1;
    add.f32             %f2, %f2, %f3;
    shfl.sync.bfly.b32  %f3, %f2, 8, 31, -1;
    add.f32             %f2, %f2, %f3;
    shfl.sync.bfly.b32  %f3, %f2, 4, 31, -1;
    add.f32             %f2, %f2, %f3;
    shfl.sync.bfly.b32  %f3, %f2, 2, 31, -1;
    add.f32             %f2, %f2, %f3;
    shfl.sync.bfly.b32  %f3, %f2, 1, 31, -1;
    add.f32             %f2, %f2, %f3;

    and.b32             %r5, %r2, 31;           // lane
    shr.u32             %r6, %r2, 5;            // warp
    mov.u32             %r7, rms_red;
    setp.ne.u32         %p2, %r5, 0;
    shl.b32             %r8, %r6, 2;
    add.u32             %r8, %r7, %r8;
    @!%p2 st.shared.f32 [%r8], %f2;
    bar.sync            0;

    // every thread adds up the per-warp partial sums
    shr.u32             %r9, %r3, 5;            // number of warps
    mov.f32             %f4, 0f00000000;
    mov.u32             %r10, 0;
WSUM:
    setp.ge.u32         %p3, %r10, %r9;
    @%p3 bra            WSUM_DONE;
    shl.b32             %r11, %r10, 2;
    add.u32             %r11, %r7, %r11;
    ld.shared.f32       %f5, [%r11];
    add.f32             %f4, %f4, %f5;
    add.u32             %r10, %r10, 1;
    bra.uni             WSUM;
WSUM_DONE:
    cvt.rn.f32.u32      %f6, %r1;
    div.rn.f32          %f7, %f4, %f6;          // mean(x^2)
    add.f32             %f7, %f7, %f1;
    sqrt.rn.f32         %f8, %f7;
    rcp.rn.f32          %f9, %f8;               // scale

    mov.u32             %r4, %r2;
SCALE:
    setp.ge.u32         %p1, %r4, %r1;
    @%p1 bra            DONE;
    mul.wide.u32        %rd4, %r4, 4;
    add.s64             %rd5, %rd1, %rd4;
    add.s64             %rd6, %rd2, %rd4;
    add.s64             %rd7, %rd3, %rd4;
    ld.global.f32       %f10, [%rd5];
    ld.global.f32       %f11, [%rd6];
    mul.f32             %f12, %f10, %f9;
    mul.f32             %f12, %f12, %f11;
    st.global.f32       [%rd7], %f12;
    add.u32             %r4, %r4, %r3;
    bra.uni             SCALE;
DONE:
    ret;
}

// -----------------------------------------------------------------------------
// Kernel: quant_q8   blocks of 32 floats -> int8 q[i] = round(x[i] / d),
//                    d = max|x| / 127 per block; ds[b] = {d, d * sum_j q_j}
//   One warp per block (lane = element), grid-stride over blocks.
// -----------------------------------------------------------------------------
.visible .entry quant_q8(
    .param .u64 p_x,            // f32 [nblk*32]
    .param .u64 p_q,            // s8  [nblk*32] (out)
    .param .u64 p_ds,           // f32x2 [nblk]  (out)
    .param .u32 p_nblk
)
{
    .reg .pred  %p<4>;
    .reg .b32   %r<16>;
    .reg .f32   %f<12>;
    .reg .b64   %rd<12>;

    ld.param.u64        %rd1, [p_x];
    ld.param.u64        %rd2, [p_q];
    ld.param.u64        %rd3, [p_ds];
    ld.param.u32        %r1,  [p_nblk];
    cvta.to.global.u64  %rd1, %rd1;
    cvta.to.global.u64  %rd2, %rd2;
    cvta.to.global.u64  %rd3, %rd3;

    mov.u32             %r2, %tid.x;
    mov.u32             %r3, %ntid.x;
    mov.u32             %r4, %ctaid.x;
    mov.u32             %r5, %nctaid.x;
    and.b32             %r6, %r2, 31;           // lane
    mad.lo.u32          %r7, %r4, %r3, %r2;
    shr.u32             %r7, %r7, 5;            // global warp = block index
    mul.lo.u32          %r8, %r5, %r3;
    shr.u32             %r8, %r8, 5;            // warps in grid
    setp.eq.u32         %p2, %r6, 0;

LOOP:
    setp.ge.u32         %p1, %r7, %r1;          // warp-uniform
    @%p1 bra            DONE;
    shl.b32             %r9, %r7, 5;
    add.u32             %r9, %r9, %r6;          // element
    mul.wide.u32        %rd4, %r9, 4;
    add.s64             %rd5, %rd1, %rd4;
    ld.global.f32       %f1, [%rd5];
    abs.f32             %f2, %f1;
    shfl.sync.bfly.b32  %f3, %f2, 16, 31, -1;
    max.f32             %f2, %f2, %f3;
    shfl.sync.bfly.b32  %f3, %f2, 8, 31, -1;
    max.f32             %f2, %f2, %f3;
    shfl.sync.bfly.b32  %f3, %f2, 4, 31, -1;
    max.f32             %f2, %f2, %f3;
    shfl.sync.bfly.b32  %f3, %f2, 2, 31, -1;
    max.f32             %f2, %f2, %f3;
    shfl.sync.bfly.b32  %f3, %f2, 1, 31, -1;
    max.f32             %f2, %f2, %f3;
    div.rn.f32          %f4, %f2, 0f42FE0000;   // d = amax / 127
    setp.gt.f32         %p3, %f4, 0f00000000;
    rcp.rn.f32          %f5, %f4;
    selp.f32            %f5, %f5, 0f00000000, %p3;
    mul.f32             %f6, %f1, %f5;
    cvt.rni.s32.f32     %r10, %f6;
    cvt.u64.u32         %rd6, %r9;
    add.s64             %rd7, %rd2, %rd6;
    st.global.u8        [%rd7], %r10;
    // sum of the block's q
    shfl.sync.bfly.b32  %r11, %r10, 16, 31, -1;
    add.s32             %r10, %r10, %r11;
    shfl.sync.bfly.b32  %r11, %r10, 8, 31, -1;
    add.s32             %r10, %r10, %r11;
    shfl.sync.bfly.b32  %r11, %r10, 4, 31, -1;
    add.s32             %r10, %r10, %r11;
    shfl.sync.bfly.b32  %r11, %r10, 2, 31, -1;
    add.s32             %r10, %r10, %r11;
    shfl.sync.bfly.b32  %r11, %r10, 1, 31, -1;
    add.s32             %r10, %r10, %r11;
    @!%p2 bra           NEXT;
    cvt.rn.f32.s32      %f7, %r10;
    mul.f32             %f7, %f7, %f4;
    mul.wide.u32        %rd8, %r7, 8;
    add.s64             %rd9, %rd3, %rd8;
    st.global.v2.f32    [%rd9], {%f4, %f7};
NEXT:
    add.u32             %r7, %r7, %r8;
    bra.uni             LOOP;
DONE:
    ret;
}

// =============================================================================
// Matrix-vector kernels (one token):  y[r] = sum_c W[r][c] * x[c] + resid[r]
//   x as int8 blocks (xq, xds from quant_q8); resid may be 0 (null) and y may
//   equal resid. One warp per row; lane b takes the 32-value blocks b, b+32,
//   ..., each giving an exact integer dot product that is scaled into the
//   lane's f32 sum; the lanes' sums are added at the end.
//   Launch: blockDim = 256 (8 rows per block), gridDim = ceil(rows / 8).
// =============================================================================

// -----------------------------------------------------------------------------
// Kernel: mv_q4_1   W in Q4_1: w = d q + m. Byte j of a block holds value j
//   (low nibble) and value j+16 (high nibble), so word k of the 16 bytes
//   gives values 4k..4k+3 and 16+4k..16+4k+3 - against activation words k
//   and 4+k.
// -----------------------------------------------------------------------------
.visible .entry mv_q4_1(
    .param .u64 p_qs,           // u8    [rows][cols/2]
    .param .u64 p_dm,           // f16x2 [rows][cols/32]
    .param .u64 p_xq,           // s8    [cols]
    .param .u64 p_xds,          // f32x2 [cols/32]
    .param .u64 p_resid,        // f32   [rows] or 0
    .param .u64 p_y,            // f32   [rows] (out)
    .param .u32 p_rows,
    .param .u32 p_cols
)
{
    .reg .pred  %p<4>;
    .reg .b16   %h<2>;
    .reg .b32   %r<48>;
    .reg .f32   %f<12>;
    .reg .b64   %rd<20>;

    ld.param.u64        %rd1, [p_qs];
    ld.param.u64        %rd2, [p_dm];
    ld.param.u64        %rd3, [p_xq];
    ld.param.u64        %rd4, [p_xds];
    ld.param.u64        %rd5, [p_resid];
    ld.param.u64        %rd6, [p_y];
    ld.param.u32        %r1,  [p_rows];
    ld.param.u32        %r2,  [p_cols];

    mov.u32             %r3, %tid.x;
    and.b32             %r4, %r3, 31;           // lane
    shr.u32             %r5, %r3, 5;            // warp in block
    mov.u32             %r6, %ntid.x;
    shr.u32             %r6, %r6, 5;
    mov.u32             %r7, %ctaid.x;
    mad.lo.u32          %r8, %r7, %r6, %r5;     // row
    setp.ge.u32         %p1, %r8, %r1;
    @%p1 bra            DONE;

    cvta.to.global.u64  %rd1, %rd1;
    cvta.to.global.u64  %rd2, %rd2;
    cvta.to.global.u64  %rd3, %rd3;
    cvta.to.global.u64  %rd4, %rd4;
    cvta.to.global.u64  %rd6, %rd6;
    shr.u32             %r9, %r2, 5;            // nb = blocks per row
    mul.wide.u32        %rd7, %r8, %r9;         // row * nb
    shl.b64             %rd8, %rd7, 4;
    add.s64             %rd8, %rd1, %rd8;       // qs row
    shl.b64             %rd9, %rd7, 2;
    add.s64             %rd9, %rd2, %rd9;       // dm row

    mov.f32             %f1, 0f00000000;        // acc
    mov.u32             %r10, %r4;              // b = lane
LOOP:
    setp.ge.u32         %p2, %r10, %r9;
    @%p2 bra            REDUCE;
    mul.wide.u32        %rd10, %r10, 16;
    add.s64             %rd11, %rd8, %rd10;
    ld.global.nc.v4.u32 {%r11, %r12, %r13, %r14}, [%rd11];
    mul.wide.u32        %rd12, %r10, 4;
    add.s64             %rd13, %rd9, %rd12;
    ld.global.nc.u32    %r15, [%rd13];          // d | m
    mul.wide.u32        %rd14, %r10, 32;
    add.s64             %rd15, %rd3, %rd14;
    ld.global.nc.v4.u32 {%r20, %r21, %r22, %r23}, [%rd15];      // x[0..15]
    ld.global.nc.v4.u32 {%r24, %r25, %r26, %r27}, [%rd15+16];   // x[16..31]
    mul.wide.u32        %rd16, %r10, 8;
    add.s64             %rd17, %rd4, %rd16;
    ld.global.nc.v2.f32 {%f2, %f3}, [%rd17];    // d_x, d_x * sum(q_x)

    and.b32             %r30, %r11, 0x0F0F0F0F;
    dp4a.u32.s32        %r40, %r30, %r20, 0;
    shr.u32             %r30, %r11, 4;
    and.b32             %r30, %r30, 0x0F0F0F0F;
    dp4a.u32.s32        %r40, %r30, %r24, %r40;
    and.b32             %r30, %r12, 0x0F0F0F0F;
    dp4a.u32.s32        %r40, %r30, %r21, %r40;
    shr.u32             %r30, %r12, 4;
    and.b32             %r30, %r30, 0x0F0F0F0F;
    dp4a.u32.s32        %r40, %r30, %r25, %r40;
    and.b32             %r30, %r13, 0x0F0F0F0F;
    dp4a.u32.s32        %r40, %r30, %r22, %r40;
    shr.u32             %r30, %r13, 4;
    and.b32             %r30, %r30, 0x0F0F0F0F;
    dp4a.u32.s32        %r40, %r30, %r26, %r40;
    and.b32             %r30, %r14, 0x0F0F0F0F;
    dp4a.u32.s32        %r40, %r30, %r23, %r40;
    shr.u32             %r30, %r14, 4;
    and.b32             %r30, %r30, 0x0F0F0F0F;
    dp4a.u32.s32        %r40, %r30, %r27, %r40;

    mov.b32             {%h0, %h1}, %r15;
    cvt.f32.f16         %f4, %h0;               // d
    cvt.f32.f16         %f5, %h1;               // m
    mul.f32             %f6, %f4, %f2;
    cvt.rn.f32.s32      %f7, %r40;
    fma.rn.f32          %f1, %f7, %f6, %f1;
    fma.rn.f32          %f1, %f5, %f3, %f1;
    add.u32             %r10, %r10, 32;
    bra.uni             LOOP;

REDUCE:
    shfl.sync.bfly.b32  %f8, %f1, 16, 31, -1;
    add.f32             %f1, %f1, %f8;
    shfl.sync.bfly.b32  %f8, %f1, 8, 31, -1;
    add.f32             %f1, %f1, %f8;
    shfl.sync.bfly.b32  %f8, %f1, 4, 31, -1;
    add.f32             %f1, %f1, %f8;
    shfl.sync.bfly.b32  %f8, %f1, 2, 31, -1;
    add.f32             %f1, %f1, %f8;
    shfl.sync.bfly.b32  %f8, %f1, 1, 31, -1;
    add.f32             %f1, %f1, %f8;
    setp.ne.u32         %p3, %r4, 0;
    @%p3 bra            DONE;
    mul.wide.u32        %rd18, %r8, 4;
    setp.eq.u64         %p2, %rd5, 0;
    @%p2 bra            STORE;
    cvta.to.global.u64  %rd5, %rd5;
    add.s64             %rd19, %rd5, %rd18;
    ld.global.f32       %f9, [%rd19];
    add.f32             %f1, %f1, %f9;
STORE:
    add.s64             %rd19, %rd6, %rd18;
    st.global.f32       [%rd19], %f1;
DONE:
    ret;
}

// -----------------------------------------------------------------------------
// Kernel: mv_q8_0   W in Q8_0: w = d q.
// -----------------------------------------------------------------------------
.visible .entry mv_q8_0(
    .param .u64 p_q,            // s8  [rows][cols]
    .param .u64 p_d,            // f16 [rows][cols/32]
    .param .u64 p_xq,           // s8    [cols]
    .param .u64 p_xds,          // f32x2 [cols/32]
    .param .u64 p_resid,        // f32   [rows] or 0
    .param .u64 p_y,            // f32   [rows] (out)
    .param .u32 p_rows,
    .param .u32 p_cols
)
{
    .reg .pred  %p<4>;
    .reg .b16   %h<2>;
    .reg .b32   %r<48>;
    .reg .f32   %f<12>;
    .reg .b64   %rd<20>;

    ld.param.u64        %rd1, [p_q];
    ld.param.u64        %rd2, [p_d];
    ld.param.u64        %rd3, [p_xq];
    ld.param.u64        %rd4, [p_xds];
    ld.param.u64        %rd5, [p_resid];
    ld.param.u64        %rd6, [p_y];
    ld.param.u32        %r1,  [p_rows];
    ld.param.u32        %r2,  [p_cols];

    mov.u32             %r3, %tid.x;
    and.b32             %r4, %r3, 31;           // lane
    shr.u32             %r5, %r3, 5;            // warp in block
    mov.u32             %r6, %ntid.x;
    shr.u32             %r6, %r6, 5;
    mov.u32             %r7, %ctaid.x;
    mad.lo.u32          %r8, %r7, %r6, %r5;     // row
    setp.ge.u32         %p1, %r8, %r1;
    @%p1 bra            DONE;

    cvta.to.global.u64  %rd1, %rd1;
    cvta.to.global.u64  %rd2, %rd2;
    cvta.to.global.u64  %rd3, %rd3;
    cvta.to.global.u64  %rd4, %rd4;
    cvta.to.global.u64  %rd6, %rd6;
    shr.u32             %r9, %r2, 5;            // nb
    mul.wide.u32        %rd7, %r8, %r2;
    add.s64             %rd8, %rd1, %rd7;       // q row
    mul.wide.u32        %rd7, %r8, %r9;
    shl.b64             %rd9, %rd7, 1;
    add.s64             %rd9, %rd2, %rd9;       // d row

    mov.f32             %f1, 0f00000000;
    mov.u32             %r10, %r4;
LOOP:
    setp.ge.u32         %p2, %r10, %r9;
    @%p2 bra            REDUCE;
    mul.wide.u32        %rd14, %r10, 32;
    add.s64             %rd11, %rd8, %rd14;
    ld.global.nc.v4.u32 {%r11, %r12, %r13, %r14}, [%rd11];
    ld.global.nc.v4.u32 {%r15, %r16, %r17, %r18}, [%rd11+16];
    mul.wide.u32        %rd12, %r10, 2;
    add.s64             %rd13, %rd9, %rd12;
    ld.global.nc.b16    %h0, [%rd13];
    add.s64             %rd15, %rd3, %rd14;
    ld.global.nc.v4.u32 {%r20, %r21, %r22, %r23}, [%rd15];
    ld.global.nc.v4.u32 {%r24, %r25, %r26, %r27}, [%rd15+16];
    mul.wide.u32        %rd16, %r10, 8;
    add.s64             %rd17, %rd4, %rd16;
    ld.global.nc.f32    %f2, [%rd17];           // d_x

    dp4a.s32.s32        %r40, %r11, %r20, 0;
    dp4a.s32.s32        %r40, %r12, %r21, %r40;
    dp4a.s32.s32        %r40, %r13, %r22, %r40;
    dp4a.s32.s32        %r40, %r14, %r23, %r40;
    dp4a.s32.s32        %r40, %r15, %r24, %r40;
    dp4a.s32.s32        %r40, %r16, %r25, %r40;
    dp4a.s32.s32        %r40, %r17, %r26, %r40;
    dp4a.s32.s32        %r40, %r18, %r27, %r40;

    cvt.f32.f16         %f4, %h0;
    mul.f32             %f6, %f4, %f2;
    cvt.rn.f32.s32      %f7, %r40;
    fma.rn.f32          %f1, %f7, %f6, %f1;
    add.u32             %r10, %r10, 32;
    bra.uni             LOOP;

REDUCE:
    shfl.sync.bfly.b32  %f8, %f1, 16, 31, -1;
    add.f32             %f1, %f1, %f8;
    shfl.sync.bfly.b32  %f8, %f1, 8, 31, -1;
    add.f32             %f1, %f1, %f8;
    shfl.sync.bfly.b32  %f8, %f1, 4, 31, -1;
    add.f32             %f1, %f1, %f8;
    shfl.sync.bfly.b32  %f8, %f1, 2, 31, -1;
    add.f32             %f1, %f1, %f8;
    shfl.sync.bfly.b32  %f8, %f1, 1, 31, -1;
    add.f32             %f1, %f1, %f8;
    setp.ne.u32         %p3, %r4, 0;
    @%p3 bra            DONE;
    mul.wide.u32        %rd18, %r8, 4;
    setp.eq.u64         %p2, %rd5, 0;
    @%p2 bra            STORE;
    cvta.to.global.u64  %rd5, %rd5;
    add.s64             %rd19, %rd5, %rd18;
    ld.global.f32       %f9, [%rd19];
    add.f32             %f1, %f1, %f9;
STORE:
    add.s64             %rd19, %rd6, %rd18;
    st.global.f32       [%rd19], %f1;
DONE:
    ret;
}

// -----------------------------------------------------------------------------
// Kernel: mv_q5_k   W in Q5_K (176-byte blocks of 256 values): sub-block s
//   (32 values) has w = d sc_s q - dmin m_s, with sc_s, m_s 6 bits from the
//   12 scale bytes (ggml's get_scale_min_k4):
//     s < 4:  sc = sc[s] & 63,                    m = sc[s+4] & 63
//     s >= 4: sc = sc[s+4] & 15 | sc[s-4] >> 6 << 4, m = sc[s+4] >> 4 | sc[s] >> 6 << 4
//   and q = nibble s & 1 of qs[32 (s/2) + l] plus bit s of qh[l] as bit 4.
//   Lane b takes sub-block b (so s = lane % 8).
// -----------------------------------------------------------------------------
.visible .entry mv_q5_k(
    .param .u64 p_w,            // Q5_K blocks [rows][cols/256]
    .param .u64 p_unused,
    .param .u64 p_xq,           // s8    [cols]
    .param .u64 p_xds,          // f32x2 [cols/32]
    .param .u64 p_resid,        // f32   [rows] or 0
    .param .u64 p_y,            // f32   [rows] (out)
    .param .u32 p_rows,
    .param .u32 p_cols
)
{
    .reg .pred  %p<4>;
    .reg .b16   %h<2>;
    .reg .b32   %r<64>;
    .reg .f32   %f<16>;
    .reg .b64   %rd<20>;

    ld.param.u64        %rd1, [p_w];
    ld.param.u64        %rd3, [p_xq];
    ld.param.u64        %rd4, [p_xds];
    ld.param.u64        %rd5, [p_resid];
    ld.param.u64        %rd6, [p_y];
    ld.param.u32        %r1,  [p_rows];
    ld.param.u32        %r2,  [p_cols];

    mov.u32             %r3, %tid.x;
    and.b32             %r4, %r3, 31;           // lane
    shr.u32             %r5, %r3, 5;
    mov.u32             %r6, %ntid.x;
    shr.u32             %r6, %r6, 5;
    mov.u32             %r7, %ctaid.x;
    mad.lo.u32          %r8, %r7, %r6, %r5;     // row
    setp.ge.u32         %p1, %r8, %r1;
    @%p1 bra            DONE;

    cvta.to.global.u64  %rd1, %rd1;
    cvta.to.global.u64  %rd3, %rd3;
    cvta.to.global.u64  %rd4, %rd4;
    cvta.to.global.u64  %rd6, %rd6;
    shr.u32             %r9, %r2, 5;            // sub-blocks per row
    shr.u32             %r19, %r2, 8;           // blocks per row
    mul.wide.u32        %rd7, %r8, %r19;
    mul.lo.u64          %rd7, %rd7, 176;
    add.s64             %rd8, %rd1, %rd7;       // row's blocks

    // this lane's sub-block s: nibble shift, qs offset, scale bit positions
    and.b32             %r16, %r4, 7;           // s
    and.b32             %r17, %r16, 1;
    shl.b32             %r17, %r17, 2;          // nibble shift 4 (s & 1)
    shr.u32             %r18, %r16, 1;
    shl.b32             %r18, %r18, 5;          // 32 (s / 2)
    and.b32             %r28, %r16, 3;
    shl.b32             %r28, %r28, 3;          // 8 (s % 4): bit offset in a scale word
    add.u32             %r29, %r28, 6;
    add.u32             %r31, %r28, 4;
    setp.lt.u32         %p3, %r16, 4;

    mov.f32             %f1, 0f00000000;
    mov.u32             %r10, %r4;              // sub-block b
LOOP:
    setp.ge.u32         %p2, %r10, %r9;
    @%p2 bra            REDUCE;
    shr.u32             %r11, %r10, 3;          // block
    mul.wide.u32        %rd9, %r11, 176;
    add.s64             %rd9, %rd8, %rd9;
    ld.global.nc.v4.u32 {%r12, %r13, %r14, %r15}, [%rd9];      // d dmin | scales[12]
    cvt.u64.u32         %rd10, %r18;
    add.s64             %rd10, %rd9, %rd10;
    ld.global.nc.v4.u32 {%r20, %r21, %r22, %r23}, [%rd10+48];  // qs[32 (s/2) ..]
    ld.global.nc.v4.u32 {%r24, %r25, %r26, %r27}, [%rd10+64];
    ld.global.nc.v4.u32 {%r32, %r33, %r34, %r35}, [%rd9+16];   // qh[0..31]
    ld.global.nc.v4.u32 {%r36, %r37, %r38, %r39}, [%rd9+32];
    mul.wide.u32        %rd11, %r10, 32;
    add.s64             %rd12, %rd3, %rd11;
    ld.global.nc.v4.u32 {%r40, %r41, %r42, %r43}, [%rd12];
    ld.global.nc.v4.u32 {%r44, %r45, %r46, %r47}, [%rd12+16];
    mul.wide.u32        %rd13, %r10, 8;
    add.s64             %rd14, %rd4, %rd13;
    ld.global.nc.v2.f32 {%f2, %f3}, [%rd14];

    // scale and min of sub-block s (r13 = sc[0..3], r14 = sc[4..7], r15 = sc[8..11])
    bfe.u32             %r48, %r13, %r28, 6;    // s < 4
    bfe.u32             %r49, %r14, %r28, 6;
    bfe.u32             %r50, %r15, %r28, 4;    // s >= 4
    bfe.u32             %r51, %r13, %r29, 2;
    shl.b32             %r51, %r51, 4;
    or.b32              %r50, %r50, %r51;
    bfe.u32             %r52, %r15, %r31, 4;
    bfe.u32             %r53, %r14, %r29, 2;
    shl.b32             %r53, %r53, 4;
    or.b32              %r52, %r52, %r53;
    selp.b32            %r48, %r48, %r50, %p3;  // sc
    selp.b32            %r49, %r49, %r52, %p3;  // m

    // q = (qs >> 4 (s & 1)) & 15 | ((qh >> s) & 1) << 4, word by word
    shr.u32             %r54, %r20, %r17;
    and.b32             %r54, %r54, 0x0F0F0F0F;
    shr.u32             %r55, %r32, %r16;
    and.b32             %r55, %r55, 0x01010101;
    shl.b32             %r55, %r55, 4;
    or.b32              %r54, %r54, %r55;
    dp4a.u32.s32        %r60, %r54, %r40, 0;
    shr.u32             %r54, %r21, %r17;
    and.b32             %r54, %r54, 0x0F0F0F0F;
    shr.u32             %r55, %r33, %r16;
    and.b32             %r55, %r55, 0x01010101;
    shl.b32             %r55, %r55, 4;
    or.b32              %r54, %r54, %r55;
    dp4a.u32.s32        %r60, %r54, %r41, %r60;
    shr.u32             %r54, %r22, %r17;
    and.b32             %r54, %r54, 0x0F0F0F0F;
    shr.u32             %r55, %r34, %r16;
    and.b32             %r55, %r55, 0x01010101;
    shl.b32             %r55, %r55, 4;
    or.b32              %r54, %r54, %r55;
    dp4a.u32.s32        %r60, %r54, %r42, %r60;
    shr.u32             %r54, %r23, %r17;
    and.b32             %r54, %r54, 0x0F0F0F0F;
    shr.u32             %r55, %r35, %r16;
    and.b32             %r55, %r55, 0x01010101;
    shl.b32             %r55, %r55, 4;
    or.b32              %r54, %r54, %r55;
    dp4a.u32.s32        %r60, %r54, %r43, %r60;
    shr.u32             %r54, %r24, %r17;
    and.b32             %r54, %r54, 0x0F0F0F0F;
    shr.u32             %r55, %r36, %r16;
    and.b32             %r55, %r55, 0x01010101;
    shl.b32             %r55, %r55, 4;
    or.b32              %r54, %r54, %r55;
    dp4a.u32.s32        %r60, %r54, %r44, %r60;
    shr.u32             %r54, %r25, %r17;
    and.b32             %r54, %r54, 0x0F0F0F0F;
    shr.u32             %r55, %r37, %r16;
    and.b32             %r55, %r55, 0x01010101;
    shl.b32             %r55, %r55, 4;
    or.b32              %r54, %r54, %r55;
    dp4a.u32.s32        %r60, %r54, %r45, %r60;
    shr.u32             %r54, %r26, %r17;
    and.b32             %r54, %r54, 0x0F0F0F0F;
    shr.u32             %r55, %r38, %r16;
    and.b32             %r55, %r55, 0x01010101;
    shl.b32             %r55, %r55, 4;
    or.b32              %r54, %r54, %r55;
    dp4a.u32.s32        %r60, %r54, %r46, %r60;
    shr.u32             %r54, %r27, %r17;
    and.b32             %r54, %r54, 0x0F0F0F0F;
    shr.u32             %r55, %r39, %r16;
    and.b32             %r55, %r55, 0x01010101;
    shl.b32             %r55, %r55, 4;
    or.b32              %r54, %r54, %r55;
    dp4a.u32.s32        %r60, %r54, %r47, %r60;

    mov.b32             {%h0, %h1}, %r12;
    cvt.f32.f16         %f4, %h0;               // d
    cvt.f32.f16         %f5, %h1;               // dmin
    cvt.rn.f32.u32      %f6, %r48;
    mul.f32             %f6, %f4, %f6;          // weight scale d sc
    cvt.rn.f32.u32      %f7, %r49;
    mul.f32             %f7, %f5, %f7;
    neg.f32             %f7, %f7;               // weight offset -dmin m
    mul.f32             %f8, %f6, %f2;
    cvt.rn.f32.s32      %f9, %r60;
    fma.rn.f32          %f1, %f9, %f8, %f1;
    fma.rn.f32          %f1, %f7, %f3, %f1;
    add.u32             %r10, %r10, 32;
    bra.uni             LOOP;

REDUCE:
    shfl.sync.bfly.b32  %f8, %f1, 16, 31, -1;
    add.f32             %f1, %f1, %f8;
    shfl.sync.bfly.b32  %f8, %f1, 8, 31, -1;
    add.f32             %f1, %f1, %f8;
    shfl.sync.bfly.b32  %f8, %f1, 4, 31, -1;
    add.f32             %f1, %f1, %f8;
    shfl.sync.bfly.b32  %f8, %f1, 2, 31, -1;
    add.f32             %f1, %f1, %f8;
    shfl.sync.bfly.b32  %f8, %f1, 1, 31, -1;
    add.f32             %f1, %f1, %f8;
    setp.ne.u32         %p1, %r4, 0;
    @%p1 bra            DONE;
    mul.wide.u32        %rd18, %r8, 4;
    setp.eq.u64         %p2, %rd5, 0;
    @%p2 bra            STORE;
    cvta.to.global.u64  %rd5, %rd5;
    add.s64             %rd19, %rd5, %rd18;
    ld.global.f32       %f10, [%rd19];
    add.f32             %f1, %f1, %f10;
STORE:
    add.s64             %rd19, %rd6, %rd18;
    st.global.f32       [%rd19], %f1;
DONE:
    ret;
}

// -----------------------------------------------------------------------------
// Kernel: mv_q6_k   W in Q6_K (ql | qh | scales, 208 bytes per 256 values, and
//   d f16 per block): 32-value group g = 4h + k of a block has
//   q = nibble k / 2 of ql[64 h + 32 (k & 1) + l] | bits 2k..2k+1 of
//   qh[32 h + l] << 4, w = d sc (q - 32), with int8 scale sc[8h + 2k] for
//   l < 16 and sc[8h + 2k + 1] for l >= 16. Lane b takes group b (g = lane % 8).
// -----------------------------------------------------------------------------
.visible .entry mv_q6_k(
    .param .u64 p_w,            // u8  [rows][cols/256][208]
    .param .u64 p_d,            // f16 [rows][cols/256]
    .param .u64 p_xq,           // s8    [cols]
    .param .u64 p_xds,          // f32x2 [cols/32]
    .param .u64 p_resid,        // f32   [rows] or 0
    .param .u64 p_y,            // f32   [rows] (out)
    .param .u32 p_rows,
    .param .u32 p_cols
)
{
    .reg .pred  %p<4>;
    .reg .b16   %h<2>;
    .reg .b32   %r<72>;
    .reg .f32   %f<16>;
    .reg .b64   %rd<24>;

    ld.param.u64        %rd1, [p_w];
    ld.param.u64        %rd2, [p_d];
    ld.param.u64        %rd3, [p_xq];
    ld.param.u64        %rd4, [p_xds];
    ld.param.u64        %rd5, [p_resid];
    ld.param.u64        %rd6, [p_y];
    ld.param.u32        %r1,  [p_rows];
    ld.param.u32        %r2,  [p_cols];

    mov.u32             %r3, %tid.x;
    and.b32             %r4, %r3, 31;           // lane
    shr.u32             %r5, %r3, 5;
    mov.u32             %r6, %ntid.x;
    shr.u32             %r6, %r6, 5;
    mov.u32             %r7, %ctaid.x;
    mad.lo.u32          %r8, %r7, %r6, %r5;     // row
    setp.ge.u32         %p1, %r8, %r1;
    @%p1 bra            DONE;

    cvta.to.global.u64  %rd1, %rd1;
    cvta.to.global.u64  %rd2, %rd2;
    cvta.to.global.u64  %rd3, %rd3;
    cvta.to.global.u64  %rd4, %rd4;
    cvta.to.global.u64  %rd6, %rd6;
    shr.u32             %r9, %r2, 5;            // groups per row
    shr.u32             %r19, %r2, 8;           // blocks per row
    mul.wide.u32        %rd7, %r8, %r19;        // row * blocks
    mul.lo.u64          %rd8, %rd7, 208;
    add.s64             %rd8, %rd1, %rd8;       // row's blocks
    shl.b64             %rd9, %rd7, 1;
    add.s64             %rd9, %rd2, %rd9;       // row's scales d

    // this lane's group g = 4h + k: offsets and shifts
    and.b32             %r16, %r4, 7;           // g
    shr.u32             %r17, %r16, 2;          // h
    and.b32             %r18, %r16, 3;          // k
    and.b32             %r28, %r18, 1;
    shl.b32             %r28, %r28, 5;
    mad.lo.u32          %r28, %r17, 64, %r28;   // ql offset 64 h + 32 (k & 1)
    shr.u32             %r29, %r18, 1;
    shl.b32             %r29, %r29, 2;          // nibble shift 4 (k / 2)
    shl.b32             %r30, %r17, 5;
    add.u32             %r30, %r30, 128;        // qh offset 128 + 32 h
    shl.b32             %r31, %r18, 1;          // qh shift 2 k
    shl.b32             %r63, %r17, 3;
    add.u32             %r63, %r63, %r31;
    add.u32             %r63, %r63, 192;        // scales offset 192 + 8 h + 2 k
    mov.u32             %r62, 0x01010101;

    mov.f32             %f1, 0f00000000;
    mov.u32             %r10, %r4;              // group b
LOOP:
    setp.ge.u32         %p2, %r10, %r9;
    @%p2 bra            REDUCE;
    shr.u32             %r11, %r10, 3;          // block
    mul.wide.u32        %rd10, %r11, 208;
    add.s64             %rd10, %rd8, %rd10;
    cvt.u64.u32         %rd11, %r28;
    add.s64             %rd11, %rd10, %rd11;
    ld.global.nc.v4.u32 {%r20, %r21, %r22, %r23}, [%rd11];
    ld.global.nc.v4.u32 {%r24, %r25, %r26, %r27}, [%rd11+16];
    cvt.u64.u32         %rd12, %r30;
    add.s64             %rd12, %rd10, %rd12;
    ld.global.nc.v4.u32 {%r32, %r33, %r34, %r35}, [%rd12];
    ld.global.nc.v4.u32 {%r36, %r37, %r38, %r39}, [%rd12+16];
    cvt.u64.u32         %rd13, %r63;
    add.s64             %rd13, %rd10, %rd13;
    ld.global.nc.u16    %h0, [%rd13];           // two int8 scales
    mul.wide.u32        %rd14, %r11, 2;
    add.s64             %rd14, %rd9, %rd14;
    ld.global.nc.b16    %h1, [%rd14];           // d
    mul.wide.u32        %rd15, %r10, 32;
    add.s64             %rd16, %rd3, %rd15;
    ld.global.nc.v4.u32 {%r40, %r41, %r42, %r43}, [%rd16];
    ld.global.nc.v4.u32 {%r44, %r45, %r46, %r47}, [%rd16+16];
    mul.wide.u32        %rd17, %r10, 8;
    add.s64             %rd18, %rd4, %rd17;
    ld.global.nc.f32    %f2, [%rd18];           // d_x

    // q words, then the two 16-value halves' dot products
    shr.u32             %r50, %r20, %r29;
    and.b32             %r50, %r50, 0x0F0F0F0F;
    shr.u32             %r51, %r32, %r31;
    and.b32             %r51, %r51, 0x03030303;
    shl.b32             %r51, %r51, 4;
    or.b32              %r50, %r50, %r51;
    dp4a.u32.s32        %r60, %r50, %r40, 0;
    shr.u32             %r50, %r21, %r29;
    and.b32             %r50, %r50, 0x0F0F0F0F;
    shr.u32             %r51, %r33, %r31;
    and.b32             %r51, %r51, 0x03030303;
    shl.b32             %r51, %r51, 4;
    or.b32              %r50, %r50, %r51;
    dp4a.u32.s32        %r60, %r50, %r41, %r60;
    shr.u32             %r50, %r22, %r29;
    and.b32             %r50, %r50, 0x0F0F0F0F;
    shr.u32             %r51, %r34, %r31;
    and.b32             %r51, %r51, 0x03030303;
    shl.b32             %r51, %r51, 4;
    or.b32              %r50, %r50, %r51;
    dp4a.u32.s32        %r60, %r50, %r42, %r60;
    shr.u32             %r50, %r23, %r29;
    and.b32             %r50, %r50, 0x0F0F0F0F;
    shr.u32             %r51, %r35, %r31;
    and.b32             %r51, %r51, 0x03030303;
    shl.b32             %r51, %r51, 4;
    or.b32              %r50, %r50, %r51;
    dp4a.u32.s32        %r60, %r50, %r43, %r60;     // values 0..15
    shr.u32             %r50, %r24, %r29;
    and.b32             %r50, %r50, 0x0F0F0F0F;
    shr.u32             %r51, %r36, %r31;
    and.b32             %r51, %r51, 0x03030303;
    shl.b32             %r51, %r51, 4;
    or.b32              %r50, %r50, %r51;
    dp4a.u32.s32        %r61, %r50, %r44, 0;
    shr.u32             %r50, %r25, %r29;
    and.b32             %r50, %r50, 0x0F0F0F0F;
    shr.u32             %r51, %r37, %r31;
    and.b32             %r51, %r51, 0x03030303;
    shl.b32             %r51, %r51, 4;
    or.b32              %r50, %r50, %r51;
    dp4a.u32.s32        %r61, %r50, %r45, %r61;
    shr.u32             %r50, %r26, %r29;
    and.b32             %r50, %r50, 0x0F0F0F0F;
    shr.u32             %r51, %r38, %r31;
    and.b32             %r51, %r51, 0x03030303;
    shl.b32             %r51, %r51, 4;
    or.b32              %r50, %r50, %r51;
    dp4a.u32.s32        %r61, %r50, %r46, %r61;
    shr.u32             %r50, %r27, %r29;
    and.b32             %r50, %r50, 0x0F0F0F0F;
    shr.u32             %r51, %r39, %r31;
    and.b32             %r51, %r51, 0x03030303;
    shl.b32             %r51, %r51, 4;
    or.b32              %r50, %r50, %r51;
    dp4a.u32.s32        %r61, %r50, %r47, %r61;     // values 16..31
    // - 32 * sum(x) per half
    dp4a.s32.s32        %r52, %r62, %r40, 0;
    dp4a.s32.s32        %r52, %r62, %r41, %r52;
    dp4a.s32.s32        %r52, %r62, %r42, %r52;
    dp4a.s32.s32        %r52, %r62, %r43, %r52;
    dp4a.s32.s32        %r53, %r62, %r44, 0;
    dp4a.s32.s32        %r53, %r62, %r45, %r53;
    dp4a.s32.s32        %r53, %r62, %r46, %r53;
    dp4a.s32.s32        %r53, %r62, %r47, %r53;
    shl.b32             %r52, %r52, 5;
    sub.s32             %r60, %r60, %r52;
    shl.b32             %r53, %r53, 5;
    sub.s32             %r61, %r61, %r53;
    // sc_a * dot_a + sc_b * dot_b
    cvt.u32.u16         %r54, %h0;
    bfe.s32             %r55, %r54, 0, 8;
    bfe.s32             %r56, %r54, 8, 8;
    mul.lo.s32          %r60, %r60, %r55;
    mad.lo.s32          %r60, %r61, %r56, %r60;

    cvt.f32.f16         %f4, %h1;
    mul.f32             %f6, %f4, %f2;
    cvt.rn.f32.s32      %f7, %r60;
    fma.rn.f32          %f1, %f7, %f6, %f1;
    add.u32             %r10, %r10, 32;
    bra.uni             LOOP;

REDUCE:
    shfl.sync.bfly.b32  %f8, %f1, 16, 31, -1;
    add.f32             %f1, %f1, %f8;
    shfl.sync.bfly.b32  %f8, %f1, 8, 31, -1;
    add.f32             %f1, %f1, %f8;
    shfl.sync.bfly.b32  %f8, %f1, 4, 31, -1;
    add.f32             %f1, %f1, %f8;
    shfl.sync.bfly.b32  %f8, %f1, 2, 31, -1;
    add.f32             %f1, %f1, %f8;
    shfl.sync.bfly.b32  %f8, %f1, 1, 31, -1;
    add.f32             %f1, %f1, %f8;
    setp.ne.u32         %p1, %r4, 0;
    @%p1 bra            DONE;
    mul.wide.u32        %rd19, %r8, 4;
    setp.eq.u64         %p2, %rd5, 0;
    @%p2 bra            STORE;
    cvta.to.global.u64  %rd5, %rd5;
    add.s64             %rd20, %rd5, %rd19;
    ld.global.f32       %f10, [%rd20];
    add.f32             %f1, %f1, %f10;
STORE:
    add.s64             %rd20, %rd6, %rd19;
    st.global.f32       [%rd20], %f1;
DONE:
    ret;
}

// =============================================================================
// Kernel: gemm_q   Y[t][r] = sum_c W[r][c] * X[t][c] + resid[t][r]  for T tokens
//   (the prompt path). W is Q8_0 (type 0), Q4_1 (type 1) or Q5_K (type 2),
//   in the layouts above; X is int8 blocks (Xq [T][cols], Xds [T][cols/32]
//   from quant_q8 over the T rows). Y and resid have row stride ldy (Y can be
//   a column slice of a wider matrix); resid may be 0 and Y may equal resid.
//   rows % 64 == 0, cols % 64 == 0 (% 256 for Q5_K).
//
//   A block computes a 64-row x 64-token tile. Per 64-wide step along the
//   inner dimension (two 32-value blocks) it stores the weights as int8 q
//   (Ws[row][k], rows padded to 80 bytes so the fragment loads hit 32
//   different banks) with each block's scale and offset (w = s q + m), and
//   the activations' int8 (Xs[token][k]) with d and d * sum(q). Warp w takes
//   rows 16 (w % 4) .. +15 and tokens 32 (w / 4) .. +31: per 32-value block
//   one A fragment, four B fragments, four mma.m16n8k32 (exact int32 block
//   dot products), each scaled into the f32 sums as
//     acc += dot * (s_w d_x) + m_w (d_x sum q_x)
//   in a fixed order, so a token's result doesn't depend on the others in
//   its tile (prompt chunking doesn't change any value).
//   Launch: blockDim = 256, gridDim = (ceil(T / 64), rows / 64) - the token
//   tiles of one weight tile run back to back, so each weight is read from
//   memory about once.
// =============================================================================

// Y[tok][row] = v (+ resid[tok][row]) if tok < T
.func gm_out(.reg .b64 py, .reg .b64 presid, .reg .b32 hasr, .reg .f32 v, .reg .b32 tok,
             .reg .b32 row, .reg .b32 T, .reg .b32 ldy)
{
    .reg .pred  %q<2>;
    .reg .b64   %o<3>;
    .reg .f32   %w;
    .reg .b32   %i;

    setp.ge.u32         %q0, tok, T;
    @%q0 bra            GO_DONE;
    mad.lo.u32          %i, tok, ldy, row;
    mul.wide.u32        %o0, %i, 4;
    setp.ne.u32         %q1, hasr, 0;
    @!%q1 bra           GO_STORE;
    add.s64             %o1, presid, %o0;
    ld.global.f32       %w, [%o1];
    add.f32             v, v, %w;
GO_STORE:
    add.s64             %o2, py, %o0;
    st.global.f32       [%o2], v;
GO_DONE:
    ret;
}

.visible .entry gemm_q(
    .param .u64 p_W,            // Q8_0 q / Q4_1 qs / Q5_K blocks
    .param .u64 p_S,            // Q8_0 d (f16) / Q4_1 dm (f16x2) / unused
    .param .u64 p_X,            // s8    [T][cols]
    .param .u64 p_XS,           // f32x2 [T][cols/32]
    .param .u64 p_resid,        // f32 [T][ldy] or 0
    .param .u64 p_Y,            // f32 [T][ldy] (out)
    .param .u32 p_rows,
    .param .u32 p_cols,
    .param .u32 p_T,
    .param .u32 p_ldy,
    .param .u32 p_type          // 0 Q8_0, 1 Q4_1, 2 Q5_K
)
{
    .reg .pred  %p<12>;
    .reg .b16   %h<4>;
    .reg .b32   %r<80>;
    .reg .f32   %f<48>;
    .reg .b64   %rd<32>;
    .reg .f32   %acc<16>;
    .reg .b32   %a<4>;
    .reg .b32   %b<2>;
    .reg .b32   %c<4>;
    .reg .b32   %z, %hasr, %blk;
    .shared .align 16 .b8  gm_w[5120];          // [64 rows][80]
    .shared .align 16 .b8  gm_x[5120];          // [64 tokens][80]
    .shared .align 16 .f32 gm_ws[128];          // [2 blocks][64 rows] weight scale
    .shared .align 16 .f32 gm_wm[128];          // [2][64] weight offset
    .shared .align 16 .f32 gm_xd[128];          // [2][64 tokens] activation scale
    .shared .align 16 .f32 gm_xs[128];          // [2][64] activation scale * sum

    ld.param.u64        %rd1, [p_W];
    ld.param.u64        %rd2, [p_S];
    ld.param.u64        %rd3, [p_X];
    ld.param.u64        %rd4, [p_XS];
    ld.param.u64        %rd5, [p_resid];
    ld.param.u64        %rd6, [p_Y];
    ld.param.u32        %r1,  [p_rows];
    ld.param.u32        %r2,  [p_cols];
    ld.param.u32        %r3,  [p_T];
    ld.param.u32        %r4,  [p_ldy];
    ld.param.u32        %r5,  [p_type];
    setp.ne.u64         %p9, %rd5, 0;
    selp.b32            %hasr, 1, 0, %p9;
    cvta.to.global.u64  %rd1, %rd1;
    cvta.to.global.u64  %rd2, %rd2;
    cvta.to.global.u64  %rd3, %rd3;
    cvta.to.global.u64  %rd4, %rd4;
    cvta.to.global.u64  %rd5, %rd5;
    cvta.to.global.u64  %rd6, %rd6;
    mov.u32             %z, 0;

    mov.u32             %r6, %tid.x;
    mov.u32             %r7, %ctaid.x;
    shl.b32             %r7, %r7, 6;            // t0
    mov.u32             %r8, %ctaid.y;
    shl.b32             %r8, %r8, 6;            // r0
    shr.u32             %r9, %r2, 5;            // nb (32-value blocks per row)
    shr.u32             %r10, %r2, 8;           // Q5_K blocks per row

    // loader roles: weight row lr, block lb, half lh; token lt, quarter lq
    shr.u32             %r11, %r6, 2;           // lr = lt
    shr.u32             %r12, %r6, 1;
    and.b32             %r12, %r12, 1;          // lb
    and.b32             %r13, %r6, 1;           // lh
    add.u32             %r14, %r8, %r11;        // R
    and.b32             %r15, %r6, 3;           // lq
    add.u32             %r16, %r7, %r11;        // token
    setp.lt.u32         %p1, %r16, %r3;         // valid token
    setp.eq.u32         %p2, %r13, 0;           // lh == 0: stores the block's scales
    and.b32             %r17, %r15, 1;
    setp.eq.u32         %p3, %r17, 0;           // lq even: stores activation scales
    shr.u32             %r18, %r15, 1;          // its block

    // shared store addresses
    mov.u32             %r19, gm_w;
    mad.lo.u32          %r20, %r11, 80, %r19;
    shl.b32             %r21, %r12, 5;
    add.u32             %r20, %r20, %r21;       // &Ws[lr][32 lb]
    shl.b32             %r21, %r13, 4;
    add.u32             %r22, %r20, %r21;       // &Ws[lr][32 lb + 16 lh]
    shl.b32             %r21, %r13, 3;
    add.u32             %r23, %r20, %r21;       // &Ws[lr][32 lb + 8 lh] (Q4_1)
    shl.b32             %r24, %r12, 6;
    add.u32             %r24, %r24, %r11;
    shl.b32             %r24, %r24, 2;          // (64 lb + lr) * 4
    mov.u32             %r25, gm_ws;
    add.u32             %r25, %r25, %r24;
    mov.u32             %r26, gm_wm;
    add.u32             %r26, %r26, %r24;
    mov.u32             %r27, gm_x;
    mad.lo.u32          %r28, %r11, 80, %r27;
    shl.b32             %r21, %r15, 4;
    add.u32             %r28, %r28, %r21;       // &Xs[lt][16 lq]
    shl.b32             %r29, %r18, 6;
    add.u32             %r29, %r29, %r11;
    shl.b32             %r29, %r29, 2;          // (64 blk + lt) * 4
    mov.u32             %r30, gm_xd;
    add.u32             %r30, %r30, %r29;
    mov.u32             %r31, gm_xs;
    add.u32             %r31, %r31, %r29;

    // global row bases
    mul.wide.u32        %rd7, %r14, %r2;
    add.s64             %rd7, %rd1, %rd7;       // Q8_0: &q[R][0]
    mul.wide.u32        %rd8, %r14, %r9;        // R * nb
    mul.wide.u32        %rd9, %r14, %r10;
    mul.lo.u64          %rd9, %rd9, 176;
    add.s64             %rd9, %rd1, %rd9;       // Q5_K: row's blocks
    mul.wide.u32        %rd10, %r16, %r2;
    add.s64             %rd10, %rd3, %rd10;     // &Xq[token][0]
    mul.wide.u32        %rd11, %r16, %r9;
    shl.b64             %rd11, %rd11, 3;
    add.s64             %rd11, %rd4, %rd11;     // &Xds[token][0]

    // mma roles: warp w -> rows 16 (w % 4), tokens 32 (w / 4); lane = 4 g + t4
    shr.u32             %r32, %r6, 5;
    and.b32             %r33, %r32, 3;          // mt
    shr.u32             %r34, %r32, 2;          // nh
    and.b32             %r35, %r6, 31;
    shr.u32             %r36, %r35, 2;          // g
    and.b32             %r37, %r35, 3;          // t4
    shl.b32             %r38, %r33, 4;
    add.u32             %r38, %r38, %r36;       // 16 mt + g
    mad.lo.u32          %r39, %r38, 80, %r19;
    shl.b32             %r40, %r37, 2;
    add.u32             %r39, %r39, %r40;       // A: &Ws[16 mt + g][4 t4]
    shl.b32             %r41, %r34, 5;
    add.u32             %r41, %r41, %r36;       // 32 nh + g
    mad.lo.u32          %r42, %r41, 80, %r27;
    add.u32             %r42, %r42, %r40;       // B: &Xs[32 nh + g][4 t4]
    shl.b32             %r43, %r38, 2;
    mov.u32             %r44, gm_ws;
    add.u32             %r44, %r44, %r43;       // &ws[0][16 mt + g]
    mov.u32             %r45, gm_wm;
    add.u32             %r45, %r45, %r43;
    shl.b32             %r46, %r34, 5;
    shl.b32             %r47, %r37, 1;
    add.u32             %r46, %r46, %r47;
    shl.b32             %r46, %r46, 2;          // (32 nh + 2 t4) * 4
    mov.u32             %r47, gm_xd;
    add.u32             %r47, %r47, %r46;
    mov.u32             %r48, gm_xs;
    add.u32             %r48, %r48, %r46;

    mov.f32             %acc0, 0f00000000;
    mov.f32             %acc1, 0f00000000;
    mov.f32             %acc2, 0f00000000;
    mov.f32             %acc3, 0f00000000;
    mov.f32             %acc4, 0f00000000;
    mov.f32             %acc5, 0f00000000;
    mov.f32             %acc6, 0f00000000;
    mov.f32             %acc7, 0f00000000;
    mov.f32             %acc8, 0f00000000;
    mov.f32             %acc9, 0f00000000;
    mov.f32             %acc10, 0f00000000;
    mov.f32             %acc11, 0f00000000;
    mov.f32             %acc12, 0f00000000;
    mov.f32             %acc13, 0f00000000;
    mov.f32             %acc14, 0f00000000;
    mov.f32             %acc15, 0f00000000;

    mov.u32             %r49, 0;                // k0
KSTEP:
    setp.ge.u32         %p4, %r49, %r2;
    @%p4 bra            EPILOGUE;
    shr.u32             %r50, %r49, 5;
    add.u32             %r50, %r50, %r12;       // block index of (k0, lb) in the row
    setp.eq.u32         %p5, %r5, 1;
    @%p5 bra            LOAD_Q4_1;
    setp.eq.u32         %p5, %r5, 2;
    @%p5 bra            LOAD_Q5_K;

    // ---- Q8_0: 16 int8 at k0 + 32 lb + 16 lh ----
    shl.b32             %r51, %r50, 5;
    shl.b32             %r52, %r13, 4;
    add.u32             %r51, %r51, %r52;
    cvt.u64.u32         %rd12, %r51;
    add.s64             %rd12, %rd7, %rd12;
    ld.global.nc.v4.u32 {%r53, %r54, %r55, %r56}, [%rd12];
    st.shared.v4.u32    [%r22], {%r53, %r54, %r55, %r56};
    @!%p2 bra           LOAD_X;
    cvt.u64.u32         %rd13, %r50;
    add.s64             %rd13, %rd8, %rd13;
    shl.b64             %rd13, %rd13, 1;
    add.s64             %rd13, %rd2, %rd13;
    ld.global.nc.b16    %h0, [%rd13];
    cvt.f32.f16         %f1, %h0;
    st.shared.f32       [%r25], %f1;
    st.shared.f32       [%r26], 0f00000000;
    bra.uni             LOAD_X;

LOAD_Q4_1:
    // 8 qs bytes: values 8 lh .. +7 (low nibbles) and 16 + 8 lh .. +7 (high)
    cvt.u64.u32         %rd13, %r50;
    add.s64             %rd13, %rd8, %rd13;     // block
    shl.b64             %rd12, %rd13, 4;
    add.s64             %rd12, %rd1, %rd12;
    shl.b32             %r52, %r13, 3;
    cvt.u64.u32         %rd14, %r52;
    add.s64             %rd12, %rd12, %rd14;
    ld.global.nc.v2.u32 {%r53, %r54}, [%rd12];
    and.b32             %r55, %r53, 0x0F0F0F0F;
    and.b32             %r56, %r54, 0x0F0F0F0F;
    st.shared.v2.u32    [%r23], {%r55, %r56};
    shr.u32             %r55, %r53, 4;
    and.b32             %r55, %r55, 0x0F0F0F0F;
    shr.u32             %r56, %r54, 4;
    and.b32             %r56, %r56, 0x0F0F0F0F;
    st.shared.v2.u32    [%r23+16], {%r55, %r56};
    @!%p2 bra           LOAD_X;
    shl.b64             %rd13, %rd13, 2;
    add.s64             %rd13, %rd2, %rd13;
    ld.global.nc.u32    %r57, [%rd13];
    mov.b32             {%h0, %h1}, %r57;
    cvt.f32.f16         %f1, %h0;
    cvt.f32.f16         %f2, %h1;
    st.shared.f32       [%r25], %f1;
    st.shared.f32       [%r26], %f2;
    bra.uni             LOAD_X;

LOAD_Q5_K:
    // sub-block s = (k0 / 32) % 8 + lb of block k0 / 256; values 16 lh .. +15
    shr.u32             %r51, %r49, 8;
    mul.wide.u32        %rd12, %r51, 176;
    add.s64             %rd12, %rd9, %rd12;     // block
    and.b32             %r58, %r50, 7;          // s
    ld.global.nc.v4.u32 {%r60, %r61, %r62, %r63}, [%rd12];      // d dmin | scales
    shr.u32             %r52, %r58, 1;
    shl.b32             %r52, %r52, 5;
    shl.b32             %r51, %r13, 4;
    add.u32             %r52, %r52, %r51;
    cvt.u64.u32         %rd13, %r52;
    add.s64             %rd13, %rd12, %rd13;
    ld.global.nc.v4.u32 {%r64, %r65, %r66, %r67}, [%rd13+48];  // qs[32 (s/2) + 16 lh ..]
    cvt.u64.u32         %rd14, %r51;
    add.s64             %rd14, %rd12, %rd14;
    ld.global.nc.v4.u32 {%r68, %r69, %r70, %r71}, [%rd14+16];  // qh[16 lh ..]
    and.b32             %r59, %r58, 1;
    shl.b32             %r59, %r59, 2;          // nibble shift
    shr.u32             %r64, %r64, %r59;
    and.b32             %r64, %r64, 0x0F0F0F0F;
    shr.u32             %r68, %r68, %r58;
    and.b32             %r68, %r68, 0x01010101;
    shl.b32             %r68, %r68, 4;
    or.b32              %r64, %r64, %r68;
    shr.u32             %r65, %r65, %r59;
    and.b32             %r65, %r65, 0x0F0F0F0F;
    shr.u32             %r69, %r69, %r58;
    and.b32             %r69, %r69, 0x01010101;
    shl.b32             %r69, %r69, 4;
    or.b32              %r65, %r65, %r69;
    shr.u32             %r66, %r66, %r59;
    and.b32             %r66, %r66, 0x0F0F0F0F;
    shr.u32             %r70, %r70, %r58;
    and.b32             %r70, %r70, 0x01010101;
    shl.b32             %r70, %r70, 4;
    or.b32              %r66, %r66, %r70;
    shr.u32             %r67, %r67, %r59;
    and.b32             %r67, %r67, 0x0F0F0F0F;
    shr.u32             %r71, %r71, %r58;
    and.b32             %r71, %r71, 0x01010101;
    shl.b32             %r71, %r71, 4;
    or.b32              %r67, %r67, %r71;
    st.shared.v4.u32    [%r22], {%r64, %r65, %r66, %r67};
    @!%p2 bra           LOAD_X;
    // scale and min of s (see mv_q5_k)
    and.b32             %r72, %r58, 3;
    shl.b32             %r72, %r72, 3;
    add.u32             %r73, %r72, 6;
    add.u32             %r74, %r72, 4;
    bfe.u32             %r75, %r61, %r72, 6;
    bfe.u32             %r76, %r62, %r72, 6;
    bfe.u32             %r77, %r63, %r72, 4;
    bfe.u32             %r78, %r61, %r73, 2;
    shl.b32             %r78, %r78, 4;
    or.b32              %r77, %r77, %r78;
    bfe.u32             %r79, %r63, %r74, 4;
    bfe.u32             %r78, %r62, %r73, 2;
    shl.b32             %r78, %r78, 4;
    or.b32              %r79, %r79, %r78;
    setp.lt.u32         %p6, %r58, 4;
    selp.b32            %r75, %r75, %r77, %p6;  // sc
    selp.b32            %r76, %r76, %r79, %p6;  // m
    mov.b32             {%h0, %h1}, %r60;
    cvt.f32.f16         %f1, %h0;
    cvt.f32.f16         %f2, %h1;
    cvt.rn.f32.u32      %f3, %r75;
    mul.f32             %f1, %f1, %f3;
    cvt.rn.f32.u32      %f4, %r76;
    mul.f32             %f2, %f2, %f4;
    neg.f32             %f2, %f2;
    st.shared.f32       [%r25], %f1;
    st.shared.f32       [%r26], %f2;

LOAD_X:
    mov.u32             %r53, 0;
    mov.u32             %r54, 0;
    mov.u32             %r55, 0;
    mov.u32             %r56, 0;
    shl.b32             %r51, %r15, 4;
    add.u32             %r51, %r51, %r49;
    cvt.u64.u32         %rd15, %r51;
    add.s64             %rd15, %rd10, %rd15;
    @%p1 ld.global.nc.v4.u32 {%r53, %r54, %r55, %r56}, [%rd15];
    st.shared.v4.u32    [%r28], {%r53, %r54, %r55, %r56};
    @!%p3 bra           MMA;
    mov.f32             %f5, 0f00000000;
    mov.f32             %f6, 0f00000000;
    shr.u32             %r51, %r49, 5;
    add.u32             %r51, %r51, %r18;
    mul.wide.u32        %rd16, %r51, 8;
    add.s64             %rd16, %rd11, %rd16;
    @%p1 ld.global.nc.v2.f32 {%f5, %f6}, [%rd16];
    st.shared.f32       [%r30], %f5;
    st.shared.f32       [%r31], %f6;

MMA:
    bar.sync            0;
    mov.u32             %blk, 0;
BLK:
    // A fragment and the rows' scales for block blk
    shl.b32             %r51, %blk, 5;
    add.u32             %r52, %r39, %r51;
    ld.shared.u32       %a0, [%r52];
    ld.shared.u32       %a1, [%r52+640];
    ld.shared.u32       %a2, [%r52+16];
    ld.shared.u32       %a3, [%r52+656];
    shl.b32             %r57, %blk, 8;          // 64 floats
    add.u32             %r58, %r44, %r57;
    ld.shared.f32       %f10, [%r58];           // s_w row g
    ld.shared.f32       %f11, [%r58+32];        // s_w row g + 8
    add.u32             %r58, %r45, %r57;
    ld.shared.f32       %f12, [%r58];           // m_w row g
    ld.shared.f32       %f13, [%r58+32];        // m_w row g + 8
    add.u32             %r59, %r42, %r51;       // B base for this block
    add.u32             %r60, %r47, %r57;       // &xd[blk][32 nh + 2 t4]
    add.u32             %r61, %r48, %r57;
    // n-tile 0: tokens 32 nh + 8*0 ..
    ld.shared.u32       %b0, [%r59+0];
    ld.shared.u32       %b1, [%r59+16];
    mma.sync.aligned.m16n8k32.row.col.s32.s8.s8.s32 {%c0, %c1, %c2, %c3}, {%a0, %a1, %a2, %a3}, {%b0, %b1}, {%z, %z, %z, %z};
    ld.shared.v2.f32    {%f14, %f15}, [%r60+0];   // d_x tokens 2 t4, 2 t4 + 1
    ld.shared.v2.f32    {%f16, %f17}, [%r61+0];   // d_x sum q_x
    cvt.rn.f32.s32      %f20, %c0;
    cvt.rn.f32.s32      %f21, %c1;
    cvt.rn.f32.s32      %f22, %c2;
    cvt.rn.f32.s32      %f23, %c3;
    mul.f32             %f24, %f10, %f14;
    mul.f32             %f25, %f10, %f15;
    mul.f32             %f26, %f11, %f14;
    mul.f32             %f27, %f11, %f15;
    fma.rn.f32          %acc0, %f20, %f24, %acc0;
    fma.rn.f32          %acc0, %f12, %f16, %acc0;
    fma.rn.f32          %acc1, %f21, %f25, %acc1;
    fma.rn.f32          %acc1, %f12, %f17, %acc1;
    fma.rn.f32          %acc2, %f22, %f26, %acc2;
    fma.rn.f32          %acc2, %f13, %f16, %acc2;
    fma.rn.f32          %acc3, %f23, %f27, %acc3;
    fma.rn.f32          %acc3, %f13, %f17, %acc3;
    // n-tile 1: tokens 32 nh + 8*1 ..
    ld.shared.u32       %b0, [%r59+640];
    ld.shared.u32       %b1, [%r59+656];
    mma.sync.aligned.m16n8k32.row.col.s32.s8.s8.s32 {%c0, %c1, %c2, %c3}, {%a0, %a1, %a2, %a3}, {%b0, %b1}, {%z, %z, %z, %z};
    ld.shared.v2.f32    {%f14, %f15}, [%r60+32];   // d_x tokens 2 t4, 2 t4 + 1
    ld.shared.v2.f32    {%f16, %f17}, [%r61+32];   // d_x sum q_x
    cvt.rn.f32.s32      %f20, %c0;
    cvt.rn.f32.s32      %f21, %c1;
    cvt.rn.f32.s32      %f22, %c2;
    cvt.rn.f32.s32      %f23, %c3;
    mul.f32             %f24, %f10, %f14;
    mul.f32             %f25, %f10, %f15;
    mul.f32             %f26, %f11, %f14;
    mul.f32             %f27, %f11, %f15;
    fma.rn.f32          %acc4, %f20, %f24, %acc4;
    fma.rn.f32          %acc4, %f12, %f16, %acc4;
    fma.rn.f32          %acc5, %f21, %f25, %acc5;
    fma.rn.f32          %acc5, %f12, %f17, %acc5;
    fma.rn.f32          %acc6, %f22, %f26, %acc6;
    fma.rn.f32          %acc6, %f13, %f16, %acc6;
    fma.rn.f32          %acc7, %f23, %f27, %acc7;
    fma.rn.f32          %acc7, %f13, %f17, %acc7;
    // n-tile 2: tokens 32 nh + 8*2 ..
    ld.shared.u32       %b0, [%r59+1280];
    ld.shared.u32       %b1, [%r59+1296];
    mma.sync.aligned.m16n8k32.row.col.s32.s8.s8.s32 {%c0, %c1, %c2, %c3}, {%a0, %a1, %a2, %a3}, {%b0, %b1}, {%z, %z, %z, %z};
    ld.shared.v2.f32    {%f14, %f15}, [%r60+64];   // d_x tokens 2 t4, 2 t4 + 1
    ld.shared.v2.f32    {%f16, %f17}, [%r61+64];   // d_x sum q_x
    cvt.rn.f32.s32      %f20, %c0;
    cvt.rn.f32.s32      %f21, %c1;
    cvt.rn.f32.s32      %f22, %c2;
    cvt.rn.f32.s32      %f23, %c3;
    mul.f32             %f24, %f10, %f14;
    mul.f32             %f25, %f10, %f15;
    mul.f32             %f26, %f11, %f14;
    mul.f32             %f27, %f11, %f15;
    fma.rn.f32          %acc8, %f20, %f24, %acc8;
    fma.rn.f32          %acc8, %f12, %f16, %acc8;
    fma.rn.f32          %acc9, %f21, %f25, %acc9;
    fma.rn.f32          %acc9, %f12, %f17, %acc9;
    fma.rn.f32          %acc10, %f22, %f26, %acc10;
    fma.rn.f32          %acc10, %f13, %f16, %acc10;
    fma.rn.f32          %acc11, %f23, %f27, %acc11;
    fma.rn.f32          %acc11, %f13, %f17, %acc11;
    // n-tile 3: tokens 32 nh + 8*3 ..
    ld.shared.u32       %b0, [%r59+1920];
    ld.shared.u32       %b1, [%r59+1936];
    mma.sync.aligned.m16n8k32.row.col.s32.s8.s8.s32 {%c0, %c1, %c2, %c3}, {%a0, %a1, %a2, %a3}, {%b0, %b1}, {%z, %z, %z, %z};
    ld.shared.v2.f32    {%f14, %f15}, [%r60+96];   // d_x tokens 2 t4, 2 t4 + 1
    ld.shared.v2.f32    {%f16, %f17}, [%r61+96];   // d_x sum q_x
    cvt.rn.f32.s32      %f20, %c0;
    cvt.rn.f32.s32      %f21, %c1;
    cvt.rn.f32.s32      %f22, %c2;
    cvt.rn.f32.s32      %f23, %c3;
    mul.f32             %f24, %f10, %f14;
    mul.f32             %f25, %f10, %f15;
    mul.f32             %f26, %f11, %f14;
    mul.f32             %f27, %f11, %f15;
    fma.rn.f32          %acc12, %f20, %f24, %acc12;
    fma.rn.f32          %acc12, %f12, %f16, %acc12;
    fma.rn.f32          %acc13, %f21, %f25, %acc13;
    fma.rn.f32          %acc13, %f12, %f17, %acc13;
    fma.rn.f32          %acc14, %f22, %f26, %acc14;
    fma.rn.f32          %acc14, %f13, %f16, %acc14;
    fma.rn.f32          %acc15, %f23, %f27, %acc15;
    fma.rn.f32          %acc15, %f13, %f17, %acc15;
    add.u32             %blk, %blk, 1;
    setp.lt.u32         %p7, %blk, 2;
    @%p7 bra            BLK;
    bar.sync            0;
    add.u32             %r49, %r49, 64;
    bra.uni             KSTEP;

EPILOGUE:
    // c0, c1: row 16 mt + g, tokens 2 t4, 2 t4 + 1; c2, c3: row + 8
    add.u32             %r62, %r8, %r38;        // row A
    add.u32             %r63, %r62, 8;          // row B
    shl.b32             %r64, %r34, 5;
    add.u32             %r64, %r64, %r7;
    shl.b32             %r65, %r37, 1;
    add.u32             %r64, %r64, %r65;       // token of n-tile 0, c0
    add.u32             %r66, %r64, 0;
    add.u32             %r67, %r66, 1;
    call.uni            gm_out, (%rd6, %rd5, %hasr, %acc0, %r66, %r62, %r3, %r4);
    call.uni            gm_out, (%rd6, %rd5, %hasr, %acc1, %r67, %r62, %r3, %r4);
    call.uni            gm_out, (%rd6, %rd5, %hasr, %acc2, %r66, %r63, %r3, %r4);
    call.uni            gm_out, (%rd6, %rd5, %hasr, %acc3, %r67, %r63, %r3, %r4);
    add.u32             %r66, %r64, 8;
    add.u32             %r67, %r66, 1;
    call.uni            gm_out, (%rd6, %rd5, %hasr, %acc4, %r66, %r62, %r3, %r4);
    call.uni            gm_out, (%rd6, %rd5, %hasr, %acc5, %r67, %r62, %r3, %r4);
    call.uni            gm_out, (%rd6, %rd5, %hasr, %acc6, %r66, %r63, %r3, %r4);
    call.uni            gm_out, (%rd6, %rd5, %hasr, %acc7, %r67, %r63, %r3, %r4);
    add.u32             %r66, %r64, 16;
    add.u32             %r67, %r66, 1;
    call.uni            gm_out, (%rd6, %rd5, %hasr, %acc8, %r66, %r62, %r3, %r4);
    call.uni            gm_out, (%rd6, %rd5, %hasr, %acc9, %r67, %r62, %r3, %r4);
    call.uni            gm_out, (%rd6, %rd5, %hasr, %acc10, %r66, %r63, %r3, %r4);
    call.uni            gm_out, (%rd6, %rd5, %hasr, %acc11, %r67, %r63, %r3, %r4);
    add.u32             %r66, %r64, 24;
    add.u32             %r67, %r66, 1;
    call.uni            gm_out, (%rd6, %rd5, %hasr, %acc12, %r66, %r62, %r3, %r4);
    call.uni            gm_out, (%rd6, %rd5, %hasr, %acc13, %r67, %r62, %r3, %r4);
    call.uni            gm_out, (%rd6, %rd5, %hasr, %acc14, %r66, %r63, %r3, %r4);
    call.uni            gm_out, (%rd6, %rd5, %hasr, %acc15, %r67, %r63, %r3, %r4);
    ret;
}

// =============================================================================
// Gated DeltaNet (linear attention) kernels. Per layer the conv state holds the
// last 3 tokens' qkv inputs (f32 [3][C], oldest first) and the recurrent
// state S the 32 heads' 128 x 128 matrices (f32 [h][i][j], i = key dim,
// j = value dim).
// =============================================================================

// -----------------------------------------------------------------------------
// Kernel: gdn_conv   out[t][c] = silu(sum_{s<4} w[c][s] x_{t-3+s}[c]) for the C
//   channels of qkv (q 2048 | k 2048 | v 4096), where x_u is in[u] for u >= 0
//   and the conv state's row 3 + u before the chunk (u < 0). The first nnorm
//   128-channel heads (q and k) are then L2-normalized: y / sqrt(sum y^2 + eps)
//   (llama.cpp's rms_norm(eps / 128) / sqrt(128)).
//   Launch: gridDim = (C / 128, T), blockDim = 128.
// -----------------------------------------------------------------------------
.visible .entry gdn_conv(
    .param .u64 p_in,           // f32 [T][ld] (qkv first)
    .param .u32 p_ld,
    .param .u64 p_state,        // f32 [3][C]
    .param .u64 p_w,            // f32 [C][4]
    .param .u64 p_out,          // f32 [T][C] (out)
    .param .u32 p_C,
    .param .u32 p_nnorm,
    .param .f32 p_eps
)
{
    .reg .pred  %p<8>;
    .reg .b32   %r<24>;
    .reg .f32   %f<24>;
    .reg .b64   %rd<16>;
    .shared .align 16 .f32 gc_red[4];

    ld.param.u64        %rd1, [p_in];
    ld.param.u32        %r1,  [p_ld];
    ld.param.u64        %rd2, [p_state];
    ld.param.u64        %rd3, [p_w];
    ld.param.u64        %rd4, [p_out];
    ld.param.u32        %r2,  [p_C];
    ld.param.u32        %r3,  [p_nnorm];
    ld.param.f32        %f1,  [p_eps];
    cvta.to.global.u64  %rd1, %rd1;
    cvta.to.global.u64  %rd2, %rd2;
    cvta.to.global.u64  %rd3, %rd3;
    cvta.to.global.u64  %rd4, %rd4;

    mov.u32             %r4, %tid.x;
    mov.u32             %r5, %ctaid.x;          // head
    mov.u32             %r6, %ctaid.y;          // t
    shl.b32             %r7, %r5, 7;
    add.u32             %r7, %r7, %r4;          // channel
    mul.wide.u32        %rd5, %r7, 16;
    add.s64             %rd5, %rd3, %rd5;
    ld.global.nc.v4.f32 {%f2, %f3, %f4, %f5}, [%rd5];   // w[c][0..3]

    // inputs u = t - 3 .. t
    mov.f32             %f6, 0f00000000;        // sum
    mov.u32             %r8, 0;                 // s
TAP:
    add.u32             %r9, %r6, %r8;          // u + 3
    setp.lt.u32         %p1, %r9, 3;
    @%p1 bra            FROM_STATE;
    sub.u32             %r10, %r9, 3;
    mad.lo.u32          %r10, %r10, %r1, %r7;
    mul.wide.u32        %rd6, %r10, 4;
    add.s64             %rd6, %rd1, %rd6;
    ld.global.f32       %f7, [%rd6];
    bra.uni             HAVE_X;
FROM_STATE:
    mad.lo.u32          %r10, %r9, %r2, %r7;
    mul.wide.u32        %rd6, %r10, 4;
    add.s64             %rd6, %rd2, %rd6;
    ld.global.f32       %f7, [%rd6];
HAVE_X:
    setp.eq.u32         %p2, %r8, 0;
    setp.eq.u32         %p3, %r8, 1;
    setp.eq.u32         %p4, %r8, 2;
    mov.f32             %f8, %f5;
    @%p2 mov.f32        %f8, %f2;
    @%p3 mov.f32        %f8, %f3;
    @%p4 mov.f32        %f8, %f4;
    fma.rn.f32          %f6, %f7, %f8, %f6;
    add.u32             %r8, %r8, 1;
    setp.lt.u32         %p5, %r8, 4;
    @%p5 bra            TAP;

    // silu(x) = x / (1 + exp(-x))
    mul.f32             %f9, %f6, 0fBFB8AA3B;   // -x log2(e)
    ex2.approx.f32      %f9, %f9;
    add.f32             %f9, %f9, 0f3F800000;
    div.rn.f32          %f10, %f6, %f9;

    setp.ge.u32         %p6, %r5, %r3;
    @%p6 bra            STORE;
    // L2 norm over the head's 128 channels (block-uniform branch)
    mul.f32             %f11, %f10, %f10;
    shfl.sync.bfly.b32  %f12, %f11, 16, 31, -1;
    add.f32             %f11, %f11, %f12;
    shfl.sync.bfly.b32  %f12, %f11, 8, 31, -1;
    add.f32             %f11, %f11, %f12;
    shfl.sync.bfly.b32  %f12, %f11, 4, 31, -1;
    add.f32             %f11, %f11, %f12;
    shfl.sync.bfly.b32  %f12, %f11, 2, 31, -1;
    add.f32             %f11, %f11, %f12;
    shfl.sync.bfly.b32  %f12, %f11, 1, 31, -1;
    add.f32             %f11, %f11, %f12;
    and.b32             %r11, %r4, 31;
    shr.u32             %r12, %r4, 5;
    setp.eq.u32         %p7, %r11, 0;
    mov.u32             %r13, gc_red;
    shl.b32             %r14, %r12, 2;
    add.u32             %r14, %r13, %r14;
    @%p7 st.shared.f32  [%r14], %f11;
    bar.sync            0;
    ld.shared.v4.f32    {%f13, %f14, %f15, %f16}, [gc_red];
    add.f32             %f13, %f13, %f14;
    add.f32             %f15, %f15, %f16;
    add.f32             %f13, %f13, %f15;
    add.f32             %f13, %f13, %f1;
    sqrt.rn.f32         %f13, %f13;
    rcp.rn.f32          %f13, %f13;
    mul.f32             %f10, %f10, %f13;
STORE:
    mad.lo.u32          %r15, %r6, %r2, %r7;
    mul.wide.u32        %rd7, %r15, 4;
    add.s64             %rd7, %rd4, %rd7;
    st.global.f32       [%rd7], %f10;
    ret;
}

// -----------------------------------------------------------------------------
// Kernel: conv_save   conv state <- the last 3 of [state (3 rows); in (T rows)]
//   (run after gdn_conv). A thread owns a channel and writes rows 0, 1, 2 in
//   order, so with T < 3 it reads state rows before they are overwritten.
//   Grid-stride over the C channels.
// -----------------------------------------------------------------------------
.visible .entry conv_save(
    .param .u64 p_in,           // f32 [T][ld]
    .param .u32 p_ld,
    .param .u64 p_state,        // f32 [3][C] (updated)
    .param .u32 p_C,
    .param .u32 p_T
)
{
    .reg .pred  %p<4>;
    .reg .b32   %r<16>;
    .reg .f32   %f<4>;
    .reg .b64   %rd<8>;

    ld.param.u64        %rd1, [p_in];
    ld.param.u32        %r1,  [p_ld];
    ld.param.u64        %rd2, [p_state];
    ld.param.u32        %r2,  [p_C];
    ld.param.u32        %r3,  [p_T];
    cvta.to.global.u64  %rd1, %rd1;
    cvta.to.global.u64  %rd2, %rd2;
    mov.u32             %r4, %tid.x;
    mov.u32             %r5, %ntid.x;
    mov.u32             %r6, %ctaid.x;
    mov.u32             %r7, %nctaid.x;
    mad.lo.u32          %r8, %r6, %r5, %r4;     // channel
    mul.lo.u32          %r9, %r7, %r5;
CH:
    setp.ge.u32         %p1, %r8, %r2;
    @%p1 bra            DONE;
    mov.u32             %r10, 0;                // row
ROW:
    add.u32             %r11, %r3, %r10;        // source index in [state; in]
    setp.lt.u32         %p2, %r11, 3;
    @%p2 bra            SRC_STATE;
    sub.u32             %r12, %r11, 3;
    mad.lo.u32          %r12, %r12, %r1, %r8;
    mul.wide.u32        %rd3, %r12, 4;
    add.s64             %rd3, %rd1, %rd3;
    bra.uni             COPY;
SRC_STATE:
    mad.lo.u32          %r12, %r11, %r2, %r8;
    mul.wide.u32        %rd3, %r12, 4;
    add.s64             %rd3, %rd2, %rd3;
COPY:
    ld.global.f32       %f1, [%rd3];
    mad.lo.u32          %r13, %r10, %r2, %r8;
    mul.wide.u32        %rd4, %r13, 4;
    add.s64             %rd4, %rd2, %rd4;
    st.global.f32       [%rd4], %f1;
    add.u32             %r10, %r10, 1;
    setp.lt.u32         %p3, %r10, 3;
    @%p3 bra            ROW;
    add.u32             %r8, %r8, %r9;
    bra.uni             CH;
DONE:
    ret;
}

// -----------------------------------------------------------------------------
// Kernel: gdn_recur   the gated delta rule over T tokens, for v head h and 32
//   of its 128 value columns j (k and q from head h % 16, llama.cpp's
//   mapping), as llama.cpp's fused CUDA kernel computes it:
//     b = sigmoid(beta_t[h]),  g = exp(softplus(alpha_t[h] + dt_bias[h]) * a[h])
//     kv_j = sum_i S[i][j] k_i,  delta_j = (v_j - g kv_j) b
//     S[i][j] = g S[i][j] + k_i delta_j,  out_j = scale * sum_i S[i][j] q_i
//   softplus(x) = x for x > 20, else log(1 + exp(x)). The block's 128 x 32
//   slice of S stays in shared memory (thread j owns column j: conflict-free)
//   for the whole chunk and is written back at the end.
//   Launch: gridDim = (32 heads, 4), blockDim = 32.
// -----------------------------------------------------------------------------
.visible .entry gdn_recur(
    .param .u64 p_qkv,          // f32 [T][8192]: q 0.., k 2048.., v 4096..
    .param .u64 p_ba,           // f32 [T][64]: beta 0..31, alpha 32..63
    .param .u64 p_dt,           // f32 [32]
    .param .u64 p_a,            // f32 [32]
    .param .u64 p_state,        // f32 [32][128][128] (updated)
    .param .u64 p_out,          // f32 [T][4096] (out)
    .param .u32 p_T,
    .param .f32 p_scale
)
{
    .reg .pred  %p<4>;
    .reg .b32   %r<24>;
    .reg .f32   %f<48>;
    .reg .b64   %rd<20>;
    .shared .align 16 .f32 gr_s[4096];          // [128 i][32 j]
    .shared .align 16 .f32 gr_k[128];
    .shared .align 16 .f32 gr_q[128];

    ld.param.u64        %rd1, [p_qkv];
    ld.param.u64        %rd2, [p_ba];
    ld.param.u64        %rd3, [p_dt];
    ld.param.u64        %rd4, [p_a];
    ld.param.u64        %rd5, [p_state];
    ld.param.u64        %rd6, [p_out];
    ld.param.u32        %r1,  [p_T];
    ld.param.f32        %f1,  [p_scale];
    cvta.to.global.u64  %rd1, %rd1;
    cvta.to.global.u64  %rd2, %rd2;
    cvta.to.global.u64  %rd3, %rd3;
    cvta.to.global.u64  %rd4, %rd4;
    cvta.to.global.u64  %rd5, %rd5;
    cvta.to.global.u64  %rd6, %rd6;

    mov.u32             %r2, %ctaid.x;          // h
    mov.u32             %r3, %ctaid.y;
    mov.u32             %r4, %tid.x;            // lane
    shl.b32             %r5, %r3, 5;
    add.u32             %r5, %r5, %r4;          // j
    and.b32             %r6, %r2, 15;           // k / q head
    mul.wide.u32        %rd7, %r2, 4;
    add.s64             %rd8, %rd3, %rd7;
    ld.global.nc.f32    %f2, [%rd8];            // dt_bias[h]
    add.s64             %rd8, %rd4, %rd7;
    ld.global.nc.f32    %f3, [%rd8];            // a[h]

    // S slice -> shared: global [h][i][j], shared [i][lane]
    shl.b32             %r7, %r2, 14;           // h * 128 * 128
    add.u32             %r7, %r7, %r5;
    mul.wide.u32        %rd9, %r7, 4;
    add.s64             %rd9, %rd5, %rd9;       // &S[h][0][j]
    mov.u32             %r8, gr_s;
    shl.b32             %r9, %r4, 2;
    add.u32             %r9, %r8, %r9;          // &Ss[0][lane]
    mov.u32             %r10, 0;
    mov.u64             %rd10, %rd9;
    mov.u32             %r11, %r9;
LOAD_S:
    ld.global.f32       %f4, [%rd10];
    st.shared.f32       [%r11], %f4;
    add.s64             %rd10, %rd10, 512;
    add.u32             %r11, %r11, 128;
    add.u32             %r10, %r10, 1;
    setp.lt.u32         %p1, %r10, 128;
    @%p1 bra            LOAD_S;

    // per-token pointers
    shl.b32             %r12, %r6, 7;
    shl.b32             %r13, %r4, 2;
    add.u32             %r12, %r12, %r13;       // kh * 128 + 4 lane
    mul.wide.u32        %rd11, %r12, 4;
    add.s64             %rd11, %rd1, %rd11;     // &q[0][kh][4 lane]; k is 8192 bytes on
    shl.b32             %r14, %r2, 7;
    add.u32             %r14, %r14, %r5;        // h * 128 + j
    add.u32             %r15, %r14, 4096;
    mul.wide.u32        %rd12, %r15, 4;
    add.s64             %rd12, %rd1, %rd12;     // &v[0][h][j]
    mul.wide.u32        %rd13, %r14, 4;
    add.s64             %rd13, %rd6, %rd13;     // &out[0][h][j]
    mul.wide.u32        %rd14, %r2, 4;
    add.s64             %rd14, %rd2, %rd14;     // &beta[0][h]
    shl.b32             %r13, %r4, 4;           // 16 bytes per lane
    mov.u32             %r16, gr_k;
    add.u32             %r17, %r16, %r13;
    mov.u32             %r18, gr_q;
    add.u32             %r19, %r18, %r13;

    mov.u32             %r20, 0;                // t
TOKEN:
    setp.ge.u32         %p1, %r20, %r1;
    @%p1 bra            SAVE;
    bar.warp.sync       -1;                     // previous token done with k, q
    ld.global.v4.f32    {%f4, %f5, %f6, %f7}, [%rd11];
    ld.global.v4.f32    {%f8, %f9, %f10, %f11}, [%rd11+8192];
    st.shared.v4.f32    [%r19], {%f4, %f5, %f6, %f7};
    st.shared.v4.f32    [%r17], {%f8, %f9, %f10, %f11};
    ld.global.f32       %f12, [%rd12];          // v_j
    ld.global.f32       %f13, [%rd14];          // beta logit
    ld.global.f32       %f14, [%rd14+128];      // alpha
    // b = sigmoid(beta)
    mul.f32             %f15, %f13, 0fBFB8AA3B;
    ex2.approx.f32      %f15, %f15;
    add.f32             %f15, %f15, 0f3F800000;
    rcp.rn.f32          %f15, %f15;
    // g = exp(softplus(alpha + dt) * a)
    add.f32             %f16, %f14, %f2;
    mul.f32             %f17, %f16, 0f3FB8AA3B;
    ex2.approx.f32      %f17, %f17;
    add.f32             %f17, %f17, 0f3F800000;
    lg2.approx.f32      %f17, %f17;
    mul.f32             %f17, %f17, 0f3F317218; // ln(1 + e^x)
    setp.gt.f32         %p2, %f16, 0f41A00000;  // x > 20
    selp.f32            %f17, %f16, %f17, %p2;
    mul.f32             %f17, %f17, %f3;
    mul.f32             %f17, %f17, 0f3FB8AA3B;
    ex2.approx.f32      %f17, %f17;             // g
    bar.warp.sync       -1;

    // kv = sum_i S[i][j] k_i
    mov.f32             %f18, 0f00000000;
    mov.u32             %r21, %r9;              // &Ss[i][lane]
    mov.u32             %r22, %r16;             // &k[i]
    add.u32             %r23, %r16, 512;
KV:
    ld.shared.v4.f32    {%f20, %f21, %f22, %f23}, [%r22];
    ld.shared.f32       %f24, [%r21];
    ld.shared.f32       %f25, [%r21+128];
    ld.shared.f32       %f26, [%r21+256];
    ld.shared.f32       %f27, [%r21+384];
    fma.rn.f32          %f18, %f24, %f20, %f18;
    fma.rn.f32          %f18, %f25, %f21, %f18;
    fma.rn.f32          %f18, %f26, %f22, %f18;
    fma.rn.f32          %f18, %f27, %f23, %f18;
    add.u32             %r21, %r21, 512;
    add.u32             %r22, %r22, 16;
    setp.lt.u32         %p3, %r22, %r23;
    @%p3 bra            KV;

    // delta = (v - g kv) b
    mul.f32             %f19, %f17, %f18;
    sub.f32             %f19, %f12, %f19;
    mul.f32             %f19, %f19, %f15;

    // S = g S + k delta, o = sum_i S[i][j] q_i
    mov.f32             %f28, 0f00000000;
    mov.u32             %r21, %r9;
    mov.u32             %r22, %r16;
    mov.u32             %r13, %r18;             // &q[i]
UPD:
    ld.shared.v4.f32    {%f20, %f21, %f22, %f23}, [%r22];
    ld.shared.v4.f32    {%f30, %f31, %f32, %f33}, [%r13];
    ld.shared.f32       %f24, [%r21];
    ld.shared.f32       %f25, [%r21+128];
    ld.shared.f32       %f26, [%r21+256];
    ld.shared.f32       %f27, [%r21+384];
    mul.f32             %f24, %f24, %f17;
    fma.rn.f32          %f24, %f20, %f19, %f24;
    mul.f32             %f25, %f25, %f17;
    fma.rn.f32          %f25, %f21, %f19, %f25;
    mul.f32             %f26, %f26, %f17;
    fma.rn.f32          %f26, %f22, %f19, %f26;
    mul.f32             %f27, %f27, %f17;
    fma.rn.f32          %f27, %f23, %f19, %f27;
    st.shared.f32       [%r21], %f24;
    st.shared.f32       [%r21+128], %f25;
    st.shared.f32       [%r21+256], %f26;
    st.shared.f32       [%r21+384], %f27;
    fma.rn.f32          %f28, %f24, %f30, %f28;
    fma.rn.f32          %f28, %f25, %f31, %f28;
    fma.rn.f32          %f28, %f26, %f32, %f28;
    fma.rn.f32          %f28, %f27, %f33, %f28;
    add.u32             %r21, %r21, 512;
    add.u32             %r22, %r22, 16;
    add.u32             %r13, %r13, 16;
    setp.lt.u32         %p3, %r22, %r23;
    @%p3 bra            UPD;
    mul.f32             %f28, %f28, %f1;
    st.global.f32       [%rd13], %f28;

    add.s64             %rd11, %rd11, 32768;    // next token: qkv rows of 8192 floats
    add.s64             %rd12, %rd12, 32768;
    add.s64             %rd13, %rd13, 16384;    // out rows of 4096
    add.s64             %rd14, %rd14, 256;      // ba rows of 64
    add.u32             %r20, %r20, 1;
    bra.uni             TOKEN;

SAVE:
    mov.u32             %r10, 0;
    mov.u64             %rd10, %rd9;
    mov.u32             %r11, %r9;
SAVE_S:
    ld.shared.f32       %f4, [%r11];
    st.global.f32       [%rd10], %f4;
    add.s64             %rd10, %rd10, 512;
    add.u32             %r11, %r11, 128;
    add.u32             %r10, %r10, 1;
    setp.lt.u32         %p1, %r10, 128;
    @%p1 bra            SAVE_S;
    ret;
}

// -----------------------------------------------------------------------------
// Kernel: gated_norm   per token t and 128-dim head h:
//     out = rmsnorm(o) * w * silu(z),  rmsnorm(v) = v / sqrt(mean(v^2) + eps)
//   Launch: gridDim = (heads, T), blockDim = 128.
// -----------------------------------------------------------------------------
.visible .entry gated_norm(
    .param .u64 p_o,            // f32 [T][heads*128]
    .param .u64 p_z,            // f32, row stride ldz
    .param .u32 p_ldz,
    .param .u64 p_w,            // f32 [128]
    .param .u64 p_out,          // f32 [T][heads*128] (out)
    .param .f32 p_eps
)
{
    .reg .pred  %p<2>;
    .reg .b32   %r<16>;
    .reg .f32   %f<24>;
    .reg .b64   %rd<12>;
    .shared .align 16 .f32 gn_red[4];

    ld.param.u64        %rd1, [p_o];
    ld.param.u64        %rd2, [p_z];
    ld.param.u32        %r1,  [p_ldz];
    ld.param.u64        %rd3, [p_w];
    ld.param.u64        %rd4, [p_out];
    ld.param.f32        %f1,  [p_eps];
    cvta.to.global.u64  %rd1, %rd1;
    cvta.to.global.u64  %rd2, %rd2;
    cvta.to.global.u64  %rd3, %rd3;
    cvta.to.global.u64  %rd4, %rd4;
    mov.u32             %r2, %tid.x;
    mov.u32             %r3, %ctaid.x;          // h
    mov.u32             %r4, %ctaid.y;          // t
    mov.u32             %r5, %nctaid.x;
    shl.b32             %r6, %r3, 7;
    add.u32             %r6, %r6, %r2;          // h * 128 + j
    shl.b32             %r7, %r5, 7;
    mad.lo.u32          %r8, %r4, %r7, %r6;     // t * width + h * 128 + j
    mul.wide.u32        %rd5, %r8, 4;
    add.s64             %rd6, %rd1, %rd5;
    ld.global.f32       %f2, [%rd6];
    mul.f32             %f3, %f2, %f2;
    shfl.sync.bfly.b32  %f4, %f3, 16, 31, -1;
    add.f32             %f3, %f3, %f4;
    shfl.sync.bfly.b32  %f4, %f3, 8, 31, -1;
    add.f32             %f3, %f3, %f4;
    shfl.sync.bfly.b32  %f4, %f3, 4, 31, -1;
    add.f32             %f3, %f3, %f4;
    shfl.sync.bfly.b32  %f4, %f3, 2, 31, -1;
    add.f32             %f3, %f3, %f4;
    shfl.sync.bfly.b32  %f4, %f3, 1, 31, -1;
    add.f32             %f3, %f3, %f4;
    and.b32             %r9, %r2, 31;
    shr.u32             %r10, %r2, 5;
    setp.eq.u32         %p1, %r9, 0;
    mov.u32             %r11, gn_red;
    shl.b32             %r12, %r10, 2;
    add.u32             %r12, %r11, %r12;
    @%p1 st.shared.f32  [%r12], %f3;
    bar.sync            0;
    ld.shared.v4.f32    {%f5, %f6, %f7, %f8}, [gn_red];
    add.f32             %f5, %f5, %f6;
    add.f32             %f7, %f7, %f8;
    add.f32             %f5, %f5, %f7;
    mul.f32             %f5, %f5, 0f3C000000;   // / 128
    add.f32             %f5, %f5, %f1;
    sqrt.rn.f32         %f5, %f5;
    rcp.rn.f32          %f5, %f5;
    mul.wide.u32        %rd7, %r2, 4;
    add.s64             %rd7, %rd3, %rd7;
    ld.global.nc.f32    %f9, [%rd7];
    mul.f32             %f10, %f2, %f5;
    mul.f32             %f10, %f10, %f9;        // rmsnorm(o) * w
    mad.lo.u32          %r13, %r4, %r1, %r6;
    mul.wide.u32        %rd8, %r13, 4;
    add.s64             %rd8, %rd2, %rd8;
    ld.global.f32       %f11, [%rd8];           // z
    mul.f32             %f12, %f11, 0fBFB8AA3B;
    ex2.approx.f32      %f12, %f12;
    add.f32             %f12, %f12, 0f3F800000;
    div.rn.f32          %f12, %f11, %f12;       // silu(z)
    mul.f32             %f10, %f10, %f12;
    add.s64             %rd9, %rd4, %rd5;
    st.global.f32       [%rd9], %f10;
    ret;
}

// -----------------------------------------------------------------------------
// Kernel: swiglu   out[t][j] = silu(g[t][j]) * u[t][j]  for j < n, where
//   gu[t] = [g: n | u: n] (the gate and up halves of one matrix product).
//   silu(x) = x / (1 + exp(-x)). Grid-stride.
// -----------------------------------------------------------------------------
.visible .entry swiglu(
    .param .u64 p_gu,           // f32 [tokens][2n]
    .param .u64 p_out,          // f32 [tokens][n] (out)
    .param .u32 p_n,
    .param .u32 p_tokens
)
{
    .reg .pred  %p<2>;
    .reg .b32   %r<16>;
    .reg .f32   %f<8>;
    .reg .b64   %rd<8>;

    ld.param.u64        %rd1, [p_gu];
    ld.param.u64        %rd2, [p_out];
    ld.param.u32        %r1,  [p_n];
    ld.param.u32        %r2,  [p_tokens];
    cvta.to.global.u64  %rd1, %rd1;
    cvta.to.global.u64  %rd2, %rd2;
    mul.lo.u32          %r2, %r2, %r1;          // total
    mov.u32             %r3, %tid.x;
    mov.u32             %r4, %ntid.x;
    mov.u32             %r5, %ctaid.x;
    mov.u32             %r6, %nctaid.x;
    mad.lo.u32          %r7, %r5, %r4, %r3;
    mul.lo.u32          %r8, %r6, %r4;
LOOP:
    setp.ge.u32         %p1, %r7, %r2;
    @%p1 bra            DONE;
    div.u32             %r9, %r7, %r1;          // t
    mad.lo.u32          %r10, %r9, %r1, %r7;    // t*2n + j = t*n + i
    mul.wide.u32        %rd3, %r10, 4;
    add.s64             %rd3, %rd1, %rd3;
    ld.global.f32       %f1, [%rd3];            // g
    mul.wide.u32        %rd4, %r1, 4;
    add.s64             %rd4, %rd3, %rd4;
    ld.global.f32       %f2, [%rd4];            // u
    mul.f32             %f3, %f1, 0fBFB8AA3B;
    ex2.approx.f32      %f3, %f3;
    add.f32             %f3, %f3, 0f3F800000;
    div.rn.f32          %f4, %f1, %f3;          // silu(g)
    mul.f32             %f4, %f4, %f2;
    mul.wide.u32        %rd5, %r7, 4;
    add.s64             %rd5, %rd2, %rd5;
    st.global.f32       [%rd5], %f4;
    add.u32             %r7, %r7, %r8;
    bra.uni             LOOP;
DONE:
    ret;
}

// =============================================================================
// Full-attention layer kernels. qkv[t] = [q|gate: nh x (256 | 256) | k: nkv x
// 256 | v: nkv x 256]; the KV cache is f16 [ctx][nkv][256] per layer.
// =============================================================================

// -----------------------------------------------------------------------------
// Kernel: qk_norm_rope   for token t = blockIdx.y at position pos = pos0 + t
//   and head h = blockIdx.x (q heads, then k heads, then v heads):
//   q and k heads: x = rmsnorm(x) * w (qw for q, kw for k), then NeoX RoPE on
//     the first 64 dims only: pairs (i, i+32) for i < 32,
//     x_i' = x_i cos - x_{i+32} sin, x_{i+32}' = x_i sin + x_{i+32} cos with
//     cs[pos][i] = {cos, sin}; written back to qkv, k (as f16) also to the
//     K cache at pos.
//   v heads: copied to the V cache as f16.
//   Launch: gridDim = (nh + 2*nkv, tokens), blockDim = 32. Lane l owns dims
//   8l..8l+7; lanes 0..3 hold the rotary dims' first halves, 4..7 the second.
// -----------------------------------------------------------------------------
.visible .entry qk_norm_rope(
    .param .u64 p_qkv,          // f32 [tokens][stride]
    .param .u32 p_stride,
    .param .u64 p_qw,           // f32 [256]
    .param .u64 p_kw,           // f32 [256]
    .param .u64 p_cs,           // f32 [ctx][32][2]
    .param .u64 p_kc,           // f16 [ctx][nkv][256]
    .param .u64 p_vc,           // f16 [ctx][nkv][256]
    .param .u32 p_pos0,
    .param .u32 p_nh,
    .param .u32 p_nkv,
    .param .f32 p_eps
)
{
    .reg .pred  %p<8>;
    .reg .b16   %h<8>;
    .reg .b32   %r<32>;
    .reg .f32   %f<64>;
    .reg .b64   %rd<20>;

    ld.param.u64        %rd1, [p_qkv];
    ld.param.u32        %r1,  [p_stride];
    ld.param.u64        %rd2, [p_qw];
    ld.param.u64        %rd3, [p_kw];
    ld.param.u64        %rd4, [p_cs];
    ld.param.u64        %rd5, [p_kc];
    ld.param.u64        %rd6, [p_vc];
    ld.param.u32        %r2,  [p_pos0];
    ld.param.u32        %r3,  [p_nh];
    ld.param.u32        %r4,  [p_nkv];
    ld.param.f32        %f1,  [p_eps];
    cvta.to.global.u64  %rd1, %rd1;
    cvta.to.global.u64  %rd2, %rd2;
    cvta.to.global.u64  %rd3, %rd3;
    cvta.to.global.u64  %rd4, %rd4;
    cvta.to.global.u64  %rd5, %rd5;
    cvta.to.global.u64  %rd6, %rd6;

    mov.u32             %r5, %ctaid.x;          // head
    mov.u32             %r6, %ctaid.y;          // token
    mov.u32             %r7, %tid.x;            // lane
    add.u32             %r8, %r2, %r6;          // pos
    add.u32             %r9, %r3, %r4;          // nh + nkv
    setp.lt.u32         %p1, %r5, %r3;          // q head
    setp.lt.u32         %p2, %r5, %r9;          // q or k head
    // offset of the head in the token's row
    shl.b32             %r10, %r5, 9;           // q: h * 512
    sub.u32             %r11, %r5, %r3;
    shl.b32             %r12, %r3, 9;
    shl.b32             %r13, %r11, 8;
    add.u32             %r13, %r12, %r13;       // k, v: nh * 512 + (h - nh) * 256
    selp.b32            %r14, %r10, %r13, %p1;
    mad.lo.u32          %r15, %r6, %r1, %r14;
    shl.b32             %r16, %r7, 3;
    add.u32             %r15, %r15, %r16;       // + 8 lane
    mul.wide.u32        %rd7, %r15, 4;
    add.s64             %rd7, %rd1, %rd7;
    ld.global.v4.f32    {%f2, %f3, %f4, %f5}, [%rd7];
    ld.global.v4.f32    {%f6, %f7, %f8, %f9}, [%rd7+16];
    @%p2 bra            NORM;

    // v head: to the V cache
    sub.u32             %r17, %r5, %r9;         // v head
    mad.lo.u32          %r18, %r8, %r4, %r17;
    shl.b32             %r18, %r18, 8;
    add.u32             %r18, %r18, %r16;
    mul.wide.u32        %rd8, %r18, 2;
    add.s64             %rd8, %rd6, %rd8;
    cvt.rn.f16.f32      %h0, %f2;
    cvt.rn.f16.f32      %h1, %f3;
    cvt.rn.f16.f32      %h2, %f4;
    cvt.rn.f16.f32      %h3, %f5;
    cvt.rn.f16.f32      %h4, %f6;
    cvt.rn.f16.f32      %h5, %f7;
    cvt.rn.f16.f32      %h6, %f8;
    cvt.rn.f16.f32      %h7, %f9;
    mov.b32             %r20, {%h0, %h1};
    mov.b32             %r21, {%h2, %h3};
    mov.b32             %r22, {%h4, %h5};
    mov.b32             %r23, {%h6, %h7};
    st.global.v4.b32    [%rd8], {%r20, %r21, %r22, %r23};
    ret;

NORM:
    mul.f32             %f10, %f2, %f2;
    fma.rn.f32          %f10, %f3, %f3, %f10;
    fma.rn.f32          %f10, %f4, %f4, %f10;
    fma.rn.f32          %f10, %f5, %f5, %f10;
    fma.rn.f32          %f10, %f6, %f6, %f10;
    fma.rn.f32          %f10, %f7, %f7, %f10;
    fma.rn.f32          %f10, %f8, %f8, %f10;
    fma.rn.f32          %f10, %f9, %f9, %f10;
    shfl.sync.bfly.b32  %f11, %f10, 16, 31, -1;
    add.f32             %f10, %f10, %f11;
    shfl.sync.bfly.b32  %f11, %f10, 8, 31, -1;
    add.f32             %f10, %f10, %f11;
    shfl.sync.bfly.b32  %f11, %f10, 4, 31, -1;
    add.f32             %f10, %f10, %f11;
    shfl.sync.bfly.b32  %f11, %f10, 2, 31, -1;
    add.f32             %f10, %f10, %f11;
    shfl.sync.bfly.b32  %f11, %f10, 1, 31, -1;
    add.f32             %f10, %f10, %f11;
    mul.f32             %f10, %f10, 0f3B800000; // / 256
    add.f32             %f10, %f10, %f1;
    sqrt.rn.f32         %f10, %f10;
    rcp.rn.f32          %f10, %f10;             // scale
    selp.b64            %rd9, %rd2, %rd3, %p1;  // norm weights
    mul.wide.u32        %rd10, %r16, 4;
    add.s64             %rd9, %rd9, %rd10;
    ld.global.nc.v4.f32 {%f12, %f13, %f14, %f15}, [%rd9];
    ld.global.nc.v4.f32 {%f16, %f17, %f18, %f19}, [%rd9+16];
    mul.f32             %f2, %f2, %f10;
    mul.f32             %f3, %f3, %f10;
    mul.f32             %f4, %f4, %f10;
    mul.f32             %f5, %f5, %f10;
    mul.f32             %f6, %f6, %f10;
    mul.f32             %f7, %f7, %f10;
    mul.f32             %f8, %f8, %f10;
    mul.f32             %f9, %f9, %f10;
    mul.f32             %f2, %f2, %f12;
    mul.f32             %f3, %f3, %f13;
    mul.f32             %f4, %f4, %f14;
    mul.f32             %f5, %f5, %f15;
    mul.f32             %f6, %f6, %f16;
    mul.f32             %f7, %f7, %f17;
    mul.f32             %f8, %f8, %f18;
    mul.f32             %f9, %f9, %f19;

    // the partner lane's (l ^ 4) values
    shfl.sync.bfly.b32  %f20, %f2, 4, 31, -1;
    shfl.sync.bfly.b32  %f21, %f3, 4, 31, -1;
    shfl.sync.bfly.b32  %f22, %f4, 4, 31, -1;
    shfl.sync.bfly.b32  %f23, %f5, 4, 31, -1;
    shfl.sync.bfly.b32  %f24, %f6, 4, 31, -1;
    shfl.sync.bfly.b32  %f25, %f7, 4, 31, -1;
    shfl.sync.bfly.b32  %f26, %f8, 4, 31, -1;
    shfl.sync.bfly.b32  %f27, %f9, 4, 31, -1;
    setp.ge.u32         %p3, %r7, 8;
    @%p3 bra            STORE;
    // cs[pos][8 (l & 3) .. +7]
    and.b32             %r24, %r7, 3;
    shl.b32             %r24, %r24, 3;
    mad.lo.u32          %r25, %r8, 32, %r24;
    mul.wide.u32        %rd11, %r25, 8;
    add.s64             %rd11, %rd4, %rd11;
    ld.global.nc.v4.f32 {%f30, %f31, %f32, %f33}, [%rd11];      // c0 s0 c1 s1
    ld.global.nc.v4.f32 {%f34, %f35, %f36, %f37}, [%rd11+16];
    ld.global.nc.v4.f32 {%f38, %f39, %f40, %f41}, [%rd11+32];
    ld.global.nc.v4.f32 {%f42, %f43, %f44, %f45}, [%rd11+48];
    setp.ge.u32         %p4, %r7, 4;
    @%p4 bra            SECOND_HALF;
    // x' = x cos - partner sin
    mul.f32             %f46, %f20, %f31;
    neg.f32             %f46, %f46;
    fma.rn.f32          %f2, %f2, %f30, %f46;
    mul.f32             %f46, %f21, %f33;
    neg.f32             %f46, %f46;
    fma.rn.f32          %f3, %f3, %f32, %f46;
    mul.f32             %f46, %f22, %f35;
    neg.f32             %f46, %f46;
    fma.rn.f32          %f4, %f4, %f34, %f46;
    mul.f32             %f46, %f23, %f37;
    neg.f32             %f46, %f46;
    fma.rn.f32          %f5, %f5, %f36, %f46;
    mul.f32             %f46, %f24, %f39;
    neg.f32             %f46, %f46;
    fma.rn.f32          %f6, %f6, %f38, %f46;
    mul.f32             %f46, %f25, %f41;
    neg.f32             %f46, %f46;
    fma.rn.f32          %f7, %f7, %f40, %f46;
    mul.f32             %f46, %f26, %f43;
    neg.f32             %f46, %f46;
    fma.rn.f32          %f8, %f8, %f42, %f46;
    mul.f32             %f46, %f27, %f45;
    neg.f32             %f46, %f46;
    fma.rn.f32          %f9, %f9, %f44, %f46;
    bra.uni             STORE;
SECOND_HALF:
    // x' = partner sin + x cos
    mul.f32             %f46, %f2, %f30;
    fma.rn.f32          %f2, %f20, %f31, %f46;
    mul.f32             %f46, %f3, %f32;
    fma.rn.f32          %f3, %f21, %f33, %f46;
    mul.f32             %f46, %f4, %f34;
    fma.rn.f32          %f4, %f22, %f35, %f46;
    mul.f32             %f46, %f5, %f36;
    fma.rn.f32          %f5, %f23, %f37, %f46;
    mul.f32             %f46, %f6, %f38;
    fma.rn.f32          %f6, %f24, %f39, %f46;
    mul.f32             %f46, %f7, %f40;
    fma.rn.f32          %f7, %f25, %f41, %f46;
    mul.f32             %f46, %f8, %f42;
    fma.rn.f32          %f8, %f26, %f43, %f46;
    mul.f32             %f46, %f9, %f44;
    fma.rn.f32          %f9, %f27, %f45, %f46;
STORE:
    st.global.v4.f32    [%rd7], {%f2, %f3, %f4, %f5};
    st.global.v4.f32    [%rd7+16], {%f6, %f7, %f8, %f9};
    @%p1 bra            DONE;
    // k head: into the cache
    mad.lo.u32          %r18, %r8, %r4, %r11;   // pos * nkv + kh
    shl.b32             %r18, %r18, 8;
    add.u32             %r18, %r18, %r16;
    mul.wide.u32        %rd8, %r18, 2;
    add.s64             %rd8, %rd5, %rd8;
    cvt.rn.f16.f32      %h0, %f2;
    cvt.rn.f16.f32      %h1, %f3;
    cvt.rn.f16.f32      %h2, %f4;
    cvt.rn.f16.f32      %h3, %f5;
    cvt.rn.f16.f32      %h4, %f6;
    cvt.rn.f16.f32      %h5, %f7;
    cvt.rn.f16.f32      %h6, %f8;
    cvt.rn.f16.f32      %h7, %f9;
    mov.b32             %r20, {%h0, %h1};
    mov.b32             %r21, {%h2, %h3};
    mov.b32             %r22, {%h4, %h5};
    mov.b32             %r23, {%h6, %h7};
    st.global.v4.b32    [%rd8], {%r20, %r21, %r22, %r23};
DONE:
    ret;
}

// -----------------------------------------------------------------------------
// Kernel: attention   for query token t = blockIdx.y at position p = pos0 + t
//   and q head h = blockIdx.x, over the cached keys j in [lo, p]:
//     out_h = sum_j softmax_j(scale * q_h . k_j) v_j
//   lo = p - window + 1 for sliding-window layers (window != 0), else 0.
//   Key j lives in cache slot j % slots (a ring when slots < positions);
//   grouped-query: q head h reads kv head h / (nh / nkv). Heads have 256 dims,
//   q head h at h * qhs in its token's row. With gate != 0 the output is
//   multiplied by sigmoid(gate_h), the 256 values after q head h.
//   Launch: gridDim = (nh, tokens), blockDim = 256 (8 warps). Warp w takes
//   keys lo+w, lo+w+8, ..., two per step (keys i and i+8), keeping an online
//   softmax: running max m and sum l of exp(s - m), accumulator of exp(s - m) v
//   (scores in log2 units, so exp is ex2). Lane l owns dims 8l..8l+7. At the
//   end the 8 warps' (m, l, acc) are merged through shared memory and thread
//   d writes out dim d.
// -----------------------------------------------------------------------------
.visible .entry attention(
    .param .u64 p_q,            // f32 [tokens][q_stride], head h at h*qhs
    .param .u32 p_qstride,      // floats between tokens' q
    .param .u32 p_qhs,          // floats between q heads
    .param .u32 p_gate,         // 1: gate the output (gate_h right after q head h)
    .param .u64 p_kc,           // f16 [slots][nkv][256]
    .param .u64 p_vc,           // f16 [slots][nkv][256]
    .param .u64 p_out,          // f32 [tokens][nh][256] (out)
    .param .u32 p_pos0,
    .param .u32 p_window,       // 0 = full causal attention
    .param .u32 p_slots,        // >= 16
    .param .u32 p_nh,
    .param .u32 p_nkv,
    .param .f32 p_scale
)
{
    .reg .pred  %p<8>;
    .reg .b16   %h<2>;
    .reg .b32   %r<48>;
    .reg .f32   %f<100>;
    .reg .b64   %rd<24>;
    .shared .align 16 .f32 at_acc[2048];        // [8 warps][256]
    .shared .align 16 .f32 at_m[8];
    .shared .align 16 .f32 at_l[8];

    ld.param.u64        %rd1, [p_q];
    ld.param.u32        %r1,  [p_qstride];
    ld.param.u32        %r44, [p_qhs];
    ld.param.u32        %r45, [p_gate];
    ld.param.u64        %rd2, [p_kc];
    ld.param.u64        %rd3, [p_vc];
    ld.param.u64        %rd4, [p_out];
    ld.param.u32        %r2,  [p_pos0];
    ld.param.u32        %r3,  [p_window];
    ld.param.u32        %r4,  [p_slots];
    ld.param.u32        %r5,  [p_nh];
    ld.param.u32        %r6,  [p_nkv];
    ld.param.f32        %f1,  [p_scale];
    cvta.to.global.u64  %rd1, %rd1;
    cvta.to.global.u64  %rd2, %rd2;
    cvta.to.global.u64  %rd3, %rd3;
    cvta.to.global.u64  %rd4, %rd4;

    mov.u32             %r7, %ctaid.x;          // h
    mov.u32             %r8, %ctaid.y;          // t
    mov.u32             %r9, %tid.x;
    and.b32             %r10, %r9, 31;          // lane
    shr.u32             %r11, %r9, 5;           // warp
    div.u32             %r12, %r5, %r6;         // q heads per kv head
    div.u32             %r13, %r7, %r12;        // kv head

    // key range [lo, p], n = p - lo + 1
    add.u32             %r14, %r2, %r8;         // p
    setp.ne.u32         %p1, %r3, 0;
    setp.ge.u32         %p2, %r14, %r3;
    and.pred            %p1, %p1, %p2;
    sub.u32             %r15, %r14, %r3;
    add.u32             %r15, %r15, 1;
    selp.b32            %r16, %r15, 0, %p1;     // lo
    sub.u32             %r17, %r14, %r16;
    add.u32             %r17, %r17, 1;          // n
    add.u32             %r18, %r16, %r11;
    rem.u32             %r18, %r18, %r4;        // slot of key lo + warp

    // q * scale * log2(e)
    mul.lo.u32          %r19, %r8, %r1;
    mul.lo.u32          %r20, %r7, %r44;
    add.u32             %r19, %r19, %r20;       // token t, q head h
    shl.b32             %r20, %r10, 3;
    add.u32             %r19, %r19, %r20;
    mul.wide.u32        %rd5, %r19, 4;
    add.s64             %rd5, %rd1, %rd5;
    ld.global.v4.f32    {%f2, %f3, %f4, %f5}, [%rd5];
    ld.global.v4.f32    {%f6, %f7, %f8, %f9}, [%rd5+16];
    mul.f32             %f1, %f1, 0f3FB8AA3B;
    mul.f32             %f2, %f2, %f1;
    mul.f32             %f3, %f3, %f1;
    mul.f32             %f4, %f4, %f1;
    mul.f32             %f5, %f5, %f1;
    mul.f32             %f6, %f6, %f1;
    mul.f32             %f7, %f7, %f1;
    mul.f32             %f8, %f8, %f1;
    mul.f32             %f9, %f9, %f1;

    // byte offset of this lane's dims in a cache row, and the row stride
    shl.b32             %r21, %r13, 9;          // kvh * 256 * 2
    shl.b32             %r22, %r10, 4;          // lane * 8 dims * 2
    add.u32             %r21, %r21, %r22;
    cvt.u64.u32         %rd6, %r21;
    shl.b32             %r23, %r6, 9;           // row stride = nkv * 512 bytes

    mov.f32             %f10, 0fFF800000;       // m
    mov.f32             %f11, 0f00000000;       // l
    mov.f32             %f12, 0f00000000;       // acc[0..7]: f12..f19
    mov.f32             %f13, 0f00000000;
    mov.f32             %f14, 0f00000000;
    mov.f32             %f15, 0f00000000;
    mov.f32             %f16, 0f00000000;
    mov.f32             %f17, 0f00000000;
    mov.f32             %f18, 0f00000000;
    mov.f32             %f19, 0f00000000;
    mov.u32             %r24, %r11;             // key index i
    mov.u32             %r25, %r18;             // its slot
STEP:
    setp.ge.u32         %p3, %r24, %r17;
    @%p3 bra            MERGE;
    add.u32             %r26, %r25, 8;          // slot of key i + 8
    setp.ge.u32         %p4, %r26, %r4;
    @%p4 sub.u32        %r26, %r26, %r4;
    add.u32             %r27, %r24, 8;
    setp.lt.u32         %p5, %r27, %r17;        // key i + 8 exists

    // key / value i
    mul.wide.u32        %rd7, %r25, %r23;
    add.s64             %rd7, %rd7, %rd6;
    add.s64             %rd8, %rd2, %rd7;
    add.s64             %rd9, %rd3, %rd7;
    ld.global.v4.b32    {%r28, %r29, %r30, %r31}, [%rd8];
    ld.global.v4.b32    {%r32, %r33, %r34, %r35}, [%rd9];
    // key / value i + 8 (zeros if absent)
    mov.b32             %r36, 0;
    mov.b32             %r37, 0;
    mov.b32             %r38, 0;
    mov.b32             %r39, 0;
    mov.b32             %r40, 0;
    mov.b32             %r41, 0;
    mov.b32             %r42, 0;
    mov.b32             %r43, 0;
    mul.wide.u32        %rd10, %r26, %r23;
    add.s64             %rd10, %rd10, %rd6;
    add.s64             %rd11, %rd2, %rd10;
    add.s64             %rd12, %rd3, %rd10;
    @%p5 ld.global.v4.b32 {%r36, %r37, %r38, %r39}, [%rd11];
    @%p5 ld.global.v4.b32 {%r40, %r41, %r42, %r43}, [%rd12];

    // scores
    mov.b32             {%h0, %h1}, %r28;
    cvt.f32.f16         %f20, %h0;
    cvt.f32.f16         %f21, %h1;
    mov.b32             {%h0, %h1}, %r29;
    cvt.f32.f16         %f22, %h0;
    cvt.f32.f16         %f23, %h1;
    mov.b32             {%h0, %h1}, %r30;
    cvt.f32.f16         %f24, %h0;
    cvt.f32.f16         %f25, %h1;
    mov.b32             {%h0, %h1}, %r31;
    cvt.f32.f16         %f26, %h0;
    cvt.f32.f16         %f27, %h1;
    mul.f32             %f28, %f2, %f20;
    fma.rn.f32          %f28, %f3, %f21, %f28;
    fma.rn.f32          %f28, %f4, %f22, %f28;
    fma.rn.f32          %f28, %f5, %f23, %f28;
    fma.rn.f32          %f28, %f6, %f24, %f28;
    fma.rn.f32          %f28, %f7, %f25, %f28;
    fma.rn.f32          %f28, %f8, %f26, %f28;
    fma.rn.f32          %f28, %f9, %f27, %f28;  // partial score i
    mov.b32             {%h0, %h1}, %r36;
    cvt.f32.f16         %f20, %h0;
    cvt.f32.f16         %f21, %h1;
    mov.b32             {%h0, %h1}, %r37;
    cvt.f32.f16         %f22, %h0;
    cvt.f32.f16         %f23, %h1;
    mov.b32             {%h0, %h1}, %r38;
    cvt.f32.f16         %f24, %h0;
    cvt.f32.f16         %f25, %h1;
    mov.b32             {%h0, %h1}, %r39;
    cvt.f32.f16         %f26, %h0;
    cvt.f32.f16         %f27, %h1;
    mul.f32             %f29, %f2, %f20;
    fma.rn.f32          %f29, %f3, %f21, %f29;
    fma.rn.f32          %f29, %f4, %f22, %f29;
    fma.rn.f32          %f29, %f5, %f23, %f29;
    fma.rn.f32          %f29, %f6, %f24, %f29;
    fma.rn.f32          %f29, %f7, %f25, %f29;
    fma.rn.f32          %f29, %f8, %f26, %f29;
    fma.rn.f32          %f29, %f9, %f27, %f29;  // partial score i + 8
    shfl.sync.bfly.b32  %f30, %f28, 16, 31, -1;
    shfl.sync.bfly.b32  %f31, %f29, 16, 31, -1;
    add.f32             %f28, %f28, %f30;
    add.f32             %f29, %f29, %f31;
    shfl.sync.bfly.b32  %f30, %f28, 8, 31, -1;
    shfl.sync.bfly.b32  %f31, %f29, 8, 31, -1;
    add.f32             %f28, %f28, %f30;
    add.f32             %f29, %f29, %f31;
    shfl.sync.bfly.b32  %f30, %f28, 4, 31, -1;
    shfl.sync.bfly.b32  %f31, %f29, 4, 31, -1;
    add.f32             %f28, %f28, %f30;
    add.f32             %f29, %f29, %f31;
    shfl.sync.bfly.b32  %f30, %f28, 2, 31, -1;
    shfl.sync.bfly.b32  %f31, %f29, 2, 31, -1;
    add.f32             %f28, %f28, %f30;
    add.f32             %f29, %f29, %f31;
    shfl.sync.bfly.b32  %f30, %f28, 1, 31, -1;
    shfl.sync.bfly.b32  %f31, %f29, 1, 31, -1;
    add.f32             %f28, %f28, %f30;       // s_i
    add.f32             %f29, %f29, %f31;
    selp.f32            %f29, %f29, 0fFF800000, %p5;    // s_{i+8}, -inf if absent

    // online softmax update
    max.f32             %f32, %f10, %f28;
    max.f32             %f32, %f32, %f29;       // new max
    sub.f32             %f33, %f10, %f32;
    ex2.approx.f32      %f33, %f33;             // rescale of the old sums
    sub.f32             %f34, %f28, %f32;
    ex2.approx.f32      %f34, %f34;             // weight of i
    sub.f32             %f35, %f29, %f32;
    ex2.approx.f32      %f35, %f35;             // weight of i + 8
    mov.f32             %f10, %f32;
    mul.f32             %f11, %f11, %f33;
    add.f32             %f11, %f11, %f34;
    add.f32             %f11, %f11, %f35;

    mov.b32             {%h0, %h1}, %r32;
    cvt.f32.f16         %f20, %h0;
    cvt.f32.f16         %f21, %h1;
    mov.b32             {%h0, %h1}, %r33;
    cvt.f32.f16         %f22, %h0;
    cvt.f32.f16         %f23, %h1;
    mov.b32             {%h0, %h1}, %r34;
    cvt.f32.f16         %f24, %h0;
    cvt.f32.f16         %f25, %h1;
    mov.b32             {%h0, %h1}, %r35;
    cvt.f32.f16         %f26, %h0;
    cvt.f32.f16         %f27, %h1;
    mov.b32             {%h0, %h1}, %r40;
    cvt.f32.f16         %f40, %h0;
    cvt.f32.f16         %f41, %h1;
    mov.b32             {%h0, %h1}, %r41;
    cvt.f32.f16         %f42, %h0;
    cvt.f32.f16         %f43, %h1;
    mov.b32             {%h0, %h1}, %r42;
    cvt.f32.f16         %f44, %h0;
    cvt.f32.f16         %f45, %h1;
    mov.b32             {%h0, %h1}, %r43;
    cvt.f32.f16         %f46, %h0;
    cvt.f32.f16         %f47, %h1;
    mul.f32             %f12, %f12, %f33;
    fma.rn.f32          %f12, %f34, %f20, %f12;
    fma.rn.f32          %f12, %f35, %f40, %f12;
    mul.f32             %f13, %f13, %f33;
    fma.rn.f32          %f13, %f34, %f21, %f13;
    fma.rn.f32          %f13, %f35, %f41, %f13;
    mul.f32             %f14, %f14, %f33;
    fma.rn.f32          %f14, %f34, %f22, %f14;
    fma.rn.f32          %f14, %f35, %f42, %f14;
    mul.f32             %f15, %f15, %f33;
    fma.rn.f32          %f15, %f34, %f23, %f15;
    fma.rn.f32          %f15, %f35, %f43, %f15;
    mul.f32             %f16, %f16, %f33;
    fma.rn.f32          %f16, %f34, %f24, %f16;
    fma.rn.f32          %f16, %f35, %f44, %f16;
    mul.f32             %f17, %f17, %f33;
    fma.rn.f32          %f17, %f34, %f25, %f17;
    fma.rn.f32          %f17, %f35, %f45, %f17;
    mul.f32             %f18, %f18, %f33;
    fma.rn.f32          %f18, %f34, %f26, %f18;
    fma.rn.f32          %f18, %f35, %f46, %f18;
    mul.f32             %f19, %f19, %f33;
    fma.rn.f32          %f19, %f34, %f27, %f19;
    fma.rn.f32          %f19, %f35, %f47, %f19;

    add.u32             %r24, %r24, 16;
    add.u32             %r25, %r26, 8;          // slot of key i + 16
    setp.ge.u32         %p4, %r25, %r4;
    @%p4 sub.u32        %r25, %r25, %r4;
    bra.uni             STEP;

MERGE:
    mov.u32             %r28, at_acc;
    shl.b32             %r29, %r11, 10;         // warp * 256 * 4
    shl.b32             %r30, %r10, 5;          // lane * 8 * 4
    add.u32             %r29, %r29, %r30;
    add.u32             %r29, %r28, %r29;
    st.shared.v4.f32    [%r29], {%f12, %f13, %f14, %f15};
    st.shared.v4.f32    [%r29+16], {%f16, %f17, %f18, %f19};
    setp.ne.u32         %p6, %r10, 0;
    shl.b32             %r31, %r11, 2;
    mov.u32             %r32, at_m;
    add.u32             %r33, %r32, %r31;
    @!%p6 st.shared.f32 [%r33], %f10;
    mov.u32             %r34, at_l;
    add.u32             %r35, %r34, %r31;
    @!%p6 st.shared.f32 [%r35], %f11;
    bar.sync            0;

    ld.shared.v4.f32    {%f50, %f51, %f52, %f53}, [at_m];
    ld.shared.v4.f32    {%f54, %f55, %f56, %f57}, [at_m+16];
    max.f32             %f58, %f50, %f51;
    max.f32             %f59, %f52, %f53;
    max.f32             %f60, %f54, %f55;
    max.f32             %f61, %f56, %f57;
    max.f32             %f58, %f58, %f59;
    max.f32             %f60, %f60, %f61;
    max.f32             %f58, %f58, %f60;       // M
    sub.f32             %f50, %f50, %f58;       // warp weights 2^(m_w - M)
    ex2.approx.f32      %f50, %f50;
    sub.f32             %f51, %f51, %f58;
    ex2.approx.f32      %f51, %f51;
    sub.f32             %f52, %f52, %f58;
    ex2.approx.f32      %f52, %f52;
    sub.f32             %f53, %f53, %f58;
    ex2.approx.f32      %f53, %f53;
    sub.f32             %f54, %f54, %f58;
    ex2.approx.f32      %f54, %f54;
    sub.f32             %f55, %f55, %f58;
    ex2.approx.f32      %f55, %f55;
    sub.f32             %f56, %f56, %f58;
    ex2.approx.f32      %f56, %f56;
    sub.f32             %f57, %f57, %f58;
    ex2.approx.f32      %f57, %f57;
    ld.shared.v4.f32    {%f60, %f61, %f62, %f63}, [at_l];
    ld.shared.v4.f32    {%f64, %f65, %f66, %f67}, [at_l+16];
    mul.f32             %f68, %f50, %f60;
    fma.rn.f32          %f68, %f51, %f61, %f68;
    fma.rn.f32          %f68, %f52, %f62, %f68;
    fma.rn.f32          %f68, %f53, %f63, %f68;
    fma.rn.f32          %f68, %f54, %f64, %f68;
    fma.rn.f32          %f68, %f55, %f65, %f68;
    fma.rn.f32          %f68, %f56, %f66, %f68;
    fma.rn.f32          %f68, %f57, %f67, %f68; // denominator
    shl.b32             %r36, %r9, 2;
    add.u32             %r36, %r28, %r36;       // &acc[0][d]
    ld.shared.f32       %f70, [%r36];
    ld.shared.f32       %f71, [%r36+1024];
    ld.shared.f32       %f72, [%r36+2048];
    ld.shared.f32       %f73, [%r36+3072];
    ld.shared.f32       %f74, [%r36+4096];
    ld.shared.f32       %f75, [%r36+5120];
    ld.shared.f32       %f76, [%r36+6144];
    ld.shared.f32       %f77, [%r36+7168];
    mul.f32             %f78, %f50, %f70;
    fma.rn.f32          %f78, %f51, %f71, %f78;
    fma.rn.f32          %f78, %f52, %f72, %f78;
    fma.rn.f32          %f78, %f53, %f73, %f78;
    fma.rn.f32          %f78, %f54, %f74, %f78;
    fma.rn.f32          %f78, %f55, %f75, %f78;
    fma.rn.f32          %f78, %f56, %f76, %f78;
    fma.rn.f32          %f78, %f57, %f77, %f78;
    div.rn.f32          %f79, %f78, %f68;
    setp.eq.u32         %p7, %r45, 0;
    @%p7 bra            NO_GATE;
    // * sigmoid(gate[t][h][d]) (gate at q head + 256)
    mul.lo.u32          %r38, %r8, %r1;
    mad.lo.u32          %r38, %r7, %r44, %r38;
    add.u32             %r38, %r38, %r9;
    mul.wide.u32        %rd14, %r38, 4;
    add.s64             %rd14, %rd1, %rd14;
    ld.global.f32       %f80, [%rd14+1024];
    mul.f32             %f80, %f80, 0fBFB8AA3B;
    ex2.approx.f32      %f80, %f80;
    add.f32             %f80, %f80, 0f3F800000;
    div.rn.f32          %f79, %f79, %f80;
NO_GATE:
    mad.lo.u32          %r37, %r8, %r5, %r7;    // t*nh + h
    shl.b32             %r37, %r37, 8;
    add.u32             %r37, %r37, %r9;
    mul.wide.u32        %rd13, %r37, 4;
    add.s64             %rd13, %rd4, %rd13;
    st.global.f32       [%rd13], %f79;
    ret;
}

// -----------------------------------------------------------------------------
// Kernel: argmax   out = index of the largest x[i] (smallest index on ties)
//   Launch: one block of 1024 threads.
// -----------------------------------------------------------------------------
.visible .entry argmax(
    .param .u64 p_x,            // f32 [n]
    .param .u32 p_n,
    .param .u64 p_out           // u32 (out)
)
{
    .reg .pred  %p<8>;
    .reg .b32   %r<20>;
    .reg .f32   %f<8>;
    .reg .b64   %rd<8>;
    .shared .align 4 .f32 am_val[32];
    .shared .align 4 .u32 am_idx[32];

    ld.param.u64        %rd1, [p_x];
    ld.param.u32        %r1,  [p_n];
    ld.param.u64        %rd2, [p_out];
    cvta.to.global.u64  %rd1, %rd1;
    cvta.to.global.u64  %rd2, %rd2;
    mov.u32             %r2, %tid.x;
    mov.u32             %r3, %ntid.x;
    and.b32             %r4, %r2, 31;
    shr.u32             %r5, %r2, 5;

    mov.f32             %f1, 0fFF800000;
    mov.u32             %r6, 0xFFFFFFFF;
    mov.u32             %r7, %r2;
SCAN:
    setp.ge.u32         %p1, %r7, %r1;
    @%p1 bra            SCAN_DONE;
    mul.wide.u32        %rd3, %r7, 4;
    add.s64             %rd4, %rd1, %rd3;
    ld.global.f32       %f2, [%rd4];
    setp.gt.f32         %p2, %f2, %f1;          // strictly greater keeps the first index
    selp.f32            %f1, %f2, %f1, %p2;
    selp.b32            %r6, %r7, %r6, %p2;
    add.u32             %r7, %r7, %r3;
    bra.uni             SCAN;
SCAN_DONE:
    mov.u32             %r8, 16;
WARP_RED:
    shfl.sync.bfly.b32  %f3, %f1, %r8, 31, -1;
    shfl.sync.bfly.b32  %r9, %r6, %r8, 31, -1;
    setp.gt.f32         %p3, %f3, %f1;
    setp.eq.f32         %p4, %f3, %f1;
    setp.lt.u32         %p5, %r9, %r6;
    and.pred            %p4, %p4, %p5;
    or.pred             %p3, %p3, %p4;
    selp.f32            %f1, %f3, %f1, %p3;
    selp.b32            %r6, %r9, %r6, %p3;
    shr.u32             %r8, %r8, 1;
    setp.ne.u32         %p6, %r8, 0;
    @%p6 bra            WARP_RED;

    setp.ne.u32         %p6, %r4, 0;
    mov.u32             %r10, am_val;
    mov.u32             %r11, am_idx;
    shl.b32             %r12, %r5, 2;
    add.u32             %r13, %r10, %r12;
    add.u32             %r14, %r11, %r12;
    @!%p6 st.shared.f32 [%r13], %f1;
    @!%p6 st.shared.u32 [%r14], %r6;
    bar.sync            0;
    setp.ne.u32         %p7, %r5, 0;
    @%p7 bra            DONE;
    // warp 0 reduces the per-warp results
    shr.u32             %r15, %r3, 5;
    mov.f32             %f1, 0fFF800000;
    mov.u32             %r6, 0xFFFFFFFF;
    setp.ge.u32         %p1, %r4, %r15;
    @%p1 bra            FINAL;
    shl.b32             %r12, %r4, 2;
    add.u32             %r13, %r10, %r12;
    add.u32             %r14, %r11, %r12;
    ld.shared.f32       %f1, [%r13];
    ld.shared.u32       %r6, [%r14];
FINAL:
    mov.u32             %r8, 16;
FINAL_RED:
    shfl.sync.bfly.b32  %f3, %f1, %r8, 31, -1;
    shfl.sync.bfly.b32  %r9, %r6, %r8, 31, -1;
    setp.gt.f32         %p3, %f3, %f1;
    setp.eq.f32         %p4, %f3, %f1;
    setp.lt.u32         %p5, %r9, %r6;
    and.pred            %p4, %p4, %p5;
    or.pred             %p3, %p3, %p4;
    selp.f32            %f1, %f3, %f1, %p3;
    selp.b32            %r6, %r9, %r6, %p3;
    shr.u32             %r8, %r8, 1;
    setp.ne.u32         %p6, %r8, 0;
    @%p6 bra            FINAL_RED;
    setp.ne.u32         %p6, %r4, 0;
    @%p6 bra            DONE;
    st.global.u32       [%rd2], %r6;
DONE:
    ret;
}

// -----------------------------------------------------------------------------
// Kernel: compact_logits   gathers the sampling candidates: every i with
//   x[i] >= x[best] - margin, where best is argmax's result. out[0] = count
//   (may exceed cap: then only cap entries are stored and the host falls back
//   to the full logits), out[2 + 2j] = index, out[3 + 2j] = logit (f32 bits).
//   The host zeroes out[0] first. Grid-stride.
// -----------------------------------------------------------------------------
.visible .entry compact_logits(
    .param .u64 p_x,            // f32 [n]
    .param .u32 p_n,
    .param .u64 p_best,         // u32 (argmax result)
    .param .f32 p_margin,
    .param .u64 p_out,          // u32 [2 + 2*cap]
    .param .u32 p_cap
)
{
    .reg .pred  %p<4>;
    .reg .b32   %r<16>;
    .reg .f32   %f<8>;
    .reg .b64   %rd<12>;

    ld.param.u64        %rd1, [p_x];
    ld.param.u32        %r1,  [p_n];
    ld.param.u64        %rd2, [p_best];
    ld.param.f32        %f1,  [p_margin];
    ld.param.u64        %rd3, [p_out];
    ld.param.u32        %r2,  [p_cap];
    cvta.to.global.u64  %rd1, %rd1;
    cvta.to.global.u64  %rd2, %rd2;
    cvta.to.global.u64  %rd3, %rd3;
    ld.global.u32       %r3, [%rd2];
    mul.wide.u32        %rd4, %r3, 4;
    add.s64             %rd4, %rd1, %rd4;
    ld.global.f32       %f2, [%rd4];
    sub.f32             %f3, %f2, %f1;          // threshold

    mov.u32             %r4, %tid.x;
    mov.u32             %r5, %ntid.x;
    mov.u32             %r6, %ctaid.x;
    mov.u32             %r7, %nctaid.x;
    mad.lo.u32          %r8, %r6, %r5, %r4;
    mul.lo.u32          %r9, %r7, %r5;
LOOP:
    setp.ge.u32         %p1, %r8, %r1;
    @%p1 bra            DONE;
    mul.wide.u32        %rd5, %r8, 4;
    add.s64             %rd6, %rd1, %rd5;
    ld.global.f32       %f4, [%rd6];
    setp.lt.f32         %p2, %f4, %f3;
    @%p2 bra            NEXT;
    atom.global.add.u32 %r10, [%rd3], 1;
    setp.ge.u32         %p3, %r10, %r2;
    @%p3 bra            NEXT;
    shl.b32             %r11, %r10, 1;
    add.u32             %r11, %r11, 2;          // 8-byte aligned pair
    mul.wide.u32        %rd7, %r11, 4;
    add.s64             %rd8, %rd3, %rd7;
    mov.b32             %r12, %f4;
    st.global.v2.u32    [%rd8], {%r8, %r12};
NEXT:
    add.u32             %r8, %r8, %r9;
    bra.uni             LOOP;
DONE:
    ret;
}

// -----------------------------------------------------------------------------
// Kernel: sample_logits   draws a token from softmax(x / T) over the whole
//   vocabulary, optionally without tokens whose weight relative to the best
//   is below min_w (min-p), by inverse CDF in index order:
//     w_i = exp((x_i - x_best) / T)  (0 if w_i < min_w),  Z = sum_i w_i,
//     pick the i where the running sum of w first exceeds u * Z.
//   out[0] = the token, out[1] = Z (f32 bits; also used by the host for
//   top-p). u in [0, 1) comes from the host's seeded RNG.
//   Launch: one block of 1024 threads; thread t owns a contiguous chunk.
// -----------------------------------------------------------------------------
.visible .entry sample_logits(
    .param .u64 p_x,            // f32 [n]
    .param .u32 p_n,
    .param .u64 p_best,         // u32 (argmax result)
    .param .f32 p_inv_temp,
    .param .f32 p_min_w,
    .param .f32 p_u,
    .param .u64 p_out           // u32 [2] (out)
)
{
    .reg .pred  %p<8>;
    .reg .b32   %r<24>;
    .reg .f32   %f<16>;
    .reg .b64   %rd<12>;
    .shared .align 4 .f32 sl_part[1024];
    .shared .align 4 .u32 sl_pick_chunk;
    .shared .align 4 .f32 sl_rest;

    ld.param.u64        %rd1, [p_x];
    ld.param.u32        %r1,  [p_n];
    ld.param.u64        %rd2, [p_best];
    ld.param.f32        %f1,  [p_inv_temp];
    ld.param.f32        %f2,  [p_min_w];
    ld.param.f32        %f3,  [p_u];
    ld.param.u64        %rd3, [p_out];
    cvta.to.global.u64  %rd1, %rd1;
    cvta.to.global.u64  %rd2, %rd2;
    cvta.to.global.u64  %rd3, %rd3;
    ld.global.u32       %r2, [%rd2];
    mul.wide.u32        %rd4, %r2, 4;
    add.s64             %rd4, %rd1, %rd4;
    ld.global.f32       %f4, [%rd4];            // max logit
    mul.f32             %f5, %f1, 0f3FB8AA3B;   // log2(e) / T

    mov.u32             %r3, %tid.x;
    mov.u32             %r4, %ntid.x;
    add.u32             %r5, %r1, %r4;
    sub.u32             %r5, %r5, 1;
    div.u32             %r5, %r5, %r4;          // chunk length
    mul.lo.u32          %r6, %r3, %r5;          // my first index
    add.u32             %r7, %r6, %r5;
    min.u32             %r7, %r7, %r1;          // my end
    mul.wide.u32        %rd5, %r6, 4;
    add.s64             %rd5, %rd1, %rd5;       // &x[first]

    // pass 1: my partial sum
    mov.f32             %f6, 0f00000000;
    mov.u32             %r8, %r6;
    mov.u64             %rd6, %rd5;
SUM:
    setp.ge.u32         %p1, %r8, %r7;
    @%p1 bra            SUM_DONE;
    ld.global.f32       %f7, [%rd6];
    sub.f32             %f7, %f7, %f4;
    mul.f32             %f7, %f7, %f5;
    ex2.approx.f32      %f8, %f7;
    setp.lt.f32         %p2, %f8, %f2;
    selp.f32            %f8, 0f00000000, %f8, %p2;
    add.f32             %f6, %f6, %f8;
    add.u32             %r8, %r8, 1;
    add.s64             %rd6, %rd6, 4;
    bra.uni             SUM;
SUM_DONE:
    mov.u32             %r9, sl_part;
    shl.b32             %r10, %r3, 2;
    add.u32             %r10, %r9, %r10;
    st.shared.f32       [%r10], %f6;
    bar.sync            0;

    // thread 0: total, and the chunk where u * Z falls
    setp.ne.u32         %p3, %r3, 0;
    @%p3 bra            CHOSEN;
    mov.f32             %f9, 0f00000000;
    mov.u32             %r11, 0;
TOTAL:
    setp.ge.u32         %p4, %r11, %r4;
    @%p4 bra            TOTAL_DONE;
    shl.b32             %r12, %r11, 2;
    add.u32             %r12, %r9, %r12;
    ld.shared.f32       %f10, [%r12];
    add.f32             %f9, %f9, %f10;
    add.u32             %r11, %r11, 1;
    bra.uni             TOTAL;
TOTAL_DONE:
    st.global.f32       [%rd3+4], %f9;          // Z
    mul.f32             %f11, %f3, %f9;         // target = u * Z
    mov.u32             %r11, 0;
    mov.u32             %r13, 0;                // last chunk with weight
FIND:
    setp.ge.u32         %p4, %r11, %r4;
    @%p4 bra            FIND_END;
    shl.b32             %r12, %r11, 2;
    add.u32             %r12, %r9, %r12;
    ld.shared.f32       %f10, [%r12];
    setp.gt.f32         %p5, %f10, 0f00000000;
    @!%p5 bra           FIND_NEXT;
    mov.u32             %r13, %r11;
    setp.lt.f32         %p6, %f11, %f10;
    @%p6 bra            FIND_END;
    sub.f32             %f11, %f11, %f10;
FIND_NEXT:
    add.u32             %r11, %r11, 1;
    bra.uni             FIND;
FIND_END:
    // rounding can run past the last chunk: then take the end of the last
    // chunk with weight (rest is clamped so its walk ends there)
    st.shared.u32       [sl_pick_chunk], %r13;
    st.shared.f32       [sl_rest], %f11;
CHOSEN:
    bar.sync            0;
    ld.shared.u32       %r14, [sl_pick_chunk];
    setp.ne.u32         %p3, %r3, %r14;
    @%p3 bra            DONE;

    // pass 2 (one thread): walk the chosen chunk
    ld.shared.f32       %f12, [sl_rest];
    mov.u32             %r15, %r6;              // last index with weight
    mov.u32             %r8, %r6;
    mov.u64             %rd6, %rd5;
WALK:
    setp.ge.u32         %p1, %r8, %r7;
    @%p1 bra            PICKED;
    ld.global.f32       %f7, [%rd6];
    sub.f32             %f7, %f7, %f4;
    mul.f32             %f7, %f7, %f5;
    ex2.approx.f32      %f8, %f7;
    setp.lt.f32         %p2, %f8, %f2;
    @%p2 bra            WALK_NEXT;
    mov.u32             %r15, %r8;
    setp.lt.f32         %p7, %f12, %f8;
    @%p7 bra            PICKED;
    sub.f32             %f12, %f12, %f8;
WALK_NEXT:
    add.u32             %r8, %r8, 1;
    add.s64             %rd6, %rd6, 4;
    bra.uni             WALK;
PICKED:
    st.global.u32       [%rd3], %r15;
DONE:
    ret;
}

